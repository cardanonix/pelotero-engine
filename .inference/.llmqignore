# Documentation and notes lag the code, so answers come from the code alone.
docs/
notes/
*.md
# Chase runs and annotation files left outside .inference. Ingest makes
# fresh bundles in every run, the annotations are already in them, and
# .inference itself is not walked apart from its *.allium specifications.
*.chase
*-annotations.json
lib/new-annotations.json
# Recorded API responses used as test input.
fixtures/
# Batches and manifests from the concat tooling.
script/
# Encrypted secrets; the content check catches them too.
secrets/