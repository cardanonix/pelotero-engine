  * -> ScoringPeriodInverted  via Pelotero.League.Setup.validateNewLeague

%derived Pelotero.Lineup.Snapshot.PerTeamResult constructors=TeamSnapshotted,TeamAlreadyHasSnapshot
  * -> TeamAlreadyHasSnapshot  via Pelotero.Lineup.Snapshot.snapshotLineupsForTeam
  * -> TeamSnapshotted  via Pelotero.Lineup.Snapshot.snapshotLineupsForTeam

%derived Pelotero.MLB.Convert.ConvertWarning constructors=InvalidPlayerId,UnknownPosition,UnknownHandedness,InvalidGameDate,MissingTeamRef,WireFieldDiscrepancy
  * -> InvalidPlayerId  via Pelotero.MLB.Convert.convertPlayer
  * -> MissingTeamRef  via Pelotero.MLB.Convert.convertGame
  * -> UnknownHandedness  via Pelotero.MLB.Convert.convertHand
  * -> UnknownPosition  via Pelotero.MLB.Convert.convertPosition
  * -> WireFieldDiscrepancy  via Pelotero.MLB.Convert.convertPitching

%derived Pelotero.Matchup.Outcome constructors=HomeWins,AwayWins,Tied
  * -> AwayWins  via Pelotero.Matchup.decideMatchup
  * -> HomeWins  via Pelotero.Matchup.decideMatchup
  * -> Tied  via Pelotero.Matchup.decideMatchup

%derived Pelotero.Simulate.SimError constructors=SimTeamCountOutOfRange,SimRosterFetchFailed,SimScheduleFetchFailed,SimNoGames,SimLeagueSetupFailed,SimDraftFailed,SimLeagueVanished
  * -> SimDraftFailed  via Pelotero.Simulate.runSimulation
  * -> SimLeagueSetupFailed  via Pelotero.Simulate.createLeagueStage
  * -> SimLeagueSetupFailed  via Pelotero.Simulate.runSimulation
  * -> SimLeagueVanished  via Pelotero.Simulate.runSimulation
  * -> SimNoGames  via Pelotero.Simulate.syncScheduleStage
  * -> SimRosterFetchFailed  via Pelotero.Simulate.syncRostersStage
  * -> SimScheduleFetchFailed  via Pelotero.Simulate.syncScheduleStage
  * -> SimTeamCountOutOfRange  via Pelotero.Simulate.runSimulation

%derived Pelotero.Sync.Boxscores.BoxscoreOutcome constructors=BoxUpserted,BoxUnchanged
  * -> BoxUnchanged  via Pelotero.Sync.Boxscores.syncOne
  * -> BoxUpserted  via Pelotero.Sync.Boxscores.syncOne

%derived Pelotero.Sync.Boxscores.BoxscoreSyncError constructors=GameNotKnown,FetchFailed,ParseFailed
  * -> FetchFailed  via Pelotero.Sync.Boxscores.syncOne
  * -> GameNotKnown  via Pelotero.Sync.Boxscores.syncOne
  * -> ParseFailed  via Pelotero.Sync.Boxscores.syncOne

