data PlayerRankingE f = PlayerRankingE
  { _prLeagueTeamId :: Column f DbLeagueTeamId
  , _prPlayerId     :: Column f DbPlayerId
  , _prRankSlot     :: Column f Int32
  , _prUpdatedAt    :: Column f UTCTime
