%file /home/bismuth/git/pelotero-engine/lib/Pelotero/Effects/MLBClient.hs
%mod Pelotero.Effects.MLBClient

%ext TypeFamilies, DataKinds, TypeOperators, FlexibleContexts, LambdaCase, GADTs

%uses Control.Exception
%uses qualified Crypto.Hash.SHA256 as SHA256
%uses qualified Data.Aeson as Aeson
%uses qualified Data.ByteString as BS
%uses qualified Data.ByteString.Base16 as B16
%uses Data.Map.Strict
%uses qualified Data.Map.Strict as Map
%uses qualified Data.Text as T
%uses qualified Data.Text.Encoding as TE
%uses System.FilePath
%uses Effectful
%uses qualified Effectful as E
%uses Effectful.Dispatch.Dynamic
%uses Pelotero.Domain.Id
%uses qualified Pelotero.Domain.Game as DGame
%uses qualified Pelotero.Domain.Team as DTeam
%uses qualified Pelotero.MLB.Convert as Convert
%uses qualified Pelotero.MLB.Fetch as Fetch
%uses Pelotero.MLB.Fetch
%uses qualified Pelotero.MLB.Wire.Team as WT

%untested fetchBoxscoreRaw, runMLBClientHTTP

data MLBClient :: Effect where
  FetchRosters     :: Int              -> MLBClient m (Either String FetchedRosters)
  FetchSchedule    :: String -> String -> MLBClient m (Either String FetchedSchedule)
  FetchBoxscoreRaw :: Int              -> MLBClient m (Either String BS.ByteString)

data MLBFixture = MLBFixture
  { fixturesDir      :: !FilePath
    -- ^ Default lookup directory. Expected layout:
    --   teams-<season>.json
    --   players-<season>.json
    --   schedule-<startDate>-<endDate>.json
    --   boxscore-<gamePk>.json
  , fixtureTeams     :: !(Map Int FilePath)
    -- ^ Optional per-season overrides for the teams file. When a season
    --   is not in this map, FetchRosters reads
    --   <fixturesDir>/teams-<season>.json.
  , fixturePlayers   :: !(Map Int FilePath)
    -- ^ Optional per-season overrides for the players file. When a
    --   season is not in this map, FetchRosters reads
    --   <fixturesDir>/players-<season>.json. Lets one spec draft from a
    --   full-season pool while other specs keep a small pool with exact
    --   counts.
  , fixtureBoxscores :: !(Map Int FilePath)
    -- ^ Optional per-game overrides for boxscore lookups. When a gamePk
    --   is not in this map, FetchBoxscoreRaw falls back to
    --   <fixturesDir>/boxscore-<gamePk>.json.
  }

fetchRosters
  :: MLBClient E.:> es
  => Int -> E.Eff es (Either String FetchedRosters)
  ! MLBClient send-only API for rosters
  ~ called by: Pelotero.Simulate.syncRostersStage
  ? tested by: IntegrationTest.SyncPlayersSpec.spec, IntegrationTest.SyncScheduleSpec.spec, IntegrationTest.SyncBoxscoresSpec.fetchRostersOrFail, IntegrationTest.SmokeSpec.syncRostersOrFail

fetchSchedule
  :: MLBClient E.:> es
  => String -> String -> E.Eff es (Either String FetchedSchedule)
  ! MLBClient send-only API for schedule
  ~ called by: Pelotero.Simulate.syncScheduleStage
  ? tested by: IntegrationTest.SyncScheduleSpec.spec, IntegrationTest.SyncBoxscoresSpec.fetchScheduleOrFail, IntegrationTest.SmokeSpec.syncScheduleOrFail

fetchBoxscoreRaw
  :: MLBClient E.:> es
  => Int -> E.Eff es (Either String BS.ByteString)
  ! MLBClient send-only API for boxscore raw bytes
  ~ called by: Pelotero.Sync.Boxscores.syncOne

runMLBClientHTTP
  :: IOE E.:> es
  => E.Eff (MLBClient : es) a
  -> E.Eff es a
  ! intent: Production interpreter; delegates each operation to Pelotero.MLB.Fetch via liftIO
  ! effects: IOE
  ! no caching, no retries, no rate limiting at this layer
  ~ called by: Pelotero.App.runApp

defaultFixture :: FilePath -> MLBFixture
  ! constructs an MLBFixture with empty fixtureBoxscores
  ~ no callers in scanned roots
  ? tested by: IntegrationTest.SyncPlayersSpec.spec, IntegrationTest.SyncScheduleSpec.spec, IntegrationTest.SyncBoxscoresSpec.spec, IntegrationTest.SimulateSpec.simFixture, IntegrationTest.SmokeSpec.runStack

runMLBClientFixture
  :: IOE E.:> es
  => MLBFixture
  -> E.Eff (MLBClient : es) a
  -> E.Eff es a
  ! intent: Test interpreter; reads fixture files from disk and runs them through the same Convert pipeline as production
  ! effects: IOE
  ~ literals: "teams-", ".json", "players-", "schedule-", "-", "boxscore-"
  ~ no callers in scanned roots
  ? tested by: IntegrationTest.SyncPlayersSpec.spec, IntegrationTest.SyncScheduleSpec.spec, IntegrationTest.SyncBoxscoresSpec.spec, IntegrationTest.SimulateSpec.runStack, IntegrationTest.SmokeSpec.runStack

%decision TwoInterpretersHttpAndFixture
  what:    MLBClient has runMLBClientHTTP (production) and runMLBClientFixture (offline tests reading JSON files from disk)
  why:     The fixture interpreter exercises the same wire-to-domain conversion path (Pelotero.MLB.Convert) as production, just with file reads instead of HTTP. Fixture tests don't depend on network, MLB API uptime, or rate limits. The fixture path manually computes the SHA over teams+players bytes (same order as fetchRosters), so test-mode SHAs match production semantics.
  affects: runMLBClientHTTP, runMLBClientFixture

%decision FixtureBoxscoresOverride
  what:    MLBFixture has fixtureBoxscores :: Map Int FilePath for per-game path overrides
  why:     Most tests use the conventional path; the override exists for tests that need to point a specific gamePk at a corrupted/edge-case fixture file. Avoids forcing every test to lay out its own complete fixture directory.
  affects: runMLBClientFixture, defaultFixture

%decision WireToDomainTeamCopiedFromFetch
  what:    runMLBClientFixture inlines its own copy of wireToDomainTeam rather than importing from Pelotero.MLB.Fetch
  why:     wireToDomainTeam is private to Fetch; exporting it for one test caller felt heavier than four lines of duplication. If a third caller appears, this should move to a shared Convert helper.
  affects: runMLBClientFixture


