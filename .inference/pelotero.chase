%file /home/bismuth/git/pelotero-engine/lib/Pelotero/DB/ProviderKeyed.hs
%mod Pelotero.DB.ProviderKeyed

%ext AllowAmbiguousTypes, DataKinds, DeriveAnyClass, DeriveGeneric, DerivingStrategies, FlexibleContexts, OverloadedStrings, ScopedTypeVariables, StandaloneDeriving, TypeApplications, TypeFamilies, TypeOperators, UndecidableInstances

%uses Data.Kind
%uses Data.Text
%uses Data.Time
%uses GHC.Generics
%uses qualified Hasql.Transaction as Tx
%uses Rel8
%uses Pelotero.DB.Pool
%uses Pelotero.DB.Provider
%uses Pelotero.DB.Rel8Instances

%untested rowSchema, externalIdSchema, rowIdColumn, insertRowT, updateRowByIdT, linkExternalIdT, lookupByExternalIdT, getExternalIdT
%untested upsertByExternalIdT, linkExternalId, lookupByExternalId, getExternalId, upsertByExternalId

data ExternalIdE i f = ExternalIdE
  { _eidEntityId   :: Column f i
  , _eidProvider   :: Column f ProviderName
  , _eidExternalId :: Column f Text
  , _eidFetchedAt  :: Column f UTCTime
  }
  deriving stock (Generic)

class

  rowSchema        :: TableSchema (RowEntity row Name)
  ~ no callers in scanned roots

  externalIdSchema :: TableSchema (ExternalIdE (RowId row) Name)
  ~ called by: Pelotero.DB.ProviderKeyed.linkExternalIdT, Pelotero.DB.ProviderKeyed.lookupByExternalIdT, Pelotero.DB.ProviderKeyed.getExternalIdT

  rowIdColumn      :: RowEntity row Expr -> Expr (RowId row)
  ~ no callers in scanned roots

  insertRowT       :: row -> Tx.Transaction (RowId row)
  ~ called by: Pelotero.DB.ProviderKeyed.upsertByExternalIdT

  updateRowByIdT   :: RowId row -> row -> Tx.Transaction ()
  ~ called by: Pelotero.DB.ProviderKeyed.upsertByExternalIdT

linkExternalIdT
  :: forall row. ProviderKeyed row
  => RowId row -> ProviderName -> Text -> Tx.Transaction ()
  ! INSERT into externalIdSchema with ON CONFLICT DO NOTHING; idempotent on re-runs
  ! _eidFetchedAt set via unsafeDefault — the DB column has DEFAULT NOW()
  ~ called by: Pelotero.DB.ProviderKeyed.upsertByExternalIdT, Pelotero.DB.ProviderKeyed.linkExternalId, Pelotero.DB.Team.linkExternalIdT, Pelotero.DB.Game.linkExternalIdT, Pelotero.DB.Player.linkExternalIdT

lookupByExternalIdT
  :: forall row. ProviderKeyed row
  => ProviderName -> Text -> Tx.Transaction (Maybe (RowId row))
  ! SELECT _eidEntityId WHERE provider AND external_id; returns the first row or Nothing
  ! Phase A.5: replaces the inline lookup that was duplicated across DB.Player / DB.Team / DB.Game
  ~ called by: Pelotero.DB.ProviderKeyed.upsertByExternalIdT, Pelotero.DB.ProviderKeyed.lookupByExternalId, Pelotero.DB.Team.lookupByExternalIdT, Pelotero.DB.Game.lookupByExternalIdT, Pelotero.DB.Player.lookupByExternalIdT

getExternalIdT
  :: forall row. ProviderKeyed row
  => RowId row -> ProviderName -> Tx.Transaction (Maybe Text)
  ! Reverse lookup; SELECT _eidExternalId WHERE entity_id AND provider
  ~ called by: Pelotero.DB.ProviderKeyed.getExternalId, Pelotero.DB.Team.getExternalIdT, Pelotero.DB.Game.getExternalIdT, Pelotero.DB.Player.getExternalIdT

upsertByExternalIdT
  :: forall row. ProviderKeyed row
  => ProviderName -> Text -> row -> Tx.Transaction (RowId row)
  ! Atomic within the caller's transaction: lookupByExternalIdT, then either updateRowByIdT (existing entity) or insertRowT + linkExternalIdT (new entity)
  ! Returns the surrogate id either way — caller doesn't need to distinguish insert vs. update
  ~ called by: Pelotero.DB.ProviderKeyed.upsertByExternalId, Pelotero.DB.Team.upsertByExternalIdT, Pelotero.DB.Game.upsertByExternalIdT, Pelotero.DB.Player.upsertByExternalIdT

linkExternalId
  :: forall row. ProviderKeyed row
  => Pool -> RowId row -> ProviderName -> Text -> IO (Either DBError ())
  ! Pool-flavored wrapper around linkExternalIdT
  ~ called by: Pelotero.DB.Team.linkExternalId, Pelotero.DB.Game.linkExternalId, Pelotero.DB.Player.linkExternalId

lookupByExternalId
  :: forall row. ProviderKeyed row
  => Pool
  -> ProviderName
  -> Text
  -> IO (Either DBError (Maybe (RowId row)))
  ! Pool-flavored wrapper around lookupByExternalIdT
  ~ called by: Pelotero.DB.Team.lookupByExternalId, Pelotero.DB.Game.lookupByExternalId, Pelotero.DB.Player.lookupByExternalId

getExternalId
  :: forall row. ProviderKeyed row
  => Pool
  -> RowId row
  -> ProviderName
  -> IO (Either DBError (Maybe Text))
  ! Pool-flavored wrapper around getExternalIdT
  ~ called by: Pelotero.DB.Team.getExternalId, Pelotero.DB.Game.getExternalId, Pelotero.DB.Player.getExternalId

upsertByExternalId
  :: forall row. ProviderKeyed row
  => Pool
  -> ProviderName
  -> Text
  -> row
  -> IO (Either DBError (RowId row))
  ! Pool-flavored wrapper around upsertByExternalIdT
  ~ called by: Pelotero.DB.Team.upsertByExternalId, Pelotero.DB.Game.upsertByExternalId, Pelotero.DB.Player.upsertByExternalId

%decision ParametricExternalIdEntity
  what:    ExternalIdE i f is a single rel8able record parameterised by the surrogate id type, NOT three separate per-table records (PlayerExternalId, TeamExternalId, GameExternalId)
  why:     All three external-id companion tables have identical column shape (entity_id, provider, external_id, fetched_at); the only difference is the type of entity_id. Sharing the record type forces that fact at compile time. Adding a fourth provider-keyed table is one TableSchema literal plus one ProviderKeyed instance; no new entity record needed. Cost: one Rel8able instance with a (DBType i, DBEq i) constraint, plus standalone-deriving ergonomics. Acceptable for the consolidation.
  affects: 

%decision TypeclassOverRecordOfFunctions
  what:    ProviderKeyed is a typeclass with associated type families (RowEntity, RowId), not a record-of-functions value passed to free-standing helpers
  why:     The associated type families let GHC propagate RowId row through to the surrogate-id type at every call site without manual threading. Type applications (linkExternalIdT @PlayerRow) at the few sites where row is otherwise ambiguous from the value-level args; explicit and greppable. A Proxy-based or record-of-functions variant would push that disambiguation to value-level boilerplate at every call site.
  affects: 

%decision InsertAndUpdateAreInstanceMethods
  what:    insertRowT and updateRowByIdT are typeclass methods (each instance provides its own), NOT default methods derived from rowSchema and a generic rowToExpr
  why:     The rel8 Insert and Update clauses need entity-specific knowledge: which field is the surrogate id (so it can be set to unsafeDefault on insert and to lit pid on update), and the per-field 'lit value' translation. Generalising this would require per-field traversals via Generic, which is more machinery than the three current callers justify. Each instance's insertRowT and updateRowByIdT are literally one-liners that point at the existing per-table insertXxxT and updateXxxT functions, so no real boilerplate is added. If a fourth provider-keyed table arrives, this design extends cleanly: write the per-table insert/update, declare the instance.
  affects: 

%decision FacadesPreserveCallSites
  what:    Per-table modules (Pelotero.DB.Player / .Team / .Game) re-export the four external-id helpers and their Pool wrappers as one-line facades that call PK.foo @MyRow
  why:     Zero call-site changes outside the DB layer. The effect interpreters (runPlayersDB etc.) and Sync code keep importing Pelotero.DB.Player.upsertByExternalIdT exactly as before. Cost: 4 × 2 = 8 trivial wrapper definitions per table. Worth it to keep the migration scope narrow. If we later decide call sites should go through PK directly, deleting the facades is a mechanical follow-up.
  affects: 


=== BEGIN Pelotero/DB/Rel8Instances.hs ===

%file /home/bismuth/git/pelotero-engine/lib/Pelotero/DB/Rel8Instances.hs
%mod Pelotero.DB.Rel8Instances

%ext DerivingStrategies, DerivingVia, FlexibleInstances, GeneralizedNewtypeDeriving, MultiParamTypeClasses, StandaloneDeriving

%uses qualified Data.Text as T
%uses qualified Rel8 as R
%uses Pelotero.Domain.Id
%uses Pelotero.DB.Provider

instance R.DBType ProviderName where

instance R.DBEq ProviderName

%decision OrphanInstancesAreDeliberate
  what:    DBType / DBEq / DBOrd instances for domain id types live here as orphans; the {-# OPTIONS_GHC -Wno-orphans #-} pragma is intentional
  why:     Putting them in Pelotero.Domain.Id forces the domain layer to depend on rel8, which is the wrong direction. Putting them in each Pelotero.DB.* table module produces orphan-conflict warnings as soon as two table modules reference the same domain type. This module is the lowest place that already imports both the domain types and rel8. Importers use the empty-import idiom: 'import Pelotero.DB.Rel8Instances ()'.
  affects: 

%decision JsonbInstancesLiveOnWrappers
  what:    ToJSON / FromJSON for LeagueScoring, RosterLimits, LineupLimits live on newtype wrappers in Pelotero.DB.JsonB; this module no longer carries any DBType deriving for those Domain types
  why:     Phase A.4 moved Domain off Aeson. The Domain types no longer have ToJSON / FromJSON instances; the DBType-via-JSONBEncoded deriving therefore moved next to the wrappers in Pelotero.DB.JsonB, where it's non-orphan. This module remains the home for orphan rel8 instances on Domain id newtypes; the JsonB wrappers' DBType instances are non-orphans because the wrappers are defined alongside them.
  affects: 

%decision ProviderNameTextEnumDb
  what:    ProviderName decodes via parseTypeInformation, with parseProviderName as the decoder; on unknown values it returns Left, which becomes a hasql query failure
  why:     Unlike Pelotero.DB.FetchLog.fromResult (which decodes to Maybe and filters), this DBType instance is strict. Tables that use ProviderName directly must only contain known providers, OR the table must decode to Text and convert in code. This asymmetry is per-table by design: external-id tables are write-controlled; the fetch log is append-only and historical.
  affects: 


