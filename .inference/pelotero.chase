%mod Pelotero.DB.LineupSnapshot

%ext DataKinds, DeriveAnyClass, DeriveGeneric, DerivingStrategies, DuplicateRecordFields, OverloadedStrings, RecordWildCards, StandaloneDeriving, TypeFamilies, TypeOperators, UndecidableInstances

%uses Data.Functor.Contravariant
