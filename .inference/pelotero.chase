=== BEGIN Pelotero/Draft/Feasibility.hs ===

%file /home/bismuth/git/pelotero-engine/lib/Pelotero/Draft/Feasibility.hs
%mod Pelotero.Draft.Feasibility

%uses qualified Data.Foldable as F
%uses Data.Map.Strict
%uses qualified Data.Map.Strict as Map
%uses Data.Sequence
%uses qualified Data.Sequence as Seq
%uses Data.Set
%uses qualified Data.Set as Set
%uses Pelotero.Domain.Eligibility
%uses Pelotero.Domain.Position
%uses Pelotero.Domain.Roster

%untested placeablePicks, flowNetwork, addEdge, maxFlow, capacity, shortestAugmentingPath

data TeamNeed = TeamNeed
  { tnCounts :: !SlotCounts
    -- ^ How full the team's roster already is.
  , tnPicks  :: !Int
    -- ^ How many picks the team still makes.
  }
  deriving stock (Show, Eq)

data Node
  = Source
  | Sink
  | PositionNode !Position
  | PooledSlotNode !RosterSlot
    -- ^ One slot across every team that must fill all its open slots.
  | SlotNode     !Int !RosterSlot
    -- ^ Team index, slot, for a team that fills only some open slots.
  | TeamNode     !Int
  deriving stock (Show, Eq, Ord)

data Network = Network
  { nwResidual  :: !(Map (Node, Node) Int)
  , nwNeighbors :: !(Map Node (Set Node))
  }

placeablePicks :: RosterLimits -> Map Position Int -> [TeamNeed] -> Int
  ~ called by: Pelotero.Draft.remainingCapacity

flowNetwork :: RosterLimits -> Map Position Int -> [TeamNeed] -> Network
  ~ called by: Pelotero.Draft.Feasibility.placeablePicks

addEdge :: Network -> (Node, Node, Int) -> Network
  ~ clause: (Network residual neighbors) (u, v, c)
  ~ called by: Pelotero.Draft.Feasibility.flowNetwork

maxFlow :: Network -> Int
  ~ called by: Pelotero.Draft.Feasibility.placeablePicks

capacity :: Network -> (Node, Node) -> Int
  ~ called by: Pelotero.Draft.Feasibility.maxFlow, Pelotero.Draft.Feasibility.shortestAugmentingPath, Pelotero.Draft.validatePlan

shortestAugmentingPath :: Network -> Maybe [(Node, Node)]
  ~ called by: Pelotero.Draft.Feasibility.maxFlow


=== BEGIN Pelotero/Draft/Machine.hs ===

%file /home/bismuth/git/pelotero-engine/lib/Pelotero/Draft/Machine.hs
%mod Pelotero.Draft.Machine

%ext DataKinds, EmptyCase, ExistentialQuantification, GADTs, LambdaCase, ScopedTypeVariables, StandaloneDeriving, StandaloneKindSignatures, TemplateHaskell, TypeApplications, InstanceSigs, TypeFamilies, UndecidableInstances

%uses Crem.BaseMachine
%uses Crem.Render.RenderableVertices
%uses Crem.Topology
%uses Data.Functor.Identity
%uses Data.List
%uses qualified Data.Map.Strict as Map
%uses Data.Singletons.Base.TH
%uses Pelotero.Draft

%untested initialMachineState, draftStateVertex, toSomeDraftStateG, draftAction

instance RenderableVertices DraftVertex where

type DraftTopology =
  'Topology
    '[ '( 'WaitingToStartV, '[ 'WaitingToStartV, 'DraftingV ])
     , '( 'DraftingV,       '[ 'DraftingV,       'CompleteV ])
     , '( 'CompleteV,       '[ 'CompleteV ])
     ]

data DraftStateG (v :: DraftVertex) where
  WaitingToStartG :: DraftStateG 'WaitingToStartV
  DraftingG       :: !DraftContext -> DraftStateG 'DraftingV
  CompleteG       :: !DraftSummary -> DraftStateG 'CompleteV

data SomeDraftStateG = forall v.
  SomeDraftStateG (SDraftVertex v) (DraftStateG v)

instance Show SomeDraftStateG where

initialMachineState :: SomeDraftStateG
  ~ called by: Pelotero.Draft.Run.runAutoDraft

draftStateVertex :: SomeDraftStateG -> DraftVertex
  ~ clause: (SomeDraftStateG sv _)
  ~ no callers in scanned roots

toSomeDraftStateG :: DraftStateG v -> SomeDraftStateG
  ~ called by: Pelotero.Draft.Machine.runDraftCommand

fromDraftState :: DraftState -> SomeDraftStateG
  ~ no callers in scanned roots
  ? tested by: Pelotero.DraftSpec.runMachine, Pelotero.Draft.MachineSpec.spec, Pelotero.Draft.MachineSpec.runMachine

toDraftState :: DraftStateG v -> DraftState
  ~ no callers in scanned roots
  ? tested by: Pelotero.DraftSpec.runMachine, Pelotero.Draft.MachineSpec.spec, Pelotero.Draft.MachineSpec.runMachine

draftAction
  :: DraftStateG v
  -> DraftCommand
  -> ActionResult Identity DraftTopology DraftStateG v (Either DraftError [DraftEvent])
  ~ clause: WaitingToStartG (StartDraft plan)
  ~ clause: WaitingToStartG (MakePick _ _)
  ~ clause: WaitingToStartG EndDraft
  ~ clause: (DraftingG ctx) (StartDraft _)
  ~ clause: (DraftingG ctx) (MakePick team player)
  ~ clause: (DraftingG ctx) EndDraft
  ~ clause: (CompleteG summ) (StartDraft _)
  ~ clause: (CompleteG summ) (MakePick _ _)
  ~ clause: (CompleteG summ) EndDraft
  ~ fails: DraftNotStarted, DraftAlreadyStarted, DraftAlreadyComplete, NotYourTurn, NoOpenSlot, PickStrandsDraft
  ~ called by: Pelotero.Draft.Machine.runDraftCommand

runDraftCommand
  :: SomeDraftStateG
  -> DraftCommand
  -> (Either DraftError [DraftEvent], SomeDraftStateG)
  ~ clause: (SomeDraftStateG _ st) cmd
  ~ called by: Pelotero.Draft.Run.applyAndPersist
  ? tested by: Pelotero.DraftSpec.runMachine, Pelotero.Draft.MachineSpec.spec, Pelotero.Draft.MachineSpec.runMachine


=== BEGIN Pelotero/Draft/Run.hs ===

%file /home/bismuth/git/pelotero-engine/lib/Pelotero/Draft/Run.hs
%mod Pelotero.Draft.Run

%ext DataKinds, FlexibleContexts, GADTs, TypeOperators

%uses Data.Foldable
%uses Data.Int
%uses Data.Map.Strict
%uses qualified Data.Map.Strict as Map
%uses Data.Maybe
%uses qualified Data.Text as T
%uses Effectful
%uses qualified Katip as K
%uses Pelotero.DB.DraftPick
%uses Pelotero.DB.LeagueConfig
%uses Pelotero.DB.LeagueTeam
%uses Pelotero.DB.Player
%uses Pelotero.DB.PlayerRanking
%uses Pelotero.DB.RosterSlot
%uses Pelotero.Domain.Draft
%uses Pelotero.Domain.Id
%uses Pelotero.Domain.League
%uses Pelotero.Domain.Position
%uses Pelotero.Domain.Roster
%uses Pelotero.Draft
%uses Pelotero.Draft.Machine
%uses Pelotero.Effects.Clock
%uses qualified Pelotero.Effects.Clock as Clock
%uses Pelotero.Effects.DraftPick
%uses qualified Pelotero.Effects.DraftPick as DP
%uses Pelotero.Effects.LeagueConfig
%uses qualified Pelotero.Effects.LeagueConfig as LC
%uses Pelotero.Effects.LeagueTeam
%uses qualified Pelotero.Effects.LeagueTeam as LT
%uses Pelotero.Effects.Logging
%uses qualified Pelotero.Effects.Logging as Logging
%uses Pelotero.Effects.PlayerRanking
%uses qualified Pelotero.Effects.PlayerRanking as PR
%uses Pelotero.Effects.Players
%uses qualified Pelotero.Effects.Players as Players

%untested applyAndPersist, persistEvent, autoPickCommand, draftablePool, tshow

data AutoDraftError
  = AutoDraftRejected      !DraftError
    -- ^ State machine rejected a command issued by the loop itself.
    --   For 'StartDraft' this reports an unusable plan, including one
    --   the pool cannot complete ('PlanInfeasible'), and nothing has
    --   been written. For 'MakePick' it indicates a bug in this module,
    --   because the loop only issues picks that 'acceptedSlot' accepts.
  | AutoDraftNoCandidate   !DbLeagueTeamId
    -- ^ No available player is an acceptable pick for this team. Should
    --   be unreachable: the machine starts only plans the pool can
    --   complete and refuses any pick that would make the rest
    --   impossible, so the team on the clock always has an acceptable
    --   pick. Included as a defensive catch, like 'AutoDraftStuck'.
    --   Picks made before this point remain persisted.
  | AutoDraftStuck         !DraftVertex
    -- ^ Loop saw the state machine in an unexpected vertex
    --   (e.g. 'WaitingToStartV' after StartDraft was supposed to
    --   succeed). Should be unreachable; included as a defensive
    --   catch.
  | AutoDraftConfigMissing !DbLeagueConfigId
    -- ^ 'runAutoDraftForLeague' was called for a league id that
    --   doesn't exist in 'league_config'.
  | AutoDraftNotInDraft    !DbLeagueConfigId !T.Text
    -- ^ The league's status is not @"draft"@. Carries the status found.
  | AutoDraftAlreadyHasPicks !DbLeagueConfigId !Int64
    -- ^ The league already has persisted picks. Re-running would hit
    --   the unique constraints on @draft_pick@, so it is refused up
    --   front.
  | AutoDraftNoTeams       !DbLeagueConfigId
    -- ^ 'runAutoDraftForLeague' found the league config but no rows
    --   in 'league_team' for it.
  | AutoDraftBadStrategy   !T.Text
    -- ^ 'llcDraftStrategy' didn't parse via 'parseDraftOrderStrategy'.
    --   Carries the offending Text so operators can grep for it.
  deriving stock (Show, Eq)

applyAndPersist
  :: ( DraftPick :> es
     , Clock     :> es
     , Logging   :> es
     )
  => DbLeagueConfigId
  -> SomeDraftStateG
  -> DraftCommand
  -> Eff es (Either DraftError [DraftEvent], SomeDraftStateG)
  ! Takes (league, state, command); runs command through runDraftCommand; persists events for Right; logs at WarningS and returns Left for rejection.
  ! Rejection cases leave state unchanged (relies on the topology's self-loops in Pelotero.Draft.Machine).
  ! PickRecorded events become recordPick calls with picked_at = Clock.now; DraftStarted and DraftCompleted are log-only.
  ~ called by: Pelotero.Draft.Run.runAutoDraft

persistEvent
  :: ( DraftPick :> es
     , Clock     :> es
     , Logging   :> es
     )
  => DbLeagueConfigId
  -> DraftEvent
  -> Eff es ()
  ! PickRecorded -> recordPick with server-stamped picked_at and the league_config id from the caller.
  ! DraftStarted -> InfoS log line with league id and team count.
  ! DraftCompleted -> InfoS log line with league id and pick count.
  ~ called by: Pelotero.Draft.Run.applyAndPersist

runAutoDraft
  :: forall es.
     ( DraftPick     :> es
     , PlayerRanking :> es
     , Clock         :> es
     , Logging       :> es
     )
  => DraftPlan
  -> Eff es (Either AutoDraftError DraftSummary)
  ! intent: Drive a draft from initialMachineState to Complete via auto-picks; return the DraftSummary or an AutoDraftError.
  ! Persists every pick as a DraftPickRow as it happens.
  ! Single-process invocation; state lives only in this Eff stack — no IORef, no DB-state recovery on restart.
  ! DraftPlan must be pre-built by the caller (Pelotero.Domain.Draft.generateDraftOrder + active player pool); this function does not construct the plan.
  ! Future CLI command 'pelotero draft run --league=X' will live above this and own the plan construction.
  ~ fails: AutoDraftRejected, AutoDraftStuck
  ~ called by: Pelotero.Draft.Run.runAutoDraftForLeague
  ? tested by: Pelotero.Draft.RunSpec.spec

autoPickCommand
  :: ( PlayerRanking :> es
     , Logging       :> es
     )
  => DraftContext
  -> Eff es (Either AutoDraftError DraftCommand)
  ! Reads PR.getRankingsForTeam for the team whose turn it is.
  ! Filters rankings to dcAvailable; picks the head if any remain.
  ! Falls back to Set.lookupMin (dcAvailable ctx) if the ranked-and-available list is empty; logs WarningS on fallback.
  ! Returns Left (AutoDraftNoCandidate team) only if dcAvailable is empty AND rankings are exhausted.
  ~ fails: AutoDraftStuck, AutoDraftNoCandidate
  ~ called by: Pelotero.Draft.Run.runAutoDraft

draftablePool :: [LoadedPlayerRow] -> Map DbPlayerId Position
  ~ called by: Pelotero.Simulate.rankingStage, Pelotero.Draft.Run.runAutoDraftForLeague

runAutoDraftForLeague
  :: ( DraftPick     :> es
     , PlayerRanking :> es
     , Clock         :> es
     , Logging       :> es
     , LeagueConfig  :> es
     , LeagueTeam    :> es
     , Players       :> es
     )
  => DbLeagueConfigId
  -> Eff es (Either AutoDraftError DraftSummary)
  ~ called by: Pelotero.Simulate.runSimulation
  ? tested by: IntegrationTest.DraftRunSpec.spec

tshow :: Show a => a -> T.Text
  ~ called by: Pelotero.Draft.Run.applyAndPersist, Pelotero.Draft.Run.persistEvent, Pelotero.Draft.Run.runAutoDraft, Pelotero.Draft.Run.autoPickCommand, Pelotero.Draft.Run.runAutoDraftForLeague

%decision PerCommandPersistencePrimitive
  what:    applyAndPersist is the per-command primitive: takes one command, runs it through runDraftCommand, persists whichever events come out, returns the new state and the result. Both runAutoDraft and any future manual-pick UI handler go through it.
  why:     Keeps the persistence logic in one place; manual UI picks and auto-picks share the same code path. Returns SomeDraftStateG so the caller threads state across calls explicitly — no IORef, no MVar, no state-holding effect. Makes the primitive fully testable with the existing in-memory effect interpreters. DraftError flows through the Either; AutoDraftError is a strict superset for the loop-specific failures (no candidate, stuck, etc.).
  affects: applyAndPersist, runAutoDraft

%decision StatusUpdateNotInScope
  what:    applyAndPersist requires only DraftPick + Clock + Logging; the league_config status transition from 'draft' to 'active' is NOT done here
  why:     Pelotero.Draft.Run's job is recording picks. League lifecycle is a separate concern that belongs to whatever orchestrator started the draft. Decoupling means a replay-pick CLI command can re-run picks without bumping league status, and league-status transitions are tested independently of draft picking. Reverses the implication in D.1a's LastPickEmitsTwoEvents decision that DraftCompleted becomes a league_config status update; that annotation is being narrowed accordingly.
  affects: applyAndPersist, persistEvent, runAutoDraft

%decision AutoPickFallbackToLowestIdAvailable
  what:    autoPickCommand falls back to Set.lookupMin (dcAvailable ctx) when the team's ranking has no available candidates
  why:     Deterministic — same draft plan + same DB state always picks the same player, so the loop is reproducible across runs. Position-aware fallback (e.g. fill the team's positional needs) is more sophisticated and is properly D.1d's concern when porting AutoDraft.hs from old_src/. WarningS log line on every fallback so operators can see when ranking coverage is poor — the metric to watch is fallback-rate-per-draft.
  affects: autoPickCommand

%decision NoCrashRecovery
  what:    If the auto-draft loop crashes mid-draft, the partially-inserted DraftPick rows must be manually cleaned up before retry; recordPickT's Abort-on-conflict means a naive retry will fail at the first already-recorded pick
  why:     State-from-DB recovery (read existing picks, reconstruct DraftContext, resume from where we left off) is genuinely useful but well beyond D.1c's scope. The Abort-on-conflict fail-fast is the correct default — silent retry of duplicate picks would mask real bugs (double-pick, race condition, stale state, draft-id reuse). Operators retrying a partial draft DELETE FROM draft_pick WHERE league_config_id = X and re-run runAutoDraft. Not elegant, but the failure is rare enough that the explicit cleanup is acceptable for now.
  affects: runAutoDraft


=== BEGIN Pelotero/Draft.hs ===

%file /home/bismuth/git/pelotero-engine/lib/Pelotero/Draft.hs
%mod Pelotero.Draft

%uses Control.Monad
%uses Data.List
%uses Data.Map.Strict
%uses qualified Data.Map.Strict as Map
%uses Data.Maybe
%uses Pelotero.Domain.Eligibility
%uses Pelotero.Domain.Id
%uses Pelotero.Domain.Position
%uses Pelotero.Domain.Roster
%uses Pelotero.Draft.Feasibility

%untested initialState, isCompletable, remainingCapacity, rosterCountsFor

data DraftState
  = WaitingToStart
  | Drafting !DraftContext
  | Complete !DraftSummary
  deriving stock (Show, Eq)

data DraftContext = DraftContext
  { dcLeague    :: !DbLeagueConfigId
  , dcOrder     :: ![(DbLeagueTeamId, DraftPickNumber)]
  , dcRemaining :: ![(DbLeagueTeamId, DraftPickNumber)]
  , dcPool      :: !(Map DbPlayerId Position)
    -- ^ Players still available, with the position that decides which
    --   slots they may fill.
  , dcLimits    :: !RosterLimits
  , dcRosters   :: !(Map DbLeagueTeamId SlotCounts)
    -- ^ How full each team's roster is. A team with no picks yet has no
    --   entry; read through 'rosterCountsFor'.
  , dcPicksMade :: ![DraftPickEntry]
  }
  deriving stock (Show, Eq)

data DraftPickEntry = DraftPickEntry
  { dpePickNumber :: !DraftPickNumber
  , dpeTeam       :: !DbLeagueTeamId
  , dpePlayer     :: !DbPlayerId
  , dpeSlot       :: !RosterSlot
    -- ^ The roster slot the player was placed in.
  }
  deriving stock (Show, Eq)

data DraftSummary = DraftSummary
  { dsLeague :: !DbLeagueConfigId
  , dsPicks  :: ![DraftPickEntry]
  }
  deriving stock (Show, Eq)

data DraftPlan = DraftPlan
  { dpLeague :: !DbLeagueConfigId
  , dpOrder  :: ![(DbLeagueTeamId, DraftPickNumber)]
  , dpPool   :: !(Map DbPlayerId Position)
  , dpLimits :: !RosterLimits
  }
  deriving stock (Show, Eq)

data DraftCommand
  = StartDraft !DraftPlan
  | MakePick   !DbLeagueTeamId !DbPlayerId
  | EndDraft
  deriving stock (Show, Eq)

data DraftEvent
  = DraftStarted   !DbLeagueConfigId ![DbLeagueTeamId]
  | PickRecorded   !DraftPickEntry
  | DraftCompleted !DraftSummary
  deriving stock (Show, Eq)

data DraftError
  = DraftNotStarted
  | DraftAlreadyStarted
  | DraftAlreadyComplete
  | EmptyDraftPlan
  | PlanPickNumbersNotSequential
    -- ^ Pick numbers in the plan are not exactly 1, 2, 3, ... in order.
  | PlanOverfillsRoster  !DbLeagueTeamId !Int !Int
    -- ^ Team, picks the plan gives it, and the roster capacity. Such a
    --   plan could never finish, so it is refused before it starts.
  | PlanInfeasible       !Int !Int
    -- ^ Picks the pool can place at once, and picks the plan makes. The
    --   pool cannot fill the rosters the plan asks for, so the draft
    --   could never finish and is refused before it starts. Which slots
    --   go unfilled is not reported because it differs between equally
    --   good assignments; only these two numbers are fixed.
  | NotYourTurn          !DbLeagueTeamId !DbLeagueTeamId
  | PlayerAlreadyDrafted !DbPlayerId
  | PlayerNotInPool      !DbPlayerId
  | NoOpenSlot           !DbLeagueTeamId !DbPlayerId
    -- ^ Every slot the player is eligible for is full on that team.
  | PickStrandsDraft     !DbLeagueTeamId !DbPlayerId
    -- ^ The player fits an open slot, but after taking him the
    --   remaining picks could no longer all be placed, so the draft
    --   could not finish.
  deriving stock (Show, Eq)

initialState :: DraftState
  ! WaitingToStart; the empty start of any draft
  ~ no callers in scanned roots

validatePlan :: DraftPlan -> Maybe DraftError
  ~ clause: plan | null order
  ~ clause: plan | map snd order /= expectedNumbers
  ~ clause: plan | Just (team, n) <- find overfull counts
  ~ clause: plan | placeable < needed
  ~ called by: Pelotero.Draft.Machine.draftAction
  ? tested by: Pelotero.Draft.MachineSpec.spec

startContext :: DraftPlan -> DraftContext
  ~ called by: Pelotero.Draft.validatePlan, Pelotero.Draft.Machine.draftAction
  ? tested by: Pelotero.Draft.MachineSpec.spec

applyPick :: DraftPickEntry -> DraftContext -> DraftContext
  ~ called by: Pelotero.Draft.Machine.draftAction, Pelotero.Draft.acceptedSlot
  ? tested by: Pelotero.Draft.MachineSpec.completable, Pelotero.Draft.MachineSpec.driveToCompletion

isCompletable :: DraftContext -> Bool
  ~ called by: Pelotero.Draft.Machine.draftAction, Pelotero.Draft.acceptedSlot

remainingCapacity :: DraftContext -> (Int, Int)
  ~ called by: Pelotero.Draft.validatePlan, Pelotero.Draft.isCompletable

acceptedSlot :: DraftContext -> DbLeagueTeamId -> DbPlayerId -> Maybe RosterSlot
  ~ called by: Pelotero.Draft.Run.autoPickCommand
  ? tested by: Pelotero.DraftSpec.spec, Pelotero.Draft.MachineSpec.driveToCompletion, Pelotero.Draft.MachineSpec.applyPicks

currentPicker :: DraftState -> Maybe (DbLeagueTeamId, DraftPickNumber)
  ! Whose pick is up? Nothing if the draft hasn't started or has finished.
  ! Used by Pelotero.Draft.Run's auto-pick wrapper (D.1c) to identify which team's ranking to consult.
  ~ no callers in scanned roots
  ? tested by: Pelotero.DraftSpec.spec

picksRemaining :: DraftState -> Int
  ! Length of dcRemaining inside Drafting; 0 outside Drafting.
  ~ no callers in scanned roots
  ? tested by: Pelotero.DraftSpec.spec

isPlayerAvailable :: DbPlayerId -> DraftState -> Bool
  ! Set membership in dcAvailable; False outside Drafting.
  ~ no callers in scanned roots
  ? tested by: Pelotero.DraftSpec.spec

rosterCountsFor :: DbLeagueTeamId -> DraftContext -> SlotCounts
  ~ called by: Pelotero.Draft.applyPick, Pelotero.Draft.remainingCapacity, Pelotero.Draft.slotForPick

slotForPick :: DraftContext -> DbLeagueTeamId -> DbPlayerId -> Maybe RosterSlot
  ~ called by: Pelotero.Draft.Machine.draftAction, Pelotero.Draft.acceptedSlot
  ? tested by: Pelotero.DraftSpec.spec, Pelotero.Draft.MachineSpec.completable, Pelotero.Draft.MachineSpec.driveToCompletion, Pelotero.Draft.MachineSpec.applyPicks

%decision PureLogicNoEffects
  what:    Pelotero.Draft is the pure transition logic for the draft state machine; no effect dependencies, all transitions return Either DraftError (DraftState, [DraftEvent])
  why:     Phase D.1a separates the transition logic from the persistence layer so the state machine is testable with hedgehog without any DB or in-memory effect runner. Pelotero.Draft.Run (Phase D.1c) is the effectful handler that wraps applyCommand with PlayerRanking / DraftPick / Players / Logging / Clock; that is where commands actually get persisted. Pelotero.Domain.Draft remains the upstream-id-keyed pre-compute layer (order generation from a strategy + team list); this module is DB-id-keyed because the state machine talks to the persistence layer.
  affects: applyCommand

%decision AutoPickIsNotACommand
  what:    DraftCommand has only StartDraft, MakePick, EndDraft; auto-picking is a wrapper at the effect layer (D.1c) that consults PlayerRanking, intersects with dcAvailable, and issues MakePick with the chosen player
  why:     Keeps the pure logic with one place-a-player path rather than two; the strategy logic for which player gets picked stays separate from the how of recording it. Means the state machine itself doesn't take a ranking source as input — the ranking lookup happens before MakePick is constructed. If a future strategy variant emerges (round-specific overrides, drop-and-replace), it lives at the effect layer alongside the existing auto-pick wrapper, not as a new state-machine command.
  affects: DraftCommand, applyCommand

%decision LastPickEmitsTwoEvents
  what:    MakePick on the last remaining pick emits both PickRecorded and DraftCompleted in that order; EndDraft from Drafting emits only DraftCompleted
  why:     The handler in Pelotero.Draft.Run persists both events in order: insert the DraftPick row first, then log the completion. The league_config status update is the orchestrator's job, not the state-machine handler's, per Pelotero.Draft.Run's StatusUpdateNotInScope decision. Crash between events leaves the pick recorded with the in-memory machine state still consistent — the next run sees an empty dcRemaining and re-runs applyCommand to get DraftCompleted again; idempotent on the in-memory side. DB-level idempotency on partial-draft retries is documented separately under NoCrashRecovery. Flipping the order would leave a 'completed' log line with the last pick missing from draft_pick — a worse partial state for anyone reading logs.
  affects: applyCommand

%decision PicksMadeListSnocAppend
  what:    DraftContext.dcPicksMade is appended to in pick order (oldest first) using snoc; total cost is O(n²) across a full draft
  why:     n is small — at most ~300 picks for a 25-team / 12-round league. 300² = 90,000 cons cells; not a perf concern. Oldest-first ordering means the DraftSummary doesn't need a final reverse step, and the audit trail reads naturally in chronological order without calling reverse on every read. If a much larger draft format appears (50-team dynasty with 30 rounds = 1500 picks), revisit; until then the simpler shape wins.
  affects: applyCommand


