getActivePlayers :: Players E.:> es => E.Eff es [LoadedPlayerRow]
  ! Players send-only; all players where active=True
  ~ called by: Pelotero.Simulate.rankingStage, Pelotero.Draft.Run.runAutoDraftForLeague
  ? tested by: Pelotero.Effects.PlayersSpec.spec

runPlayersDB
  :: Database E.:> es
  => E.Eff (Players : es) a
  -> E.Eff es a
  ! Database-backed interpreter; delegates to Pelotero.DB.Player
  ! requires Error DBError post Phase A.3
  ~ called by: Pelotero.App.runApp
  ? tested by: IntegrationTest.SyncPlayersSpec.spec, IntegrationTest.SyncScheduleSpec.spec, IntegrationTest.SyncBoxscoresSpec.spec, IntegrationTest.DraftRunSpec.runStack, IntegrationTest.SimulateSpec.runStack, IntegrationTest.SmokeSpec.runStack

emptyStore :: PlayerStore
  ! private; PlayerStore Map.empty Map.empty 1
  ~ called by: Pelotero.Effects.Players.runPlayersInMemory

runPlayersInMemory
  :: IOE E.:> es
  => E.Eff (Players : es) a
  -> E.Eff es a
  ! IORef-based test interpreter
  ! UpsertPlayerByExternalId: if (provider, externalId) found, update rowsByDb keeping the existing id; else assign nextId and insert into both maps
  ! GetActivePlayers iterates all rows and filters by playerRowActive
  ~ no callers in scanned roots
  ? tested by: Pelotero.Effects.PlayersSpec.spec, Pelotero.Sync.PlayersSpec.spec, Pelotero.Sync.BoxscoresSpec.spec, Pelotero.Sync.PlayersSpec.runRosters, Pelotero.Sync.BoxscoresSpec.runStack

%decision InMemoryAssignsAutoIncrementId
  what:    runPlayersInMemory's UpsertPlayerByExternalId uses an internal nextId counter (Int starting at 1)
  why:     Mirrors the DB's BIGSERIAL behaviour without needing an actual sequence. Counter is per-IORef (per-runner-instance), so two concurrent test runs don't share ids.
  affects: runPlayersInMemory, emptyStore


