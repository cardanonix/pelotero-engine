  :: Pool -> DbLeagueTeamId -> DbGameId -> IO (Either DBError Bool)
  ! Pool-flavored wrapper
  ~ no callers in scanned roots

getSnapshotsForGame
  :: Pool -> DbGameId -> IO (Either DBError [LineupSnapshotRow])
  ! Pool-flavored wrapper
  ~ no callers in scanned roots

getSnapshotsForDateRange
  :: Pool -> Day -> Day -> IO (Either DBError [LineupSnapshotRow])
  ~ no callers in scanned roots

%decision SnapshotKeyedByLeagueTeamAndGame
  what:    lineup_snapshot has UNIQUE (league_team_id, game_id, slot, player_id); a snapshot is the team's lineup-as-of-this-specific-game
  why:     Phase B.3 introduced the table to fix the correctness bug where scoring used current lineups against historical games. (league_team_id, game_id) is the lookup key for scoring; slot + player_id complete the row's identity. snapshotted_at TIMESTAMPTZ DEFAULT NOW() records when the snapshot was actually taken; useful for debugging late-snapshot or out-of-order-snapshot scenarios. No order_index column today; if/when B.2 adds it to lineup_slot, the snapshot will need it too so that snapshots preserve the lineup ordering at snapshot time.
  affects: lineupSnapshotSchema, writeSnapshotsT

%decision ImmutableSnapshotsViaOnConflictDoNothing
  what:    writeSnapshotsT uses ON CONFLICT (league_team_id, game_id, slot, player_id) DO NOTHING; once a snapshot row exists, it is never overwritten
  why:     Snapshots model 'the lineup at game start' and must be immutable after that. Combined with Lineup.Snapshot's pre-check via snapshotExistsForTeamGameT, this gives 'first snapshot wins' semantics for the (team, game) pair as a whole. Re-running snapshot jobs is therefore a safe operational primitive.
  affects: writeSnapshotsT


=== BEGIN Pelotero/DB/Migration.hs ===

%file /home/bismuth/git/pelotero-engine/lib/Pelotero/DB/Migration.hs
%mod Pelotero.DB.Migration

%uses Control.Monad
%uses Crypto.Hash.SHA256
%uses Data.ByteString
%uses qualified Data.ByteString as BS
%uses qualified Data.ByteString.Base16 as B16
%uses Data.Functor.Contravariant
%uses Data.List
%uses Data.Text
%uses qualified Data.Text as T
%uses qualified Data.Text.Encoding as TE
%uses qualified Hasql.Decoders as D
%uses qualified Hasql.Encoders as E
%uses qualified Hasql.Session as Session
%uses qualified Hasql.Statement as Stmt
%uses qualified Hasql.Transaction as Tx
%uses qualified Hasql.Transaction.Sessions as TxS
%uses System.Directory
%uses System.FilePath
%uses Pelotero.DB.Pool

%untested runMigrations, loadScript, hexSha256, applyAll, applyOne, ensureMigrationsTable, selectChecksum, insertApplied

data MigrationOutcome = MigrationOutcome
  { migrationsTotalSeen  :: !Int  -- ^ files examined
  , migrationsAppliedNow :: !Int  -- ^ first-time applies during this call
  , migrationsAlreadyApplied :: !Int -- ^ skipped because already applied
  }
  deriving stock (Show, Eq)

data Script = Script
  { scriptName     :: !Text
  , scriptContents :: !ByteString
  , scriptChecksum :: !Text
  }

data ApplyResult = Skipped | Applied | Mismatch

runMigrations :: Pool -> FilePath -> IO (Either DBError MigrationOutcome)
  ! intent: Apply all .sql files in dir that haven't been applied; verify checksums of those that have
  ! effects: IO (filesystem + DB)
  ! missing directory is a hard error (MigrationError 'Migration directory not found')
  ! SUCCESS path: returns Right MigrationOutcome with totals
  ! MISMATCH path: returns Left MigrationError with the filename
  ! ensures schema_migrations exists via a CREATE TABLE IF NOT EXISTS at the start of applyAll
  ! idempotent: safe to call on every process startup
  ! most recent migration: V0030__lineup_snapshot.sql (added in Phase B.3)
  ~ fails: MigrationError
  ~ literals: ".sql"
  ~ no callers in scanned roots

loadScript :: FilePath -> FilePath -> IO Script
  ! private; reads a file's bytes and computes its SHA-256 hex string
  ! scriptName is the bare filename (Text), not the full path
  ~ called by: Pelotero.DB.Migration.runMigrations

hexSha256 :: ByteString -> Text
  ! ByteString -> Text; SHA-256 then base16 then UTF-8 decode
  ~ called by: Pelotero.DB.Migration.loadScript

applyAll :: [Script] -> Session.Session (Either Text MigrationOutcome)
  ! first runs ensureMigrationsTable in its own transaction
  ! then folds over scripts; on the first Mismatch, stops and returns Left
  ~ called by: Pelotero.DB.Migration.runMigrations

applyOne :: Script -> Tx.Transaction ApplyResult
  ! looks up the prior checksum for this filename; if present and matching, returns Skipped
  ! if present and DIFFERENT, returns Mismatch (does NOT throw — the caller decides)
  ! if absent, runs the SQL via Tx.sql then inserts the (filename, checksum) pair, both in the same transaction
  ~ called by: Pelotero.DB.Migration.applyAll

ensureMigrationsTable :: Tx.Transaction ()
  ! CREATE TABLE IF NOT EXISTS schema_migrations (filename TEXT PK, checksum TEXT NOT NULL, applied_at TIMESTAMPTZ DEFAULT NOW())
  ~ called by: Pelotero.DB.Migration.applyAll

selectChecksum :: Stmt.Statement Text (Maybe Text)
  ! Statement Text -> Maybe Text; one row or none
  ~ called by: Pelotero.DB.Migration.applyOne

insertApplied :: Stmt.Statement (Text, Text) ()
  ! Statement (Text, Text) -> ()
  ~ called by: Pelotero.DB.Migration.applyOne

%decision OwnedMigrationRunner
  what:    Custom migration runner instead of hasql-migration
  why:     hasql-migration is broken against current crypton (which we use for SHA-256) and is effectively unmaintained. Migrations are a couple hundred lines we can own outright; less cost than maintaining a fork. Owning the implementation also lets us encode our specific operational policy (immutable migrations, hash mismatch is a hard error) directly.
  affects: runMigrations, applyAll, applyOne

%decision ImmutableMigrationsHashChecked
  what:    Each migration file is hashed (SHA-256) on first apply; subsequent runs verify the hash and abort with Mismatch if the file has changed
  why:     Prevents accidental edits from silently de-syncing dev/prod schemas. Forces the convention 'create a new V0042__ file' rather than 'edit V0007__'. Whitespace-sensitive on purpose: any edit, even cosmetic, trips the alarm.
  affects: applyOne, loadScript

%decision PerMigrationTransaction
  what:    Each migration runs in its own transaction (not the whole batch)
  why:     A failure rolls back exactly the offending migration, leaving the prior ones intact. Avoids the 'partially applied batch' state.
  affects: applyAll, applyOne

%decision FilenameOrderIsApplyOrder
  what:    Migration files are sorted lexicographically; apply order = filename order
  why:     The convention V<NNNN>__<desc>.sql with zero-padded numbers makes lexicographic order match numeric order. Forgetting to zero-pad (V42__ before V9__) is caught by code review, not by the runner.
  affects: runMigrations


