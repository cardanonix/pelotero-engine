%file /home/bismuth/git/pelotero-engine/lib/Pelotero/Effects/BoxscoreEntry.hs
%mod Pelotero.Effects.BoxscoreEntry

%ext DataKinds, FlexibleContexts, GADTs, LambdaCase, TypeFamilies, TypeOperators

%uses Data.Time.Calendar
%uses Effectful
%uses qualified Effectful as E
%uses Effectful.Dispatch.Dynamic
%uses Pelotero.DB.BoxscoreEntry
%uses qualified Pelotero.DB.BoxscoreEntry as BoxRepo
%uses Pelotero.Domain.Id
%uses Pelotero.Effects.Database

%untested upsertBatting, upsertPitching, getBattingForGame, getPitchingForGame, getBattingForDateRange, getPitchingForDateRange, deleteBattingForGame, deletePitchingForGame

data BoxscoreEntry :: Effect where
  UpsertBatting           :: BattingRow  -> BoxscoreEntry m ()
  UpsertPitching          :: PitchingRow -> BoxscoreEntry m ()
  GetBattingForGame       :: DbGameId    -> BoxscoreEntry m [BattingRow]
  GetPitchingForGame      :: DbGameId    -> BoxscoreEntry m [PitchingRow]
  GetBattingForDateRange  :: Day -> Day  -> BoxscoreEntry m [BattingRow]
  GetPitchingForDateRange :: Day -> Day  -> BoxscoreEntry m [PitchingRow]
  DeleteBattingForGame    :: DbGameId    -> BoxscoreEntry m ()
  DeletePitchingForGame   :: DbGameId    -> BoxscoreEntry m ()

upsertBatting :: BoxscoreEntry E.:> es => BattingRow -> E.Eff es ()
  ! BoxscoreEntry send-only
  ~ called by: Pelotero.Sync.Boxscores.upsertEntries

upsertPitching :: BoxscoreEntry E.:> es => PitchingRow -> E.Eff es ()
  ! BoxscoreEntry send-only
  ~ called by: Pelotero.Sync.Boxscores.upsertEntries

getBattingForGame
  :: BoxscoreEntry E.:> es => DbGameId -> E.Eff es [BattingRow]
  ! BoxscoreEntry send-only
  ! consumed by Pelotero.Score.buildPlayerMaps (one call per game in the period)
  ~ no callers in scanned roots

getPitchingForGame
  :: BoxscoreEntry E.:> es => DbGameId -> E.Eff es [PitchingRow]
  ! BoxscoreEntry send-only
  ! consumed by Pelotero.Score.buildPlayerMaps
  ~ no callers in scanned roots

getBattingForDateRange
  :: BoxscoreEntry E.:> es => Day -> Day -> E.Eff es [BattingRow]
  ~ called by: Pelotero.Score.buildPlayerMaps

getPitchingForDateRange
  :: BoxscoreEntry E.:> es => Day -> Day -> E.Eff es [PitchingRow]
  ~ called by: Pelotero.Score.buildPlayerMaps

deleteBattingForGame :: BoxscoreEntry E.:> es => DbGameId -> E.Eff es ()
  ! BoxscoreEntry send-only
  ~ no callers in scanned roots

deletePitchingForGame :: BoxscoreEntry E.:> es => DbGameId -> E.Eff es ()
  ! BoxscoreEntry send-only
  ~ no callers in scanned roots

runBoxscoreEntryDB
  :: Database E.:> es
  => E.Eff (BoxscoreEntry : es) a
  -> E.Eff es a
  ! Database-backed interpreter; requires Error DBError
  ~ called by: Pelotero.App.runApp
  ? tested by: IntegrationTest.SyncScheduleSpec.spec, IntegrationTest.SyncBoxscoresSpec.spec, IntegrationTest.ScoreSpec.spec, IntegrationTest.SimulateSpec.runStack, IntegrationTest.SmokeSpec.runStack

runBoxscoreEntryNever
  :: E.Eff (BoxscoreEntry : es) a
  -> E.Eff es a
  ! test interpreter that errors on every operation
  ! useful for tests that need BoxscoreEntry in the effect stack but exercise paths where no batting/pitching upsert should occur (e.g. C.1 SHA-skip tests with empty boxscore JSON)
  ! any actual invocation is the test's bug, not a real failure mode — the error message names the operation that was unexpectedly called
  ~ fails: "runBoxscoreEntryNever: UpsertBatting was unexpectedly invoked", "runBoxscoreEntryNever: UpsertPitching was unexpectedly invoked", "runBoxscoreEntryNever: GetBattingForGame was unexpectedly invoked", "runBoxscoreEntryNever: GetPitchingForGame was unexpectedly invoked", "runBoxscoreEntryNever: GetBattingForDateRange was unexpectedly invoked", "runBoxscoreEntryNever: GetPitchingForDateRange was unexpectedly invoked", "runBoxscoreEntryNever: DeleteBattingForGame was unexpectedly invoked", "runBoxscoreEntryNever: DeletePitchingForGame was unexpectedly invoked"
  ~ no callers in scanned roots
  ? tested by: Pelotero.Sync.BoxscoresSpec.spec, Pelotero.Sync.BoxscoresSpec.runStack


=== BEGIN Pelotero/Effects/Clock.hs ===

%file /home/bismuth/git/pelotero-engine/lib/Pelotero/Effects/Clock.hs
%mod Pelotero.Effects.Clock

%ext TypeFamilies, DataKinds, TypeOperators, GADTs, LambdaCase, FlexibleContexts

%uses Data.Time
%uses Effectful
%uses qualified Effectful as E
%uses Effectful.Dispatch.Dynamic

%untested now, runClockIO

data Clock :: Effect where
  Now :: Clock m UTCTime

now :: Clock E.:> es => E.Eff es UTCTime
  ! the only operation; returns the current time per the active interpreter
  ~ called by: Pelotero.Sync.Schedule.syncSchedule, Pelotero.Sync.Players.syncRosters, Pelotero.Draft.Run.persistEvent

runClockIO :: IOE E.:> es => E.Eff (Clock : es) a -> E.Eff es a
  ! IO interpreter; calls Data.Time.getCurrentTime per call
  ~ called by: Pelotero.App.runApp

runClockFixed :: UTCTime -> E.Eff (Clock : es) a -> E.Eff es a
  ! fixed-time interpreter; every call returns the same UTCTime
  ! useful for deterministic tests
  ~ no callers in scanned roots
  ? tested by: Pelotero.Sync.PlayersSpec.spec, Pelotero.Sync.ScheduleSpec.spec, IntegrationTest.SyncPlayersSpec.spec, IntegrationTest.SyncScheduleSpec.spec, IntegrationTest.SyncBoxscoresSpec.spec, Pelotero.Sync.PlayersSpec.runRosters, Pelotero.Sync.ScheduleSpec.runSchedule, IntegrationTest.DraftRunSpec.runStack, Pelotero.Draft.RunSpec.runWorld, IntegrationTest.SimulateSpec.runStack, IntegrationTest.SmokeSpec.runStack

%decision FixedTimeForTests
  what:    runClockFixed is the test interpreter; every now call returns the same fixed UTCTime
  why:     Sync code uses Clock.now to stamp synced_at on rows; tests need the same value to compare against. An incrementing-on-each-call interpreter would test more edge cases but adds complexity.
  affects: runClockFixed


=== BEGIN Pelotero/Effects/Database.hs ===

%file /home/bismuth/git/pelotero-engine/lib/Pelotero/Effects/Database.hs
%mod Pelotero.Effects.Database

%ext DataKinds, FlexibleContexts, GADTs, LambdaCase, TypeFamilies, TypeOperators

%uses qualified Hasql.Transaction as Tx
%uses Effectful
%uses Effectful.Dispatch.Dynamic
%uses Effectful.Error.Static
%uses qualified Pelotero.DB.Pool as Pool
%uses Pelotero.DB.Pool
%uses Pelotero.Effects.Logging

%abstract Database  hidden: RunTx  made by: no exported function returns it

data Database :: Effect where
  RunTx :: Tx.Transaction a -> Database m a

runTx :: Database :> es => Tx.Transaction a -> Eff es a
  ! the only public operation; takes a Tx.Transaction a and returns Eff es a
  ! each call is one independent transaction; no nesting, no batching
  ! writes commit on success; on Tx error, throwError @DBError is invoked rather than throwing IO
  ~ called by: Pelotero.Effects.FetchLog.runFetchLogDB, Pelotero.Effects.PlayerRanking.runPlayerRankingDB, Pelotero.Effects.LineupSlot.runLineupSlotDB, Pelotero.Effects.Teams.runTeamsDB, Pelotero.Effects.Players.runPlayersDB, Pelotero.Effects.LeagueTeam.runLeagueTeamDB, Pelotero.Effects.LineupSnapshot.runLineupSnapshotDB, Pelotero.Effects.LeagueConfig.runLeagueConfigDB, +4 more
  ? tested by: IntegrationTest.SyncPlayersSpec.spec, IntegrationTest.SyncScheduleSpec.spec, IntegrationTest.SyncBoxscoresSpec.spec, IntegrationTest.ScoreSpec.spec, IntegrationTest.DraftRunSpec.spec, IntegrationTest.SmokeSpec.spec, IntegrationTest.SyncPlayersSpec.lookupTeamRow, IntegrationTest.SyncPlayersSpec.lookupPlayerRow, IntegrationTest.SmokeSpec.requirePlayer

runDatabasePool
  :: ( IOE :> es
     , Logging :> es
     , Error DBError :> es
     )
  => Pool
  -> Eff (Database : es) a
  -> Eff es a
  ! intent: Production interpreter: runs each runTx via Pool.runTransaction; on Left DBError, logs at ErrorS then calls throwError into the Error DBError co-effect
  ! effects: IOE, Logging, Error DBError
  ! no longer throws userError; DBError flows through the effect system
  ! callers compose with `runErrorNoCallStack @DBError` at whatever boundary they want to handle errors
  ! the rationale shift from throw-IO to typed-Error is captured in DbErrorAsTypedCoEffect
  ~ called by: Pelotero.App.runApp
  ? tested by: IntegrationTest.SyncPlayersSpec.spec, IntegrationTest.SyncScheduleSpec.spec, IntegrationTest.SyncBoxscoresSpec.spec, IntegrationTest.ScoreSpec.spec, IntegrationTest.DraftRunSpec.runStack, IntegrationTest.SimulateSpec.runStack, IntegrationTest.SmokeSpec.runStack

%decision OneOperationOneTransaction
  what:    Database has a single operation, runTx, which acquires a connection and runs the transaction in isolation
  why:     Each runTx is its own atomic unit; no need for callers to manage connection scope. Composing multiple runTx calls is NOT one transaction — they're independent. If you need a multi-step atomic operation, build a single Transaction and pass it to one runTx. This matches Pool.runTransaction's contract; the Database effect is a thin wrapper to make it dispatchable through the effectful machinery.
  affects: runTx, runDatabasePool

%decision DbErrorAsTypedCoEffect
  what:    runDatabasePool requires Logging and Error DBError co-effects; DBErrors flow through the effect system as typed errors and are also logged at ErrorS before throwing
  why:     Phase A.3 replaced the runOrThrow pattern. Callers that don't care about typed handling do `runErrorNoCallStack @DBError` at the top of the program and either crash or log on Left; callers that want to handle pool exhaustion specifically can pattern-match on PoolUsageError. Removes the lossy `show` step that used to live in runOrThrow; structured error data now propagates intact. Logging the error before throwing means a silently-discarded Left still leaves a trace. Every effect runner consuming Database (Players, Teams, Games, BoxscoreEntry, FetchLog, LeagueConfig, LeagueTeam, RosterSlot, LineupSlot, LineupSnapshot, PlayerRanking, DraftPick) threads `Error DBError` through. Type signature: runDatabasePool :: (IOE :> es, Logging :> es, Error DBError :> es) => Pool -> Eff (Database : es) a -> Eff es a
  affects: runDatabasePool


