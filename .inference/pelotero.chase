playerRankingSchema :: TableSchema (PlayerRankingE Name)
  ! table 'player_ranking' with FK to league_team, FK to player, rank_slot (Int32), updated_at
  ! PK is (league_team_id, player_id) — no surrogate id
  ~ literals: "player_ranking", "league_team_id", "player_id", "rank_slot", "updated_at"
  ~ called by: Pelotero.DB.PlayerRanking.insertOneT, Pelotero.DB.PlayerRanking.getRankingsForTeamT, Pelotero.DB.PlayerRanking.clearRankingsT, Pelotero.DB.PlayerRanking.getRankingCountT

