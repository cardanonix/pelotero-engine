%uses Pelotero.DB.ProviderKeyed
%uses Pelotero.DB.Provider
%uses Pelotero.DB.Rel8Instances
%uses Pelotero.Domain.Id

%untested teamRowToLoaded, teamSchema, teamExternalIdSchema, fromResult, teamRowToExpr, updateTeamT, getAllT, getExternalIdT
%untested insertTeam, updateTeam, getById, getAll, linkExternalId, lookupByExternalId, getExternalId, upsertByExternalId

data Team f = Team
  { _teamId                 :: Column f DbTeamId
  , _teamName               :: Column f Text
  , _teamAbbreviation       :: Column f Text
  , _teamLocationName       :: Column f Text
  , _teamLastSyncedProvider :: Column f (Maybe ProviderName)
  , _teamLastSyncedAt       :: Column f (Maybe UTCTime)
  }
  deriving stock    (Generic)
  deriving anyclass (Rel8able)

data TeamRow = TeamRow
  { teamRowId                 :: !(Maybe DbTeamId)
  , teamRowName               :: !Text
  , teamRowAbbreviation       :: !Text
  , teamRowLocationName       :: !Text
  , teamRowLastSyncedProvider :: !(Maybe ProviderName)
  , teamRowLastSyncedAt       :: !(Maybe UTCTime)
  }
  deriving stock (Show, Eq)

data LoadedTeamRow = LoadedTeamRow
  { ltrId                 :: !DbTeamId
  , ltrName               :: !Text
  , ltrAbbreviation       :: !Text
  , ltrLocationName       :: !Text
  , ltrLastSyncedProvider :: !(Maybe ProviderName)
  , ltrLastSyncedAt       :: !(Maybe UTCTime)
  }
  deriving stock (Show, Eq)

instance ProviderKeyed TeamRow where

teamRowToLoaded :: DbTeamId -> TeamRow -> LoadedTeamRow
  ~ clause: tid TeamRow {..}
  ~ called by: Pelotero.Effects.Teams.runTeamsInMemory

teamSchema :: TableSchema (Team Name)
  ! table 'team' with surrogate id, name, abbreviation, location_name (city), and last-synced metadata
  ! no FK out — teams are leaves in the FK graph
  ~ literals: "team", "id", "name", "abbreviation", "location_name", "last_synced_provider", +1 more
  ~ called by: Pelotero.DB.Team.insertTeamT, Pelotero.DB.Team.updateTeamT, Pelotero.DB.Team.getByIdT, Pelotero.DB.Team.getAllT

teamExternalIdSchema :: TableSchema (ExternalIdE DbTeamId Name)
  ! same shape as player_external_id: (team_id, provider, external_id, fetched_at)
  ~ literals: "team_external_id", "team_id", "provider", "external_id", "fetched_at"
  ~ no callers in scanned roots

fromResult :: Team Result -> LoadedTeamRow
  ! private; rel8 Result -> public TeamRow
  ~ clause: Team {..}
  ~ called by: Pelotero.DB.Team.getByIdT, Pelotero.DB.Team.getAllT

teamRowToExpr :: TeamRow -> Team Expr
  ~ clause: TeamRow {..}
  ~ called by: Pelotero.DB.Team.insertTeamT, Pelotero.DB.Team.updateTeamT

insertTeamT :: TeamRow -> Tx.Transaction DbTeamId
  ! INSERT ... RETURNING id; Abort on conflict
  ~ called by: Pelotero.DB.Team.insertTeam
  ? tested by: IntegrationTest.TeamRepoSpec.spec, IntegrationTest.PlayerRepoSpec.spec, IntegrationTest.GameRepoSpec.spec, IntegrationTest.BoxscoreEntryRepoSpec.spec, IntegrationTest.ScoreSpec.spec, IntegrationTest.SmokeSpec.spec, IntegrationTest.Fixtures.addTeamT

updateTeamT :: DbTeamId -> TeamRow -> Tx.Transaction ()
  ! WHERE id = tid; updates everything except id
  ~ called by: Pelotero.DB.Team.updateTeam

getByIdT :: DbTeamId -> Tx.Transaction (Maybe LoadedTeamRow)
  ! single-row select via WHERE id
  ~ called by: Pelotero.Effects.Teams.runTeamsDB, Pelotero.DB.Team.getById
  ? tested by: IntegrationTest.TeamRepoSpec.spec, IntegrationTest.SyncPlayersSpec.lookupTeamRow

getAllT :: Tx.Transaction [LoadedTeamRow]
  ! ORDER BY name; no pagination; 30 MLB teams
  ~ called by: Pelotero.Effects.Teams.runTeamsDB, Pelotero.DB.Team.getAll

linkExternalIdT :: DbTeamId -> ProviderName -> Text -> Tx.Transaction ()
  ! INSERT ... ON CONFLICT DO NOTHING into team_external_id
  ~ no callers in scanned roots
