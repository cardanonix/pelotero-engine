  :: DbLeagueTeamId -> DbGameId -> Tx.Transaction Bool
  ! SELECT ... LIMIT 1; returns True iff at least one row exists for the (team, game) pair
  ! used by Pelotero.Lineup.Snapshot.snapshotLineupsForTeam as the 'is this snapshot already locked in?' guard
  ~ called by: Pelotero.Effects.LineupSnapshot.runLineupSnapshotDB, Pelotero.DB.LineupSnapshot.snapshotExistsForTeamGame

getSnapshotsForGameT :: DbGameId -> Tx.Transaction [LineupSnapshotRow]
  ! WHERE game_id; returns every snapshot row across all teams for one game
  ! useful for debugging or auditing; not on the scoring hot path
  ~ called by: Pelotero.Effects.LineupSnapshot.runLineupSnapshotDB, Pelotero.DB.LineupSnapshot.getSnapshotsForGame

getSnapshotsForDateRangeT
  :: Day -> Day -> Tx.Transaction [LineupSnapshotRow]
  ~ called by: Pelotero.Effects.LineupSnapshot.runLineupSnapshotDB, Pelotero.DB.LineupSnapshot.getSnapshotsForDateRange

writeSnapshots :: Pool -> [LineupSnapshotRow] -> IO (Either DBError ())
  ! Pool-flavored wrapper
  ~ no callers in scanned roots

getSnapshotForTeamGame
  :: Pool
  -> DbLeagueTeamId
  -> DbGameId
  -> IO (Either DBError [LineupSnapshotRow])
  ! Pool-flavored wrapper
  ~ no callers in scanned roots

