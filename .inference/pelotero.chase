%untested getSnapshotForTeamGame, snapshotExistsForTeamGame, getSnapshotsForGame, getSnapshotsForDateRange

data LineupSnapshot f = LineupSnapshot
  { _lsnapId            :: Column f Int64
  , _lsnapLeagueTeamId  :: Column f DbLeagueTeamId
  , _lsnapGameId        :: Column f DbGameId
  , _lsnapSlot          :: Column f Text
  , _lsnapPlayerId      :: Column f DbPlayerId
  , _lsnapSnapshottedAt :: Column f UTCTime
  }
  deriving stock    (Generic)
  deriving anyclass (Rel8able)

data LineupSnapshotRow = LineupSnapshotRow
  { lsnapLeagueTeamId :: !DbLeagueTeamId
  , lsnapGameId       :: !DbGameId
  , lsnapSlot         :: !Text
  , lsnapPlayerId     :: !DbPlayerId
  }
  deriving stock (Show, Eq)

lineupSnapshotSchema :: TableSchema (LineupSnapshot Name)
  ! table 'lineup_snapshot' with id (BIGSERIAL), league_team_id (FK), game_id (FK), slot (Text), player_id (FK), snapshotted_at (TIMESTAMPTZ DEFAULT NOW())
  ! UNIQUE (league_team_id, game_id, slot, player_id)
  ! index lineup_snapshot_game on (game_id)
  ! index lineup_snapshot_team_game on (league_team_id, game_id)
  ! introduced by V0030__lineup_snapshot.sql (Phase B.3)
  ~ literals: "lineup_snapshot", "id", "league_team_id", "game_id", "slot", "player_id", +1 more
  ~ called by: Pelotero.DB.LineupSnapshot.writeSnapshotsT, Pelotero.DB.LineupSnapshot.getSnapshotForTeamGameT, Pelotero.DB.LineupSnapshot.snapshotExistsForTeamGameT, Pelotero.DB.LineupSnapshot.getSnapshotsForGameT, Pelotero.DB.LineupSnapshot.getSnapshotsForDateRangeT

fromResult :: LineupSnapshot Result -> LineupSnapshotRow
  ! private; rel8 Result -> LineupSnapshotRow
  ! drops surrogate id and snapshotted_at from the public row type
  ~ clause: LineupSnapshot {..}
  ~ called by: Pelotero.DB.LineupSnapshot.getSnapshotForTeamGameT, Pelotero.DB.LineupSnapshot.getSnapshotsForGameT, Pelotero.DB.LineupSnapshot.getSnapshotsForDateRangeT

writeSnapshotsT :: [LineupSnapshotRow] -> Tx.Transaction ()
  ! INSERT [LineupSnapshotRow] ... ON CONFLICT DO NOTHING; returns ()
  ! empty input returns immediately without hitting the database
  ! callers track the count of attempted rows via 'length' on the input; the function does not return a count today
  ~ clause: []
  ~ called by: Pelotero.Effects.LineupSnapshot.runLineupSnapshotDB, Pelotero.DB.LineupSnapshot.writeSnapshots

