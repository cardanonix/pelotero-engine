%file /home/bismuth/git/pelotero-engine/lib/Pelotero/DB/PlayerRanking.hs
%mod Pelotero.DB.PlayerRanking

%ext DataKinds, DeriveAnyClass, DeriveGeneric, DerivingStrategies, DuplicateRecordFields, OverloadedStrings, StandaloneDeriving, TypeFamilies, TypeOperators, UndecidableInstances

%uses Data.Functor.Contravariant
%uses Data.Int
%uses Data.Time
%uses GHC.Generics
%uses qualified Hasql.Transaction as Tx
%uses Rel8
%uses qualified Rel8 as R
%uses Pelotero.DB.Pool
%uses Pelotero.DB.Rel8Instances
%uses Pelotero.Domain.Id

data PlayerRankingE f = PlayerRankingE
  { _prLeagueTeamId :: Column f DbLeagueTeamId
  , _prPlayerId     :: Column f DbPlayerId
  , _prRankSlot     :: Column f Int32
  , _prUpdatedAt    :: Column f UTCTime
  }
  deriving stock    (Generic)
  deriving anyclass (Rel8able)

data PlayerRankingRow = PlayerRankingRow
  { prLeagueTeamId :: !DbLeagueTeamId
  , prPlayerId     :: !DbPlayerId
  , prRankSlot     :: !Int32
  }
  deriving stock (Show, Eq)

playerRankingSchema :: TableSchema (PlayerRankingE Name)
  ! table 'player_ranking' with FK to league_team, FK to player, rank_slot (Int32), updated_at
  ! PK is (league_team_id, player_id) — no surrogate id

fromResult :: PlayerRankingE Result -> PlayerRankingRow
  ! private; rel8 Result -> PlayerRankingRow; drops updated_at

insertOneT :: PlayerRankingRow -> Tx.Transaction ()
  ! private; INSERT ... ON CONFLICT Abort

getRankingsForTeamT :: DbLeagueTeamId -> Tx.Transaction [PlayerRankingRow]
  ! WHERE league_team_id; ORDER BY rank_slot
  ! consumed by Pelotero.Draft (Phase D.1) for MakePick validation and AutoPick selection

clearRankingsT :: DbLeagueTeamId -> Tx.Transaction ()
  ! DELETE WHERE league_team_id

replaceRankingsT :: DbLeagueTeamId -> [PlayerRankingRow] -> Tx.Transaction ()
  ! clearRankingsT then mapM_ insertOneT
  ! atomic within the caller's transaction

getRankingCountT :: DbLeagueTeamId -> Tx.Transaction Int64
  ! COUNT(*) WHERE league_team_id

getRankingsForTeam :: Pool -> DbLeagueTeamId -> IO (Either DBError [PlayerRankingRow])
  ! Pool-flavored wrapper

replaceRankings :: Pool -> DbLeagueTeamId -> [PlayerRankingRow] -> IO (Either DBError ())
  ! Pool-flavored replace

clearRankings :: Pool -> DbLeagueTeamId -> IO (Either DBError ())
  ! Pool-flavored clear

getRankingCount :: Pool -> DbLeagueTeamId -> IO (Either DBError Int64)
  ! Pool-flavored count

%decision NoSurrogateIdNaturalKey
  what:    player_ranking has no surrogate id; (league_team_id, player_id) is the primary key
  why:     Unlike roster_slot/lineup_slot where the (team, player) pair has a 'context' (the slot string), a ranking pair carries only its rank_slot integer. Fewer columns, simpler schema.
  affects: playerRankingSchema, insertOneT

%decision AbortOnConflictForRankings
  what:    insertOneT uses Abort, not Upsert; replaceRankingsT works by clear-then-fill
  why:     Rankings are typically replaced wholesale rather than tweaked incrementally. Abort + clear-then-fill is conceptually simpler than upsert.
  affects: insertOneT, replaceRankingsT


=== BEGIN Pelotero/DB/Pool.hs ===

%file /home/bismuth/git/pelotero-engine/lib/Pelotero/DB/Pool.hs
%mod Pelotero.DB.Pool

%uses Control.Exception
%uses Data.Text
%uses qualified Data.Text as T
%uses qualified Hasql.Connection.Setting as ConnSetting
%uses qualified Hasql.Connection.Setting.Connection as ConnConnection
%uses qualified Hasql.Connection.Setting.Connection.Param as ConnParam
%uses Hasql.Pool
%uses qualified Hasql.Pool as Pool
%uses qualified Hasql.Pool.Config as PoolConfig
%uses Hasql.Session
%uses System.Environment
%uses Text.Read
%uses qualified Hasql.Transaction as Tx
%uses qualified Hasql.Transaction.Sessions as TxS

data DBConfig = DBConfig
  { dbHost           :: !Text
  , dbPort           :: !Int
  , dbName           :: !Text
  , dbUser           :: !Text
  , dbPassword       :: !Text
  , dbPoolSize       :: !Int
  , dbAcquireTimeout :: !Double  -- ^ seconds
  }
  deriving stock (Show, Eq)

data DBError
  = PoolUsageError !Text
  | MigrationError !Text
  deriving stock (Show)

instance Exception DBError

defaultDBConfig :: DBConfig
  ! host=localhost, port=5433, db=pelotero-engine, empty user/password, pool=10, timeout=10s
  ! matches Nix dev shell launch script defaults

loadDBConfig :: IO DBConfig
  ! intent: Read DB config from libpq-conventional env vars + two pelotero-specific tunables
  ! effects: IO (env reads)
  ! PGHOST/PGPORT/PGDATABASE/PGUSER/PGPASSWORD: standard libpq names
  ! PELOTERO_DB_POOL_SIZE / PELOTERO_DB_ACQUIRE_TIMEOUT: app-specific tunables
  ! missing or unparseable env vars fall back to defaultDBConfig field-by-field

poolConfig :: DBConfig -> PoolConfig.Config
  ! private; constructs PoolConfig.Config from a DBConfig
  ! uses staticConnectionSettings (single-host setup)

acquire :: DBConfig -> IO Pool
  ! non-blocking; returns immediately. Pool only opens connections lazily on first runSession.
  ! no validation that the database is reachable until first use

release :: Pool -> IO ()
  ! drains the pool; safe to call on a partially-used pool
  ! does NOT abort in-flight transactions; finishes them then closes connections

runSession :: Pool -> Session a -> IO (Either DBError a)
  ! single-statement (or multi-statement) Session execution
  ! wraps Pool.use; converts hasql-pool errors to DBError
  ! preserves the Right value type a as-is

runTransaction :: Pool -> Tx.Transaction a -> IO (Either DBError a)
  ! convenience wrapper: ReadCommitted, Write, single Transaction
  ! atomicity: write commits on success, rolls back on Tx error or thrown exception

renderDBError :: DBError -> Text
  ! converts to user-facing Text with a category prefix ('DB pool usage error: ', 'Migration error: ')
  ! exhaustive over the sum

%decision DefaultsAreLocalDevValues
  what:    defaultDBConfig points at localhost:5433 / pelotero-engine with empty user/password
  why:     These are values for the local Nix dev shell; they fail loudly if used in production. Production setups must set PG* env vars; sops-nix handles this in real deploys. An alternative was to require all values explicitly, but that breaks 'cabal run' in a dev shell where defaults are convenient.
  affects: defaultDBConfig, loadDBConfig

%decision DbErrorIsTypedSum
  what:    PoolUsageError and MigrationError are constructors of a pure Haskell DBError; consumers can pattern-match rather than re-parse a rendered string
  why:     Phase A.3 made DBError flow through the effect layer as a typed Error co-effect; callers in tests or in CLI commands that care about specific failure modes (pool exhaustion, migration drift) can match on the constructor. renderDBError is still the canonical user-facing rendering; the type is just no longer opaque-text-only. Adding a new error category remains a constructor + a renderDBError case.
  affects: renderDBError


=== BEGIN Pelotero/DB/Provider.hs ===

%file /home/bismuth/git/pelotero-engine/lib/Pelotero/DB/Provider.hs
%mod Pelotero.DB.Provider

%uses Data.Text

data ProviderName
  = -- | MLB Stats API. Today's primary source.
    ProviderMLB
  | -- | Internal records — minor-league call-ups we know about before MLB
    -- assigns an id, retired players we score in historical leagues, etc.
    ProviderInternal
  deriving stock (Show, Eq, Ord, Enum, Bounded)

renderProviderName :: ProviderName -> Text
  ! exhaustive over the sum; adding a constructor without a render case is a -Wincomplete-patterns error
  ! produces lowercase, hyphen-separated names matching the SQL convention

parseProviderName :: Text -> Maybe ProviderName
  ! returns Nothing for unknown names rather than failing
  ! case-sensitive: 'MLB' and 'mlb' are distinct, only the second matches

%decision TolerantParseStrictRender
  what:    parseProviderName returns Maybe rather than failing; renderProviderName is total over the closed sum
  why:     Reading: an unknown provider name in the database (e.g. an old row from a discontinued provider) shouldn't crash the whole query. Writing: the writer always uses the rendered constant from the sum, so writes are never typos. Adding a provider is a code change (new constructor + new parse case + new render case); no migration needed because the column is TEXT.
  affects: parseProviderName, renderProviderName

%decision WireFormatNamesAreStable
  what:    renderProviderName values ('mlb', 'pelotero-internal') are stable strings that can never change without a data migration
  why:     The text is stored in DB rows (player_external_id, team_external_id, game_external_id, provider_fetch_log). Renaming a constructor without renaming the rendered string would silently invalidate every row of that provider.
  affects: renderProviderName


=== BEGIN Pelotero/DB/Rel8Instances.hs ===

%file /home/bismuth/git/pelotero-engine/lib/Pelotero/DB/Rel8Instances.hs
%mod Pelotero.DB.Rel8Instances

%ext DerivingStrategies, DerivingVia, FlexibleInstances, GeneralizedNewtypeDeriving, MultiParamTypeClasses, StandaloneDeriving

%uses qualified Data.Text as T
%uses qualified Rel8 as R
%uses Pelotero.Domain.Id
%uses Pelotero.DB.Provider
%uses Pelotero.Domain.Roster
%uses Pelotero.Domain.Scoring

instance R.DBType ProviderName where

instance R.DBEq ProviderName

%decision OrphanInstancesAreDeliberate
  what:    DBType / DBEq / DBOrd instances for domain id types live here as orphans; the {-# OPTIONS_GHC -Wno-orphans #-} pragma is intentional
  why:     Putting them in Pelotero.Domain.Id forces the domain layer to depend on rel8, which is the wrong direction. Putting them in each Pelotero.DB.* table module produces orphan-conflict warnings as soon as two table modules reference the same domain type. This module is the lowest place that already imports both the domain types and rel8. Importers use the empty-import idiom: 'import Pelotero.DB.Rel8Instances ()'.
  affects: 

%decision JsonbInstancesMovedToWrapperModule
  what:    ToJSON / FromJSON instances for LeagueScoring / RosterLimits / LineupLimits / batting and pitching multipliers no longer live in Domain modules; they live on newtype wrappers in Pelotero.DB.JsonB
  why:     Phase A.4 moved them out of Domain. Domain types are now Aeson-free; the wrappers in Pelotero.DB.JsonB own the instances. This module's JSONBEncoded deriving via still works because it dispatches on the wrapper's instance, not the underlying Domain type's. Pelotero.DB.LeagueConfig now declares its JSONB columns at the wrapper type, making the encoded-as-JSON nature explicit at the schema level.
  affects: 

%decision ProviderNameTextEnumDb
  what:    ProviderName decodes via parseTypeInformation, with parseProviderName as the decoder; on unknown values it returns Left, which becomes a hasql query failure
  why:     Unlike Pelotero.DB.FetchLog.fromResult (which decodes to Maybe and filters), this DBType instance is strict. Tables that use ProviderName directly must only contain known providers, OR the table must decode to Text and convert in code. This asymmetry is per-table by design: external-id tables are write-controlled; the fetch log is append-only and historical.
  affects: 


=== BEGIN Pelotero/DB/RosterSlot.hs ===

%file /home/bismuth/git/pelotero-engine/lib/Pelotero/DB/RosterSlot.hs
%mod Pelotero.DB.RosterSlot

%ext DataKinds, DeriveAnyClass, DeriveGeneric, DerivingStrategies, DuplicateRecordFields, OverloadedStrings, StandaloneDeriving, TypeFamilies, TypeOperators, UndecidableInstances

%uses Data.Functor.Contravariant
%uses Data.Int
%uses Data.Text
%uses Data.Time
%uses GHC.Generics
%uses qualified Hasql.Transaction as Tx
%uses Rel8
%uses qualified Rel8 as R
%uses Pelotero.DB.Pool
%uses Pelotero.DB.Rel8Instances
%uses Pelotero.Domain.Id

data RosterSlotE f = RosterSlotE
  { _rsId           :: Column f Int64
  , _rsLeagueTeamId :: Column f DbLeagueTeamId
  , _rsSlot         :: Column f Text
  , _rsPlayerId     :: Column f DbPlayerId
  , _rsCreatedAt    :: Column f UTCTime
  }
  deriving stock    (Generic)
  deriving anyclass (Rel8able)

data RosterSlotRow = RosterSlotRow
  { rsLeagueTeamId :: !DbLeagueTeamId
  , rsSlot         :: !Text
  , rsPlayerId     :: !DbPlayerId
  }
  deriving stock (Show, Eq)

rosterSlotSchema :: TableSchema (RosterSlotE Name)
  ! table 'roster_slot' with surrogate id, FK to league_team, slot (Text), FK to player, order_index INTEGER NOT NULL DEFAULT 0, created_at
  ! natural unique key: (league_team_id, player_id)
  ! index roster_slot_order on (league_team_id, slot, order_index)

fromResult :: RosterSlotE Result -> RosterSlotRow
  ! private; drops the hidden surrogate id and created_at
  ! EXPOSES rsOrderIndex (post Phase B.2)

addSlotT :: RosterSlotRow -> Tx.Transaction ()
  ! INSERT ... ON CONFLICT (league_team_id, player_id) DO UPDATE SET slot, order_index
  ! if RosterSlotRow.rsOrderIndex is supplied, uses that; otherwise computes MAX(order_index) + 1 for the (league_team, slot) pair

getSlotsForTeamT :: DbLeagueTeamId -> Tx.Transaction [RosterSlotRow]
  ! WHERE league_team_id; ORDER BY slot, order_index, player_id

removeSlotT :: DbLeagueTeamId -> DbPlayerId -> Tx.Transaction ()
  ! DELETE WHERE league_team_id AND player_id

removePlayerFromTeamT :: DbLeagueTeamId -> DbPlayerId -> Tx.Transaction ()
  ! alias for removeSlotT

clearTeamRosterT :: DbLeagueTeamId -> Tx.Transaction ()
  ! DELETE WHERE league_team_id

replaceTeamRosterT :: DbLeagueTeamId -> [RosterSlotRow] -> Tx.Transaction ()
  ! transaction-internal sequence: clearTeamRosterT then mapM_ addSlotT
  ! entirely within the caller's transaction

countBySlotT :: DbLeagueTeamId -> Text -> Tx.Transaction Int64
  ! COUNT(*) WHERE league_team_id AND slot

getSlotsForTeam :: Pool -> DbLeagueTeamId -> IO (Either DBError [RosterSlotRow])
  ! Pool-flavored wrapper

addSlot :: Pool -> RosterSlotRow -> IO (Either DBError ())
  ! Pool-flavored upsert

removeSlot :: Pool -> DbLeagueTeamId -> DbPlayerId -> IO (Either DBError ())
  ! Pool-flavored single removal

removePlayerFromTeam :: Pool -> DbLeagueTeamId -> DbPlayerId -> IO (Either DBError ())
  ! Pool-flavored alias for removeSlot

clearTeamRoster :: Pool -> DbLeagueTeamId -> IO (Either DBError ())
  ! Pool-flavored full clear

replaceTeamRoster :: Pool -> DbLeagueTeamId -> [RosterSlotRow] -> IO (Either DBError ())
  ! Pool-flavored clear-then-fill

countBySlot :: Pool -> DbLeagueTeamId -> Text -> IO (Either DBError Int64)
  ! Pool-flavored count

%decision UpsertOnPlayerNotSlot
  what:    addSlotT does ON CONFLICT (league_team_id, player_id) DO UPDATE SET slot, NOT (league_team_id, slot)
  why:     The natural-feeling 'a slot can hold one player' is wrong for fantasy; multiple OF/UTIL slots per team is normal. The actual invariant is 'a player is in at most one slot per team'. Adding a player who's already on the roster moves them to the new slot rather than failing or duplicating.
  affects: addSlotT

%decision OrderIndexPersistsSlotPosition
  what:    roster_slot has an order_index INTEGER NOT NULL DEFAULT 0 column added by Phase B.2 migration V0030__order_index.sql
  why:     Previously the Seq-based domain ordering was thrown away on persistence; loading a roster lost slot-internal order. addSlotT either takes the order_index from the caller or computes MAX(order_index) + 1 within the slot. getSlotsForTeamT now sorts by (slot, order_index, player_id) so reads are stable. Today no consumer cares about the order; tomorrow when batting orders matter (lineup positioning, depth chart UI), the persistence is already there.
  affects: rosterSlotSchema, addSlotT, getSlotsForTeamT


