%file /home/bismuth/git/pelotero-engine/lib/Pelotero/DB/FetchLog.hs
%mod Pelotero.DB.FetchLog

%ext DataKinds, DeriveAnyClass, DeriveGeneric, DerivingStrategies, DuplicateRecordFields, OverloadedStrings, StandaloneDeriving, TypeFamilies, TypeOperators, UndecidableInstances

%uses Data.Functor.Contravariant
%uses Data.Int
%uses Data.Maybe
%uses Data.Text
%uses Data.Time
%uses GHC.Generics
%uses qualified Hasql.Transaction as Tx
%uses Rel8
%uses qualified Rel8 as R
%uses Pelotero.DB.Pool
%uses Pelotero.DB.Provider
%uses Pelotero.DB.Rel8Instances

data FetchLogE f = FetchLogE
  { _flId            :: Column f Int64
  , _flProvider      :: Column f Text
  , _flResource      :: Column f Text
  , _flScope         :: Column f Text
  , _flFetchedAt     :: Column f UTCTime
  , _flPayloadSha256 :: Column f Text
  , _flRecordCount   :: Column f Int32
  }
  deriving stock    (Generic)
  deriving anyclass (Rel8able)

data FetchLogRow = FetchLogRow
  { fetchLogId            :: !(Maybe Int64)
  , fetchLogProvider      :: !ProviderName
  , fetchLogResource      :: !Text
  , fetchLogScope         :: !Text
  , fetchLogFetchedAt     :: !(Maybe UTCTime)
  , fetchLogPayloadSha256 :: !Text
  , fetchLogRecordCount   :: !Int32
  }
  deriving stock (Show, Eq)

fetchLogSchema :: TableSchema (FetchLogE Name)
  ! table 'provider_fetch_log' with id (BIGSERIAL), provider (TEXT), resource, scope, fetched_at, payload_sha256, record_count (INTEGER)

fromResult :: FetchLogE Result -> Maybe FetchLogRow
  ! private; rel8 Result -> Maybe FetchLogRow
  ! Returns Nothing if _flProvider doesn't parse as a known ProviderName

recordFetchT :: FetchLogRow -> Tx.Transaction ()
  ! INSERT ... ON CONFLICT Abort; the fetch log is append-only

getLastFetchT
  :: ProviderName -> Text -> Text -> Tx.Transaction (Maybe FetchLogRow)
  ! ORDER BY fetched_at DESC, id DESC LIMIT 1; the id-DESC tiebreaker handles same-millisecond fetches
  ! consumed by Pelotero.Sync.Players.syncRosters and Pelotero.Sync.Schedule.syncSchedule for the idempotency check (Phase C.1)

getRecentFetchesT
  :: ProviderName -> Text -> Int32 -> Tx.Transaction [FetchLogRow]
  ! same ORDER BY pattern, LIMIT lim; returns up to `lim` parseable rows

recordFetch :: Pool -> FetchLogRow -> IO (Either DBError ())
  ! Pool-flavored wrapper

getLastFetch
  :: Pool -> ProviderName -> Text -> Text -> IO (Either DBError (Maybe FetchLogRow))
  ! Pool-flavored last-fetch lookup

getRecentFetches
  :: Pool -> ProviderName -> Text -> Int32 -> IO (Either DBError [FetchLogRow])
  ! Pool-flavored recent-fetches lookup

%decision ProviderColumnIsTextNotEnum
  what:    _flProvider is Column f Text, NOT Column f ProviderName
  why:     The fetch log is append-only and historical; a row written by a provider that no longer exists must remain readable. If we used the ProviderName DBType (which fails on unknown values), a single legacy row would crash every fetch-log query. fromResult does the parse and returns Nothing for unparseable rows; getLastFetchT and getRecentFetchesT use mapMaybe to drop them silently.
  affects: fetchLogSchema, fromResult, getLastFetchT, getRecentFetchesT

%decision RecordCountAsInt32
  what:    fetchLogRecordCount is Int32, not Int64 or Int
  why:     INTEGER (not BIGINT) in PostgreSQL; 2^31 ≈ 2 billion records per fetch is plenty. Using Int (machine-word) would silently widen on 64-bit platforms, then narrow at the wire boundary.
  affects: fetchLogSchema, recordFetchT


