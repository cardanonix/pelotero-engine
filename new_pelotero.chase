  ! Pool-flavored wrapper; inclusive on both ends

linkExternalId :: Pool -> DbGameId -> ProviderName -> Text -> IO (Either DBError ())
  ! Pool-flavored wrapper

lookupByExternalId :: Pool -> ProviderName -> Text -> IO (Either DBError (Maybe DbGameId))
  ! Pool-flavored wrapper

getExternalId :: Pool -> DbGameId -> ProviderName -> IO (Either DBError (Maybe Text))
  ! Pool-flavored wrapper

upsertByExternalId :: Pool -> ProviderName -> Text -> GameRow -> IO (Either DBError DbGameId)
  ! Pool-flavored wrapper

%decision GameDateAsDay
  what:    game.game_date stores Day (no time of day), not UTCTime
  why:     Fantasy scoring periods are defined by date in the league's local timezone; game start times within a day are irrelevant for whether the game counts. Storing as TIMESTAMPTZ would force every query to deal with timezone offset for what is fundamentally a calendar question.
  affects: gameSchema, getByDateT

%decision MirrorsTeamSchema
  what:    game and game_external_id mirror the shape of team and team_external_id
  why:     Same provider-keyed pattern as Player and Team. Phase A.5 collapsed the external-id boilerplate into Pelotero.DB.ProviderKeyed; this module is now a per-table schema + row + entity-specific reads (getByDateT, getByDateRangeT) plus a one-line ProviderKeyed instance and four facades.
  affects: 


