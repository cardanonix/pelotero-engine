%file /home/bismuth/git/pelotero-engine/lib/Pelotero/Domain/League.hs
%mod Pelotero.Domain.League

%uses Data.Text
%uses Data.Time
%uses Pelotero.Domain.Draft
%uses Pelotero.Domain.Id
%uses Pelotero.Domain.Roster
%uses Pelotero.Domain.Scoring

data LeagueStatus
  = LeagueDraft       -- ^ pre-draft / drafting
  | LeagueActive      -- ^ regular play
  | LeagueClosed      -- ^ scoring period ended
  deriving stock (Show, Eq, Ord, Enum, Bounded)

data League = League
  { leagueId           :: !LeagueId
  , leagueCommissioner :: !Text
  , leagueStatus       :: !LeagueStatus
  , leagueScoring      :: !LeagueScoring
  , leagueRosterLimits :: !RosterLimits
  , leagueLineupLimits :: !LineupLimits
  , leagueDraftParams  :: !DraftParameters
  , leagueScoringPeriod :: !ScoringPeriod
  , leagueTeams        :: ![FantasyTeamId]
  }
  deriving stock (Show, Eq)

data FantasyTeam = FantasyTeam
  { ftId      :: !FantasyTeamId
  , ftLeague  :: !LeagueId
  , ftName    :: !Text
  , ftOwner   :: !Text
  , ftRoster  :: !Roster
  , ftLineup  :: !Lineup
  }
  deriving stock (Show, Eq)

data ScoringPeriod = ScoringPeriod
  { spStart :: !UTCTime
  , spEnd   :: !UTCTime
  }
  deriving stock (Show, Eq)

data DraftParameters = DraftParameters
  { dpAutoDraft   :: !Bool
  , dpStrategy    :: !DraftOrderStrategy
  , dpAutoDraftAt :: !UTCTime
  }
  deriving stock (Show, Eq)

parseLeagueStatus :: Text -> Maybe LeagueStatus
  ! case-sensitive; accepts 'draft', 'active', 'closed'

renderLeagueStatus :: LeagueStatus -> Text
  ! exhaustive over the sum

%decision LeagueStatusOnlyMutableField
  what:    League's only field that changes after creation is leagueStatus; everything else is the immutable league definition
  why:     Scoring rules, roster limits, and draft params shouldn't change mid-season. Status moves through draft -> active -> closed in the lifecycle.
  affects: parseLeagueStatus, renderLeagueStatus

%decision ScoringPeriodAsUtcTime
  what:    ScoringPeriod uses UTCTime, not Day
  why:     Real leagues have lineup-lock cutoffs at specific game start times in specific timezones. Day would be ambiguous; UTCTime forces an explicit instant.
  affects: 


