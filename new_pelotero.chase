%mod Pelotero.Effects.Games

%ext TypeFamilies, DataKinds, TypeOperators, FlexibleContexts, GADTs, LambdaCase

%uses Data.IORef
%uses qualified Data.Map.Strict as Map
%uses Data.Text
%uses Data.Time.Calendar
%uses Effectful
%uses qualified Effectful as E
%uses Effectful.Dispatch.Dynamic
%uses Pelotero.DB.Game
%uses qualified Pelotero.DB.Game as GameRepo
%uses Pelotero.DB.Provider
%uses Pelotero.Domain.Id
%uses Pelotero.Effects.Database

data Games :: Effect where
  UpsertGameByExternalId :: ProviderName -> Text -> GameRow -> Games m DbGameId
  LookupGameByExternalId :: ProviderName -> Text -> Games m (Maybe DbGameId)
  GetGameExternalId      :: DbGameId -> ProviderName -> Games m (Maybe Text)
  GetGameById            :: DbGameId -> Games m (Maybe GameRow)
  GetGamesByDate         :: Day -> Games m [GameRow]
  GetGamesByDateRange    :: Day -> Day -> Games m [GameRow]

data GameStore = GameStore
  { gameExternalIdToDb :: !(Map.Map (ProviderName, Text) DbGameId)
  , gameDbToExternalId :: !(Map.Map (DbGameId, ProviderName) Text)
  , gameRowsByDb       :: !(Map.Map DbGameId GameRow)
  , gameNextId         :: !Int
  }

upsertGameByExternalId
  :: Games E.:> es => ProviderName -> Text -> GameRow -> E.Eff es DbGameId
  ! Games send-only

lookupGameByExternalId
  :: Games E.:> es => ProviderName -> Text -> E.Eff es (Maybe DbGameId)
  ! Games send-only

getGameExternalId
  :: Games E.:> es => DbGameId -> ProviderName -> E.Eff es (Maybe Text)
  ! Games send-only; reverse lookup

getGameById :: Games E.:> es => DbGameId -> E.Eff es (Maybe GameRow)
  ! Games send-only

getGamesByDate :: Games E.:> es => Day -> E.Eff es [GameRow]
  ! Games send-only; per-date listing

getGamesByDateRange :: Games E.:> es => Day -> Day -> E.Eff es [GameRow]
  ! Games send-only; range listing inclusive on both ends
  ! consumed by Pelotero.Score.buildPlayerMaps via the date-range queries (post Phase C.2)

runGamesDB
  :: Database E.:> es
  => E.Eff (Games : es) a
  -> E.Eff es a
  ! Database-backed interpreter; dispatches via ProviderKeyed
  ! requires Error DBError

emptyGameStore :: GameStore
  ! private; three empty Maps + nextId=1

runGamesInMemory
  :: IOE E.:> es
  => E.Eff (Games : es) a
  -> E.Eff es a
  ! IORef-based test interpreter

%decision GameStoreHasReverseLookupMap
  what:    The in-memory game store maintains both an external-id->db-id map AND a db-id->external-id map
  why:     GetGameExternalId requires reverse lookup; iterating the forward map with elem-on-value would be O(n) per call. Two maps cost twice the memory but make every lookup O(log n).
  affects: runGamesInMemory, emptyGameStore

%decision DispatchesViaProviderKeyed
  what:    runGamesDB dispatches external-id operations through the ProviderKeyed class members (Phase A.5)
  why:     Same rationale as Players and Teams.
  affects: runGamesDB


