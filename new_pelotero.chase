battingSchema :: TableSchema (BattingE Name)
  ! table 'game_player_batting' with FK to game, FK to player, FK to team (nullable), 25 stat columns (all Maybe Int32), created_at, updated_at
  ! natural PK: (game_id, player_id)

pitchingSchema :: TableSchema (PitchingE Name)
  ! table 'game_player_pitching' with FK to game, FK to player, FK to team (nullable), 40+ stat columns, innings_pitched_outs as Int32, created_at, updated_at
  ! natural PK: (game_id, player_id)

