%mod Pelotero.DB.DraftPick

%ext DataKinds, DeriveAnyClass, DeriveGeneric, DerivingStrategies, DuplicateRecordFields, OverloadedStrings, StandaloneDeriving, TypeFamilies, TypeOperators, UndecidableInstances

%uses Data.Functor.Contravariant
%uses Data.Int
%uses Data.Time
%uses GHC.Generics
%uses qualified Hasql.Transaction as Tx
%uses Rel8
%uses qualified Rel8 as R
%uses Pelotero.DB.Pool
%uses Pelotero.DB.Rel8Instances
%uses Pelotero.Domain.Id

data DraftPickE f = DraftPickE
  { _dpId             :: Column f DbDraftPickId
  , _dpLeagueConfigId :: Column f DbLeagueConfigId
  , _dpPickNumber     :: Column f Int32
  , _dpLeagueTeamId   :: Column f DbLeagueTeamId
  , _dpPlayerId       :: Column f DbPlayerId
  , _dpPickedAt       :: Column f UTCTime
  }
  deriving stock    (Generic)
  deriving anyclass (Rel8able)

data DraftPickRow = DraftPickRow
  { dpId             :: !(Maybe DbDraftPickId)
  , dpLeagueConfigId :: !DbLeagueConfigId
  , dpPickNumber     :: !Int32
  , dpLeagueTeamId   :: !DbLeagueTeamId
  , dpPlayerId       :: !DbPlayerId
  , dpPickedAt       :: !(Maybe UTCTime)
  }
  deriving stock (Show, Eq)

draftPickSchema :: TableSchema (DraftPickE Name)
  ! table 'draft_pick' with surrogate id, FK to league_config, pick_number (Int32 — 1-indexed), FK to league_team, FK to player, picked_at

fromResult :: DraftPickE Result -> DraftPickRow
  ! private; rel8 Result -> DraftPickRow

recordPickT :: DraftPickRow -> Tx.Transaction DbDraftPickId
  ! INSERT ... RETURNING id; Abort on conflict
  ! consumed by Pelotero.Draft.MakePick / AutoPick handlers

getPicksForLeagueT :: DbLeagueConfigId -> Tx.Transaction [DraftPickRow]
  ! WHERE league_config_id; ORDER BY pick_number
  ! consumed by Pelotero.Draft when resuming an in-progress draft

getPickCountT :: DbLeagueConfigId -> Tx.Transaction Int64
  ! COUNT(*) WHERE league_config_id
  ! used to figure out 'whose pick is next?' as count + 1

recordPick :: Pool -> DraftPickRow -> IO (Either DBError DbDraftPickId)
  ! Pool-flavored insert

getPicksForLeague :: Pool -> DbLeagueConfigId -> IO (Either DBError [DraftPickRow])
  ! Pool-flavored full-league pick listing

getPickCount :: Pool -> DbLeagueConfigId -> IO (Either DBError Int64)
  ! Pool-flavored count

%decision AppendOnlyDraftPicks
  what:    Only insert (recordPick) and read (getPicksForLeague, getPickCount) operations exist; no update or delete
  why:     Picks are historical events; once made, they don't get edited or undone. If a wrong pick needs correction, the convention is to insert a new pick at the next pick_number rather than mutating the prior row. Audit trail integrity: a query at any point in time gives the actual sequence of picks made. Pelotero.Draft state machine writes here on every PickRecorded event; reads support resuming an interrupted draft.
  affects: recordPickT


