%mod Pelotero.Effects.Teams

%ext TypeFamilies, DataKinds, TypeOperators, FlexibleContexts, GADTs, LambdaCase

%uses Data.IORef
%uses qualified Data.Map.Strict as Map
%uses Data.Text
%uses Effectful
%uses qualified Effectful as E
%uses Effectful.Dispatch.Dynamic
