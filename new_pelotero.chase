%mod Pelotero.DB.Team

%ext DataKinds, DeriveAnyClass, DeriveGeneric, DerivingStrategies, DuplicateRecordFields, OverloadedStrings, RecordWildCards, StandaloneDeriving, TypeApplications, TypeFamilies, TypeOperators, UndecidableInstances

%uses Data.Functor.Contravariant
%uses Data.Text
%uses Data.Time
%uses GHC.Generics
%uses qualified Hasql.Transaction as Tx
%uses Rel8 hiding
%uses Pelotero.DB.Pool
%uses qualified Pelotero.DB.ProviderKeyed as PK
%uses Pelotero.DB.ProviderKeyed
%uses Pelotero.DB.Provider
%uses Pelotero.DB.Rel8Instances
%uses Pelotero.Domain.Id

data Team f = Team
  { _teamId                 :: Column f DbTeamId
  , _teamName               :: Column f Text
  , _teamAbbreviation       :: Column f Text
  , _teamLocationName       :: Column f Text
  , _teamLastSyncedProvider :: Column f (Maybe ProviderName)
  , _teamLastSyncedAt       :: Column f (Maybe UTCTime)
  }
  deriving stock    (Generic)
  deriving anyclass (Rel8able)

data TeamRow = TeamRow
  { teamRowId                 :: !(Maybe DbTeamId)
  , teamRowName               :: !Text
  , teamRowAbbreviation       :: !Text
  , teamRowLocationName       :: !Text
  , teamRowLastSyncedProvider :: !(Maybe ProviderName)
  , teamRowLastSyncedAt       :: !(Maybe UTCTime)
  }
  deriving stock (Show, Eq)

instance ProviderKeyed TeamRow where

teamSchema :: TableSchema (Team Name)
  ! table 'team' with surrogate id, name, abbreviation, location_name (city), and last-synced metadata
  ! no FK out — teams are leaves in the FK graph

teamExternalIdSchema :: TableSchema (ExternalIdE DbTeamId Name)
  ! same shape as player_external_id: (team_id, provider, external_id, fetched_at)

fromResult :: Team Result -> TeamRow
  ! private; rel8 Result -> public TeamRow

teamRowToExpr :: TeamRow -> Team Expr

insertTeamT :: TeamRow -> Tx.Transaction DbTeamId
  ! INSERT ... RETURNING id; Abort on conflict

updateTeamT :: DbTeamId -> TeamRow -> Tx.Transaction ()
  ! WHERE id = tid; updates everything except id

getByIdT :: DbTeamId -> Tx.Transaction (Maybe TeamRow)
  ! single-row select via WHERE id

getAllT :: Tx.Transaction [TeamRow]
  ! ORDER BY name; no pagination; 30 MLB teams

linkExternalIdT :: DbTeamId -> ProviderName -> Text -> Tx.Transaction ()
  ! INSERT ... ON CONFLICT DO NOTHING into team_external_id

lookupByExternalIdT :: ProviderName -> Text -> Tx.Transaction (Maybe DbTeamId)
  ! SELECT team_id WHERE provider AND external_id

getExternalIdT :: DbTeamId -> ProviderName -> Tx.Transaction (Maybe Text)
  ! reverse lookup; (DbTeamId, ProviderName) -> Maybe Text

upsertByExternalIdT :: ProviderName -> Text -> TeamRow -> Tx.Transaction DbTeamId
  ! lookup-then-update or insert-and-link

insertTeam :: Pool -> TeamRow -> IO (Either DBError DbTeamId)
  ! Pool-flavored wrapper

updateTeam :: Pool -> DbTeamId -> TeamRow -> IO (Either DBError ())
  ! Pool-flavored wrapper

getById :: Pool -> DbTeamId -> IO (Either DBError (Maybe TeamRow))
  ! Pool-flavored single-team read

getAll :: Pool -> IO (Either DBError [TeamRow])
  ! Pool-flavored full table read

linkExternalId :: Pool -> DbTeamId -> ProviderName -> Text -> IO (Either DBError ())
  ! Pool-flavored wrapper

lookupByExternalId :: Pool -> ProviderName -> Text -> IO (Either DBError (Maybe DbTeamId))
  ! Pool-flavored wrapper

getExternalId :: Pool -> DbTeamId -> ProviderName -> IO (Either DBError (Maybe Text))
  ! Pool-flavored wrapper

upsertByExternalId :: Pool -> ProviderName -> Text -> TeamRow -> IO (Either DBError DbTeamId)
  ! Pool-flavored wrapper

%decision MirrorsPlayerSchema
  what:    team and team_external_id mirror the shape of player and player_external_id
  why:     Same provider-keyed pattern as Player. Phase A.5 collapsed the four external-id helpers (link / lookup / getExternalId / upsert, plus their Pool wrappers) into Pelotero.DB.ProviderKeyed; this module retains the per-table schema, row, and reads, plus a one-line ProviderKeyed instance and facades.
  affects: 


=== BEGIN Pelotero/Domain/Draft.hs ===

%file /home/bismuth/git/pelotero-engine/lib/Pelotero/Domain/Draft.hs
%mod Pelotero.Domain.Draft

%uses Data.Text
%uses Data.Time.Clock
%uses Pelotero.Domain.Id

data DraftOrderStrategy
  = -- | Snake/serpentine: round 1 forward, round 2 reverse, round 3 forward...
    SerpentineOrder
  | -- | Forward, mid-shifted, reverse, mid-shifted-reverse, repeating.
    -- (The legacy code's "experimental_snake".)
    ExperimentalSnakeOrder
  deriving stock (Show, Eq, Ord, Enum, Bounded)

data DraftPick = DraftPick
  { pickNumber :: !DraftPickNumber
  , pickTeam   :: !FantasyTeamId
  , pickPlayer :: !PlayerId
  , pickedAt   :: !UTCTime
  }
  deriving stock (Show, Eq)

data Ranking = Ranking
  { rankingTeam       :: !FantasyTeamId
  , rankingChecksum   :: !Text
  , rankingUpdatedAt  :: !UTCTime
  , rankingEntries    :: ![PlayerRanking]
  }
  deriving stock (Show, Eq)

data PlayerRanking = PlayerRanking
  { prPlayer :: !PlayerId
  , prRank   :: !RankSlot
  }
  deriving stock (Show, Eq)

parseDraftOrderStrategy :: Text -> Maybe DraftOrderStrategy
  ! case-sensitive; accepts 'serpentine' or 'experimental_snake'

renderDraftOrderStrategy :: DraftOrderStrategy -> Text
  ! exhaustive over the sum

generateDraftOrder
  :: DraftOrderStrategy
  -> Int                       -- ^ total picks across the entire draft
  -> [FantasyTeamId]           -- ^ teams in initial order
  -> [(FantasyTeamId, DraftPickNumber)]
  ! intent: Produce the full pick-by-pick order as (team, pickNumber)
  ! empty teams returns []
  ! rounds = totalPicks `div` length teams; trailing partial round is truncated
  ! pick numbers are 1-indexed
  ! pure: no randomness, no IO

serpentine :: Int -> [a] -> [a]
  ! private; rounds copies of [teams, reverse teams] alternating

experimentalSnake :: Int -> [a] -> [a]
  ! private; rounds copies of [teams, mid-shifted, reverse, mid-shifted-reverse] alternating
  ! reproduces the legacy 'experimental_snake' algorithm

rankingPlayerIds :: Ranking -> [PlayerId]
  ! extracts just the PlayerIds from a Ranking, in rank order
  ! assumes Ranking.rankingEntries was constructed in rank order — does NOT sort

extendRankingsWithUnranked
  :: [PlayerId]   -- ^ ranked, in rank order
  -> [PlayerId]   -- ^ universe of all draftable players
  -> [PlayerId]
  ! appends unranked players to the end of ranked, preserving universe order
  ! intended consumer is the planned Pelotero.Draft AutoPick handler when a team's ranking is shorter than the player pool; no consumer in tree today

%decision PureOrderGenerator
  what:    generateDraftOrder is pure (no IO, no Random); randomness is supplied by the caller as the order of the input team list
  why:     Pure functions are testable without any randomness effect. If the caller wants random ordering (a coin flip for first pick), they shuffle the team list outside this module and pass it in. Keeps this module free of effects.
  affects: generateDraftOrder, serpentine, experimentalSnake

%decision TruncateTrailingPartialRound
  what:    If totalPicks is not a multiple of length teams, the trailing partial round is dropped, NOT half-completed
  why:     A draft with N teams should always have a multiple-of-N pick count. Half-completing a round would create asymmetry; truncating preserves the 'teams are equal' invariant.
  affects: generateDraftOrder

%decision PureModuleByDesign
  what:    This module stays pure; no effectful state machine lives here today, and a future Pelotero.Draft (planned D.1 work) will be the home of the live draft state machine when it lands
  why:     generateDraftOrder is pre-computation pure logic. Running an actual draft requires database writes per pick, which means the live state machine has to live in a module with effect access. Splitting the modules keeps Pelotero.Domain.Draft testable without effects; Pelotero.Draft (when implemented) will be testable via the in-memory effect interpreters.
  affects: 


