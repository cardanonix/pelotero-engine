%file /home/bismuth/git/pelotero-engine/lib/Pelotero/DB/JsonB.hs
%mod Pelotero.DB.JsonB

%ext DerivingStrategies, DerivingVia, OverloadedStrings, RecordWildCards, StandaloneDeriving

%uses Data.Aeson
%uses qualified Data.Aeson.Types as Aeson
%uses Data.Map.Strict
%uses qualified Data.Map.Strict as Map
%uses Data.Text
%uses qualified Data.Text as T
%uses qualified Rel8 as R
%uses Pelotero.Domain.Roster
%uses Pelotero.Domain.Scoring

newtype JsonbScoring = JsonbScoring { unJsonbScoring :: LeagueScoring }
  deriving stock (Show, Eq)

newtype JsonbBattingMultipliers
  = JsonbBattingMultipliers BattingMultipliers

newtype JsonbPitchingMultipliers
  = JsonbPitchingMultipliers PitchingMultipliers

instance ToJSON JsonbBattingMultipliers where

instance FromJSON JsonbBattingMultipliers where

instance ToJSON JsonbPitchingMultipliers where

instance FromJSON JsonbPitchingMultipliers where

instance ToJSON JsonbScoring where

instance FromJSON JsonbScoring where

newtype JsonbRosterLimits = JsonbRosterLimits { unJsonbRosterLimits :: RosterLimits }
  deriving stock (Show, Eq)

newtype JsonbLineupLimits = JsonbLineupLimits { unJsonbLineupLimits :: LineupLimits }
  deriving stock (Show, Eq)

instance ToJSON JsonbRosterLimits where

instance FromJSON JsonbRosterLimits where

instance ToJSON JsonbLineupLimits where

instance FromJSON JsonbLineupLimits where

%decision WrappersOnlyAtTheDbBoundary
  what:    JSONB-going Domain types (LeagueScoring, RosterLimits, LineupLimits) are wrapped by newtypes (JsonbScoring, JsonbRosterLimits, JsonbLineupLimits) only at the rel8 Column boundary; the public LeagueConfigRow API still carries the unwrapped Domain types
  why:     Phase A.4 made Domain Aeson-free by moving every ToJSON / FromJSON instance off Domain.Scoring and Domain.Roster onto wrappers in this module. Wrapping at the rel8 Column boundary localises the bridge to the persistence layer; callers who already hold a LeagueScoring keep getting one back from getById and friends, with the wrap/unwrap living entirely inside Pelotero.DB.LeagueConfig. Wire format is byte-equivalent to the pre-A.4 instances (same field names, same key order, same Map-keyed encoding for limits), so existing JSONB rows round-trip without a data migration.
  affects: 

%decision InternalSubrecordWrappers
  what:    JsonbBattingMultipliers and JsonbPitchingMultipliers are private to this module and used only inside JsonbScoring's ToJSON / FromJSON
  why:     Each sub-record gets its own field-by-field encoding, mirroring the original split per type at the Domain layer. Keeps the LeagueScoring wrapper instance short and locally readable — the inner records' encoding lives next to the inner records' wrappers. Not exported because nothing outside JsonB needs to talk about the multipliers in JSONB form independently.
  affects: 


