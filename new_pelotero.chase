emptyTeamStore :: TeamStore
  ! private; TeamStore Map.empty Map.empty 1

runTeamsInMemory
  :: IOE E.:> es
  => E.Eff (Teams : es) a
  -> E.Eff es a
  ! IORef-based test interpreter

%decision MirrorsPlayersInMemoryShape
  what:    TeamStore has the same external-id-map + db-rows-map + nextId-counter shape as PlayerStore
  why:     Same trade-offs as Players: per-runner counter mimicking BIGSERIAL, no FK enforcement. Code duplication is acceptable at two test interpreters.
