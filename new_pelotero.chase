%file /home/bismuth/git/pelotero-engine/lib/Pelotero/Effects/RosterSlot.hs
%mod Pelotero.Effects.RosterSlot

%ext TypeFamilies, DataKinds, TypeOperators, FlexibleContexts, GADTs, LambdaCase

%uses Data.Int
%uses Data.Text
%uses Effectful
%uses qualified Effectful as E
%uses Effectful.Dispatch.Dynamic
