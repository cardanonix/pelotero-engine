%file /home/bismuth/git/pelotero-engine/lib/Pelotero/Effects/FetchLog.hs
%mod Pelotero.Effects.FetchLog

%ext TypeFamilies, DataKinds, TypeOperators, FlexibleContexts, LambdaCase, GADTs

%uses Data.IORef
%uses Data.Text
%uses Effectful
%uses qualified Effectful as E
%uses Effectful.Dispatch.Dynamic
%uses Pelotero.DB.FetchLog
%uses qualified Pelotero.DB.FetchLog as FetchLogRepo
%uses Pelotero.DB.Provider
%uses Pelotero.Effects.Database

data FetchLog :: Effect where
  RecordFetch  :: FetchLogRow -> FetchLog m ()
  GetLastFetch :: ProviderName -> Text -> Text -> FetchLog m (Maybe FetchLogRow)

recordFetch :: FetchLog E.:> es => FetchLogRow -> E.Eff es ()
  ! FetchLog send-only; records a new fetch row

getLastFetch
  :: FetchLog E.:> es
  => ProviderName
  -> Text
  -> Text
  -> E.Eff es (Maybe FetchLogRow)
  ! FetchLog send-only; given (provider, resource, scope), returns the most recent fetch or Nothing
  ! consumed by Pelotero.Sync.Players.syncRosters and Pelotero.Sync.Schedule.syncSchedule for the Phase C.1 idempotency check

runFetchLogDB
  :: Database E.:> es
  => E.Eff (FetchLog : es) a
  -> E.Eff es a
  ! Database-backed interpreter; delegates to Pelotero.DB.FetchLog
  ! now requires Error DBError in the effect stack (post Phase A.3)

runFetchLogInMemory
  :: IOE E.:> es
  => E.Eff (FetchLog : es) a
  -> E.Eff es a
  ! IO-backed test interpreter using an IORef [FetchLogRow]

%decision InMemoryFetchLogIsList
  what:    runFetchLogInMemory uses an IORef [FetchLogRow] (cons-prepended), not a Map
  why:     Tests typically write a few rows and read the most recent; a list is fine. Cons-prepending makes 'most recent first' free.
  affects: runFetchLogInMemory


