  , dpPickedAt       :: !(Maybe UTCTime)
  }
  deriving stock (Show, Eq)

draftPickSchema :: TableSchema (DraftPickE Name)
  ! table 'draft_pick' with surrogate id, FK to league_config, pick_number (Int32 — 1-indexed), FK to league_team, FK to player, picked_at

fromResult :: DraftPickE Result -> DraftPickRow
  ! private; rel8 Result -> DraftPickRow

recordPickT :: DraftPickRow -> Tx.Transaction DbDraftPickId
  ! INSERT ... RETURNING id; Abort on conflict
  ! intended consumer is the planned Pelotero.Draft state machine (D.1); no consumer in tree today

getPicksForLeagueT :: DbLeagueConfigId -> Tx.Transaction [DraftPickRow]
  ! WHERE league_config_id; ORDER BY pick_number

getPickCountT :: DbLeagueConfigId -> Tx.Transaction Int64
  ! COUNT(*) WHERE league_config_id
  ! used to figure out 'whose pick is next?' as count + 1

recordPick :: Pool -> DraftPickRow -> IO (Either DBError DbDraftPickId)
  ! Pool-flavored insert

getPicksForLeague :: Pool -> DbLeagueConfigId -> IO (Either DBError [DraftPickRow])
  ! Pool-flavored full-league pick listing

getPickCount :: Pool -> DbLeagueConfigId -> IO (Either DBError Int64)
  ! Pool-flavored count

%decision AppendOnlyDraftPicks
  what:    Only insert (recordPick) and read (getPicksForLeague, getPickCount) operations exist; no update or delete
  why:     Picks are historical events; once made, they don't get edited or undone. If a wrong pick needs correction, the convention is to insert a new pick at the next pick_number rather than mutating the prior row. Audit trail integrity: a query at any point in time gives the actual sequence of picks made.
  affects: recordPickT


