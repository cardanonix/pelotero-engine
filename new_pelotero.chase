%uses GHC.Generics
%uses qualified Hasql.Transaction as Tx
%uses Rel8
%uses qualified Rel8 as R
%uses Pelotero.DB.Pool
%uses Pelotero.DB.Rel8Instances
%uses Pelotero.Domain.Id
%uses Pelotero.Domain.Roster
%uses Pelotero.Domain.Scoring

data LeagueConfig f = LeagueConfig
  { _lcId            :: Column f DbLeagueConfigId
  , _lcLeagueId      :: Column f Text
  , _lcCommissioner  :: Column f Text
  , _lcStatus        :: Column f Text
  , _lcScoring       :: Column f LeagueScoring
  , _lcRosterLimits  :: Column f RosterLimits
  , _lcLineupLimits  :: Column f LineupLimits
  , _lcDraftAuto     :: Column f Bool
  , _lcDraftStrategy :: Column f Text
  , _lcDraftAutoAt   :: Column f (Maybe UTCTime)
  , _lcScoringStart  :: Column f UTCTime
  , _lcScoringEnd    :: Column f UTCTime
  }
  deriving stock    (Generic)
  deriving anyclass (Rel8able)

data LeagueConfigRow = LeagueConfigRow
  { lcId            :: !(Maybe DbLeagueConfigId)
  , lcLeagueId      :: !Text
  , lcCommissioner  :: !Text
  , lcStatus        :: !Text
  , lcScoring       :: !LeagueScoring
  , lcRosterLimits  :: !RosterLimits
  , lcLineupLimits  :: !LineupLimits
  , lcDraftAuto     :: !Bool
  , lcDraftStrategy :: !Text
  , lcDraftAutoAt   :: !(Maybe UTCTime)
  , lcScoringStart  :: !UTCTime
  , lcScoringEnd    :: !UTCTime
  }
  deriving stock (Show, Eq)

leagueConfigSchema :: TableSchema (LeagueConfig Name)
  ! table 'league_config' with surrogate id, league_id (Text), commissioner, status, JSONB scoring/roster/lineup (declared at wrapper types), draft params, scoring period bounds

fromResult :: LeagueConfig Result -> LeagueConfigRow
  ! private; rel8 Result -> public LeagueConfigRow
  ! unwraps JsonbScoring / JsonbRosterLimits / JsonbLineupLimits into their underlying Domain types so callers don't see the wrappers

insertLeagueConfigT :: LeagueConfigRow -> Tx.Transaction DbLeagueConfigId
  ! INSERT ... RETURNING id; Abort on conflict
  ! JSONB columns serialize via the wrapper types' DBType instances

updateLeagueConfigT :: DbLeagueConfigId -> LeagueConfigRow -> Tx.Transaction ()
  ! WHERE id = lcid; updates everything except id

getByIdT :: DbLeagueConfigId -> Tx.Transaction (Maybe LeagueConfigRow)
  ! single-row select via WHERE id

getByLeagueIdT :: Text -> Tx.Transaction (Maybe LeagueConfigRow)
  ! WHERE league_id = ?; the user-facing identifier

getAllT :: Tx.Transaction [LeagueConfigRow]
  ! ORDER BY league_id; full table

insertLeagueConfig :: Pool -> LeagueConfigRow -> IO (Either DBError DbLeagueConfigId)
  ! Pool-flavored wrapper

updateLeagueConfig :: Pool -> DbLeagueConfigId -> LeagueConfigRow -> IO (Either DBError ())
  ! Pool-flavored wrapper

getById :: Pool -> DbLeagueConfigId -> IO (Either DBError (Maybe LeagueConfigRow))
  ! Pool-flavored single-row read

getByLeagueId :: Pool -> Text -> IO (Either DBError (Maybe LeagueConfigRow))
  ! Pool-flavored user-id read

getAll :: Pool -> IO (Either DBError [LeagueConfigRow])
  ! Pool-flavored full read

%decision ScoringAndLimitsAsJsonbColumnsViaWrappers
  what:    scoring_config (JsonbScoring), roster_limits (JsonbRosterLimits), lineup_limits (JsonbLineupLimits) are JSONB columns declared at the wrapper type from Pelotero.DB.JsonB
  why:     Phase A.4 introduced the wrapper newtypes. The Column f declarations now use the wrapper types directly, making the JSON-encoded nature of those columns explicit at the schema level. Domain types stay Aeson-free; only this module sees the wrappers, and only at row-construction / row-reading time. fromResult unwraps; the public LeagueConfigRow exposes the underlying Domain types so consumers don't see the wrapper at all. Cost: a schema change to the inner records still requires a JSONB data migration on every existing row, but that was true before.
  affects: leagueConfigSchema, fromResult

%decision StatusAsTextNotEnum
  what:    _lcStatus is Column f Text, not the LeagueStatus domain sum
  why:     Same rationale as ProviderName for the fetch log: tolerate legacy or unrecognised values without crashing reads. However, the layered domain type LeagueStatus exists as the canonical render/parse pair; this column being Text is the persistence-layer trade-off.
  affects: leagueConfigSchema


