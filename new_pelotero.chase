  ! private; rel8 BattingE Result -> BattingRow; drops created_at and updated_at

fromPitchingResult :: PitchingE Result -> PitchingRow
  ! private; rel8 PitchingE Result -> PitchingRow; drops created_at and updated_at

battingRowToExpr :: BattingRow -> BattingE Expr
  ! private; BattingRow -> BattingE Expr for use in INSERT VALUES clause
  ! created_at and updated_at are unsafeDefault — DB sets them on insert

pitchingRowToExpr :: PitchingRow -> PitchingE Expr
  ! private; mirror of battingRowToExpr

upsertBattingT :: BattingRow -> Tx.Transaction ()
  ! INSERT ... ON CONFLICT (game_id, player_id) DO UPDATE
  ! set: keeps id-like columns from old, takes stats from new, preserves created_at, sets updated_at = NOW()
  ! updateWhere = lit True (always update on conflict)

getBattingForGameT :: DbGameId -> Tx.Transaction [BattingRow]
  ! WHERE game_id; ORDER BY player_id
  ! consumed by Pelotero.Score.buildPlayerMaps (one call per game id in the period)

getBattingForDateRangeT :: Day -> Day -> Tx.Transaction [BattingRow]

deleteBattingForGameT :: DbGameId -> Tx.Transaction ()
  ! DELETE WHERE game_id
  ! useful when re-ingesting a corrected boxscore

upsertPitchingT :: PitchingRow -> Tx.Transaction ()
  ! mirror of upsertBattingT for pitching

getPitchingForGameT :: DbGameId -> Tx.Transaction [PitchingRow]
  ! WHERE game_id; ORDER BY player_id
  ! consumed by Pelotero.Score.buildPlayerMaps

getPitchingForDateRangeT :: Day -> Day -> Tx.Transaction [PitchingRow]

deletePitchingForGameT :: DbGameId -> Tx.Transaction ()
  ! DELETE WHERE game_id

upsertBatting :: Pool -> BattingRow -> IO (Either DBError ())
  ! Pool-flavored wrapper

upsertPitching :: Pool -> PitchingRow -> IO (Either DBError ())
  ! Pool-flavored wrapper

getBattingForGame :: Pool -> DbGameId -> IO (Either DBError [BattingRow])
  ! Pool-flavored read

getPitchingForGame :: Pool -> DbGameId -> IO (Either DBError [PitchingRow])
  ! Pool-flavored read

getBattingForDateRange :: Pool -> Day -> Day -> IO (Either DBError [BattingRow])

getPitchingForDateRange :: Pool -> Day -> Day -> IO (Either DBError [PitchingRow])

deleteBattingForGame :: Pool -> DbGameId -> IO (Either DBError ())
  ! Pool-flavored delete

deletePitchingForGame :: Pool -> DbGameId -> IO (Either DBError ())
  ! Pool-flavored delete

%decision TwoTablesNotOne
  what:    Batting and pitching are separate tables (game_player_batting and game_player_pitching), not one wide table
  why:     Batting has ~25 stat columns, pitching has ~40. Combining gives a 65-column row that's mostly NULL for any given player. Querying 'all batting lines this week' becomes a clean SELECT from one table without WHERE filtering on column NULLness. A two-way player gets two rows, one per table — correct because both stat lines are independently meaningful.
  affects: battingSchema, pitchingSchema

%decision InningsPitchedAsOuts
  what:    The pitching table stores INTEGER outs, NOT the wire string '6.2'
  why:     Storing as outs makes SUM, AVG, and arithmetic exact; a decimal column would lose precision. Conversion happens at convert time in Pelotero.MLB.Convert.convertPitching (Phase B.1); readers always see exact integer outs. Domain.Stats.PitchingStats now also has only pitOuts (Phase B.1 dropped pitInningsPitched), so the DB row, the domain row, and the scoring path all agree.
  affects: pitchingSchema, upsertPitchingT

%decision UpdatedAtFromSqlNow
  what:    Upsert sets updated_at = RT.now (a SQL-side NOW()), preserving created_at from the existing row
  why:     RT.now is rel8's Expr-level NOW() — runs at DB transaction time, not at Haskell wall-clock time. Taking the timestamp client-side would risk skew between client and DB clocks.
  affects: upsertBattingT, upsertPitchingT


