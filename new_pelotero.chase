%file /home/bismuth/git/pelotero-engine/lib/Pelotero/Effects/DraftPick.hs
%mod Pelotero.Effects.DraftPick

%ext TypeFamilies, DataKinds, TypeOperators, FlexibleContexts, GADTs, LambdaCase

%uses Data.Int
%uses Effectful
%uses qualified Effectful as E
%uses Effectful.Dispatch.Dynamic
%uses qualified Pelotero.DB.DraftPick as DPRepo
%uses Pelotero.DB.DraftPick
%uses Pelotero.Domain.Id
%uses Pelotero.Effects.Database

data DraftPick :: Effect where
  RecordPick        :: DraftPickRow      -> DraftPick m DbDraftPickId
  GetPicksForLeague :: DbLeagueConfigId  -> DraftPick m [DraftPickRow]
  GetPickCount      :: DbLeagueConfigId  -> DraftPick m Int64

recordPick :: DraftPick E.:> es => DraftPickRow -> E.Eff es DbDraftPickId
  ! DraftPick send-only
  ! intended consumer is the planned Pelotero.Draft state machine (D.1); no consumer in tree today

getPicksForLeague
  :: DraftPick E.:> es
  => DbLeagueConfigId -> E.Eff es [DraftPickRow]
  ! DraftPick send-only

getPickCount
  :: DraftPick E.:> es
  => DbLeagueConfigId -> E.Eff es Int64
  ! DraftPick send-only

runDraftPickDB
  :: Database E.:> es
  => E.Eff (DraftPick : es) a
  -> E.Eff es a
  ! Database-backed interpreter; requires Error DBError
  ! no in-memory interpreter — draft picks are append-only and the in-memory equivalent would be a list


