%file /home/bismuth/git/pelotero-engine/lib/Pelotero/Domain/Player.hs
%mod Pelotero.Domain.Player

%ext LambdaCase, OverloadedStrings

%uses Data.Text
%uses Pelotero.Domain.Id
%uses Pelotero.Domain.Position

data Player = Player
  { playerId        :: !PlayerId
  , playerFirstName :: !Text       -- ^ MLB's "useName"
  , playerLastName  :: !Text       -- ^ MLB's "useLastName"
  , playerNameSlug  :: !Text       -- ^ URL-safe identifier
  , playerTeamId    :: !(Maybe TeamId)
  , playerPosition  :: !(Maybe Position)
  , playerBatSide   :: !(Maybe Handedness)
  , playerPitchHand :: !(Maybe Handedness)
  , playerActive    :: !Bool
  }
  deriving stock (Show, Eq)

data Handedness
  = LeftHanded
  | RightHanded
  | Switch
  deriving stock (Show, Eq, Ord, Enum, Bounded)

parseHandedness :: Text -> Maybe Handedness
  ! accepts only 'L', 'R', 'S' (case-sensitive)
  ! consumed by Pelotero.MLB.Convert.convertHand

renderHandedness :: Handedness -> Text
  ! exhaustive: LeftHanded -> 'L', RightHanded -> 'R', Switch -> 'S'
  ! kept for symmetry with parseHandedness; sync code now uses handChar instead

handChar :: Handedness -> Char
  ! exhaustive case-of: LeftHanded -> 'L', RightHanded -> 'R', Switch -> 'S'
  ! total; consumed by Pelotero.Sync.Players.upsertAllPlayers (replacing T.head . renderHandedness)

%decision TotalHandChar
  what:    handChar :: Handedness -> Char is exhaustive case-of, total at the type level
  why:     Phase A.6 introduced this to replace the partial T.head . renderHandedness path. Adding a new Handedness constructor is a -Wincomplete-patterns error here; the previous design (T.head over a Text) deferred totality to the renderHandedness exhaustivity, with a hidden coupling that wasn't enforced by anything visible at the call site. The DB column for bat_side / pitch_hand remains Text (PostgreSQL CHAR(1) padding gotchas), but the API is now total Char end-to-end.
  affects: handChar


=== BEGIN Pelotero/Domain/Position.hs ===

%file /home/bismuth/git/pelotero-engine/lib/Pelotero/Domain/Position.hs
%mod Pelotero.Domain.Position

%uses Data.Text

data Position
  = Pitcher        -- ^ MLB code "1"  / scorer "P"
  | Catcher        -- ^ MLB code "2"  / scorer "C"
  | FirstBase      -- ^ MLB code "3"  / scorer "1B"
  | SecondBase     -- ^ MLB code "4"  / scorer "2B"
  | ThirdBase      -- ^ MLB code "5"  / scorer "3B"
  | Shortstop      -- ^ MLB code "6"  / scorer "SS"
  | LeftField      -- ^ MLB code "7"  / scorer "LF"
  | CenterField    -- ^ MLB code "8"  / scorer "CF"
  | RightField     -- ^ MLB code "9"  / scorer "RF"
  | DesignatedHitter -- ^ MLB code "10" / scorer "DH"
  deriving stock (Show, Eq, Ord, Enum, Bounded)

parsePosition :: Text -> Maybe Position
  ! accepts BOTH MLB numeric codes ('1','2',...,'10') AND scorer abbreviations ('P','C','1B','2B','3B','SS','LF','CF','RF','DH')
  ! case-sensitive: '1b' would not match
  ! returns Nothing for 'TWP' (intentional)

renderPosition :: Position -> Text
  ! returns the scorer form
  ! exhaustive over the sum

isPitcher :: Position -> Bool
  ! True for Pitcher only; False for everything else including DH

isInfielder :: Position -> Bool
  ! True for FirstBase, SecondBase, ThirdBase, Shortstop, AND Catcher
  ! Catcher being an infielder is conventional for fantasy classification

isOutfielder :: Position -> Bool
  ! True for LeftField, CenterField, RightField
  ! DH is not an outfielder despite the position number 10 being adjacent

%decision ExhaustiveSumNoCatchAll
  what:    The Position type is an exhaustive sum of MLB's ten positions; parsePosition returns Nothing on anything else
  why:     Positions are a small, stable set defined by MLB rules. An 'Other Text' fallback constructor would make the type infectious. Errors at the wire boundary surface as warnings, not silent fallbacks.
  affects: parsePosition

%decision TwoWayPlayerNotModelled
  what:    MLB's 'TWP' (two-way player, e.g. Ohtani) is intentionally not parsed
  why:     TWP requires a richer domain model (a player has multiple primary positions with separate stat lines). Out of scope for the current engine; would change scoring shape.
  affects: parsePosition


=== BEGIN Pelotero/Domain/Roster.hs ===

%file /home/bismuth/git/pelotero-engine/lib/Pelotero/Domain/Roster.hs
%mod Pelotero.Domain.Roster

%uses Data.Aeson
%uses qualified Data.Aeson.Types as Aeson
%uses Data.Foldable
%uses Data.List
%uses Data.Map.Strict
%uses qualified Data.Map.Strict as Map
%uses Data.Maybe
%uses Data.Sequence
%uses qualified Data.Sequence as Seq
%uses Data.Text
%uses qualified Data.Text as T
%uses Pelotero.Domain.Id

data RosterSlot
  = SlotCatcher
  | SlotFirstBase
  | SlotSecondBase
  | SlotThirdBase
  | SlotShortstop
  | SlotOutfield
  | SlotUtility
  | SlotStartingPitcher
  | SlotReliefPitcher
  deriving stock (Show, Eq, Ord, Enum, Bounded)

newtype Roster = Roster { unRoster :: Map RosterSlot (Seq PlayerId) }
  deriving stock (Show, Eq)

newtype Lineup = Lineup { unLineup :: Map RosterSlot (Seq PlayerId) }
  deriving stock (Show, Eq)

newtype RosterLimits = RosterLimits { unRosterLimits :: Map RosterSlot Int }
  deriving stock (Show, Eq)

newtype LineupLimits = LineupLimits { unLineupLimits :: Map RosterSlot Int }
  deriving stock (Show, Eq)

data RosterError
  = RosterTooManyAt !RosterSlot !Int !Int
  | RosterDuplicatePlayer !PlayerId
  deriving stock (Show, Eq)

data LineupError
  = LineupTooManyAt !RosterSlot !Int !Int
  | LineupDuplicatePlayer !PlayerId
  deriving stock (Show, Eq)

instance ToJSON RosterLimits where

instance FromJSON RosterLimits where

instance ToJSON LineupLimits where

instance FromJSON LineupLimits where

allRosterSlots :: [RosterSlot]
  ! [minBound .. maxBound]; the canonical traversal order is the constructor order in RosterSlot

parseRosterSlot :: Text -> Maybe RosterSlot
  ! case-sensitive; accepts 'catcher', 'first', 'second', 'third', 'shortstop', 'outfield', 'utility', 's_pitcher', 'r_pitcher'
  ! the s_pitcher / r_pitcher names match legacy DB schema
  ! consumed by Pelotero.DB.JsonB.JsonbRosterLimits and JsonbLineupLimits FromJSON instances

renderRosterSlot :: RosterSlot -> Text
  ! exhaustive; produces the parse-target strings
  ! consumed by Pelotero.DB.JsonB ToJSON instances

isPitcherSlot :: RosterSlot -> Bool
  ! True for SlotStartingPitcher and SlotReliefPitcher

isBatterSlot :: RosterSlot -> Bool
  ! = not . isPitcherSlot; SlotUtility is a batter slot

emptyRoster :: Roster
  ! every slot present with empty Seq

emptyLineup :: Lineup
  ! mirror of emptyRoster

rosterAt :: RosterSlot -> Roster -> Seq PlayerId
  ! returns Seq.empty if the slot is somehow missing from the map

lineupAt :: RosterSlot -> Lineup -> Seq PlayerId
  ! mirror of rosterAt

addToRoster :: RosterSlot -> PlayerId -> Roster -> Roster
  ! appends to the slot's Seq using Map.insertWith
  ! no validation against limits at this point

addToLineup :: RosterSlot -> PlayerId -> Lineup -> Lineup
  ! mirror of addToRoster

removeFromRoster :: RosterSlot -> PlayerId -> Roster -> Roster
  ! removes the FIRST occurrence of pid from the slot's Seq
  ! does nothing if the slot or pid is absent

removeFromLineup :: RosterSlot -> PlayerId -> Lineup -> Lineup
  ! mirror of removeFromRoster

seqRemoveFirst :: Eq a => a -> Seq a -> Seq a
  ! private; uses Seq.breakl + Seq.viewl

rosterPlayers :: Roster -> [PlayerId]
  ! concatMap toList over slot Seqs

lineupPlayers :: Lineup -> [PlayerId]
  ! mirror of rosterPlayers

rosterContains :: PlayerId -> Roster -> Bool
  ! linear scan via elem

lineupContains :: PlayerId -> Lineup -> Bool
  ! mirror of rosterContains

countAt :: RosterSlot -> Roster -> Int
  ! Seq.length on the slot; O(1)

countAtLineup :: RosterSlot -> Lineup -> Int
  ! mirror of countAt

rosterLimitFor :: RosterSlot -> RosterLimits -> Int
  ! Map lookup; defaults to 0 if the slot has no entry

lineupLimitFor :: RosterSlot -> LineupLimits -> Int
  ! mirror of rosterLimitFor

totalRosterSize :: RosterLimits -> Int
  ! sum of all slot limits

totalLineupSize :: LineupLimits -> Int
  ! mirror of totalRosterSize

validateRoster :: RosterLimits -> Roster -> [RosterError]
  ! produces all over-limit errors then all duplicate errors
  ! duplicates detected via group . sort, so the resulting list is in PlayerId order

validateLineup :: LineupLimits -> Lineup -> [LineupError]
  ! mirror of validateRoster but with LineupError variants

duplicates :: Ord a => [a] -> [a]
  ! private; group . sort then take first of each group of size >= 2

%decision SeqForOrderedSlotMembers
  what:    Roster and Lineup both use Map RosterSlot (Seq PlayerId) — Seq, not List or Set
  why:     Order matters within a slot. Set would lose ordering; List has O(n) appends; Seq has O(log n). The slot order itself doesn't matter (Map handles that), but the order within a slot does — and now persists via order_index columns post Phase B.2.
  affects: addToRoster, addToLineup

%decision ValidationProducesAllErrorsNotJustFirst
  what:    validateRoster and validateLineup return [RosterError] / [LineupError] — all problems, not just the first
  why:     When showing errors in a UI, displaying 'too many at OF (3 vs 2)' AND 'duplicate player X' is more useful than 'too many at OF, retry'. Order is: all size problems then all duplicate problems.
  affects: validateRoster, validateLineup

%decision JsonInstancesMovedToWrapperModule
  what:    RosterLimits / LineupLimits no longer have ToJSON / FromJSON instances in this module; the JSONB-encoded versions live on JsonbRosterLimits / JsonbLineupLimits in Pelotero.DB.JsonB
  why:     Phase A.4 moved Aeson out of Domain. The Domain types are pure structural records; persistence-format concerns live in Pelotero.DB.JsonB. The wrapper newtype owns the slot-key encoding via renderRosterSlot / parseRosterSlot. Anyone needing JSON round-tripping wraps the value in JsonbRosterLimits at the boundary.
  affects: 


=== BEGIN Pelotero/Domain/Scoring.hs ===

%file /home/bismuth/git/pelotero-engine/lib/Pelotero/Domain/Scoring.hs
%mod Pelotero.Domain.Scoring

%uses Data.Maybe
%uses Pelotero.Domain.Stats
%uses Data.Aeson

newtype Points = Points { unPoints :: Rational }
  deriving stock (Show)
  deriving newtype (Eq, Ord)

data BattingMultipliers = BattingMultipliers
  { bmSingle         :: !Rational
  , bmDouble         :: !Rational
  , bmTriple         :: !Rational
  , bmHomeRun        :: !Rational
  , bmRbi            :: !Rational
  , bmRun            :: !Rational
  , bmBaseOnBalls    :: !Rational
  , bmStolenBase     :: !Rational
  , bmHitByPitch     :: !Rational
  , bmStrikeOut      :: !Rational
  , bmCaughtStealing :: !Rational
  }
  deriving stock (Show, Eq)

data PitchingMultipliers = PitchingMultipliers
  { pmWin           :: !Rational
  , pmSave          :: !Rational
  , pmQualityStart  :: !Rational
  , pmInningPitched :: !Rational  -- per inning (one inning = 3 outs)
  , pmStrikeOut     :: !Rational
  , pmCompleteGame  :: !Rational
  , pmShutout       :: !Rational
  , pmBaseOnBalls   :: !Rational
  , pmHitsAllowed   :: !Rational
  , pmEarnedRun     :: !Rational
  , pmHitBatsman    :: !Rational
  , pmLoss          :: !Rational
  }
  deriving stock (Show, Eq)

data LeagueScoring = LeagueScoring
  { lsBatting  :: !BattingMultipliers
  , lsPitching :: !PitchingMultipliers
  }
  deriving stock (Show, Eq)

instance ToJSON BattingMultipliers where

instance FromJSON BattingMultipliers where

instance ToJSON PitchingMultipliers where

instance FromJSON PitchingMultipliers where

instance ToJSON LeagueScoring where

instance FromJSON LeagueScoring where

zeroPoints :: Points
  ! Points 0; identity for addPoints

addPoints :: Points -> Points -> Points
  ! pointwise Rational addition

subPoints :: Points -> Points -> Points
  ! pointwise Rational subtraction; can produce negative Points
  ! currently has no in-tree caller; effectively dead code retained for symmetry

scalePoints :: Rational -> Points -> Points
  ! multiplies Points by a Rational; preserves exactness

sumPoints :: Foldable t => t Points -> Points
  ! left-fold over a Foldable; uses zeroPoints as the seed

scoreBatting :: BattingMultipliers -> BattingStats -> Points
  ! sums per-stat contributions; each contribution is multiplier * count
  ! singles are derived: max 0 of (hits - doubles - triples - homeRuns)
  ! missing stats default to 0 via fromMaybe; an empty BattingStats produces zeroPoints

scorePitching :: PitchingMultipliers -> PitchingStats -> Points
  ! outs read directly from pitOuts (post Phase B.1); no parseInningsPitched step
  ! qualityStarts is 1 if outs >= 18 (6 innings) AND earnedRuns <= 3, else 0
  ! innings-pitched contribution uses Rational (outs/3) for exactness

rationalPts :: Int -> Points
  ! private; Int -> Points via toRational

%decision PointsAsRationalNotDouble
  what:    The Points newtype wraps Rational, not Double
  why:     Sums of fantasy points across many games accumulate; floating drift is observable when a season total visibly disagrees with the sum of game lines. Scaling by Rational multipliers (e.g. 1/3 for innings) stays exact end-to-end.
  affects: scalePoints, scoreBatting, scorePitching

%decision MultiplierFieldsAsExplicitRecord
  what:    The batting and pitching multiplier records list every scored stat as a named field
  why:     A Map String Rational would defer typo detection to runtime. Adding a stat is a structural change on purpose.
  affects: scoreBatting, scorePitching

%decision DerivedStatsInScoringNotData
  what:    Singles (batting) and quality starts (pitching) are derived inside scoreBatting / scorePitching, not stored as fields
  why:     Singles = hits - (doubles + triples + homeRuns); the wire layer doesn't ship singles separately. Quality start = IP >= 6 AND ER <= 3; not a stat the boxscore reports.
  affects: scoreBatting, scorePitching

%decision ScorePitchingReadsPitOutsDirectly
  what:    scorePitching reads pitOuts straight from PitchingStats; no parseInningsPitched . pitInningsPitched step (post Phase B.1)
  why:     The redundancy between pitInningsPitched (Maybe Text) and pitOuts (Maybe Int) is gone at the Domain level; PitchingStats now has only pitOuts. Removes a parse step from every scoring call. More importantly, removes a class of bug where a future caller could set pitOuts without setting pitInningsPitched (or vice versa) and silently get the wrong answer.
  affects: scorePitching

%decision InningsPitchedExactRationalArithmetic
  what:    scorePitching computes 'pmInningPitched * (outs / 3)' as Rational, not as a Double or pre-rounded decimal
  why:     Per-inning multipliers are typically integers or simple fractions; fractional outs need exact division. Pre-rounding loses ~0.05 points per fractional inning, compounding over 150 starts.
  affects: scorePitching

%decision JsonInstancesMovedToWrapperModule
  what:    BattingMultipliers / PitchingMultipliers / LeagueScoring no longer have ToJSON / FromJSON instances here; the JSONB-encoded versions live on Pelotero.DB.JsonB wrappers
  why:     Phase A.4 moved Aeson out of Domain. The Domain types are pure value records. Persistence-format concerns live in Pelotero.DB.JsonB; JsonbScoring / JsonbBattingMultipliers / JsonbPitchingMultipliers wrap the Domain types and own the instances.
  affects: 


