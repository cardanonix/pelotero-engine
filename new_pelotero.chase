data LeagueTeam f = LeagueTeam
  { _ltId             :: Column f DbLeagueTeamId
  , _ltLeagueConfigId :: Column f DbLeagueConfigId
  , _ltTeamKey        :: Column f Text
  , _ltName           :: Column f Text
  , _ltOwner          :: Column f Text
  }
  deriving stock    (Generic)
  deriving anyclass (Rel8able)

data LeagueTeamRow = LeagueTeamRow
  { ltId             :: !(Maybe DbLeagueTeamId)
  , ltLeagueConfigId :: !DbLeagueConfigId
  , ltTeamKey        :: !Text
  , ltName           :: !Text
  , ltOwner          :: !Text
  }
  deriving stock (Show, Eq)

leagueTeamSchema :: TableSchema (LeagueTeam Name)
  ! table 'league_team' with surrogate id, FK to league_config, team_key (stable), name, owner
  ! no last-synced metadata — league teams are user-managed, not externally synced

fromResult :: LeagueTeam Result -> LeagueTeamRow
  ! private; rel8 Result -> LeagueTeamRow

insertLeagueTeamT :: LeagueTeamRow -> Tx.Transaction DbLeagueTeamId
  ! INSERT ... RETURNING id; Abort on conflict

updateLeagueTeamT :: DbLeagueTeamId -> LeagueTeamRow -> Tx.Transaction ()
  ! WHERE id = ltid; updates everything except id

getByIdT :: DbLeagueTeamId -> Tx.Transaction (Maybe LeagueTeamRow)
  ! single-row select via WHERE id

lookupByKeyT
  :: DbLeagueConfigId -> Text -> Tx.Transaction (Maybe LeagueTeamRow)
  ! WHERE league_config_id AND team_key; returns the first match or Nothing

getForLeagueT :: DbLeagueConfigId -> Tx.Transaction [LeagueTeamRow]
  ! ORDER BY name; all teams in a league

deleteT :: DbLeagueTeamId -> Tx.Transaction ()
  ! DELETE WHERE id; cascading deletes on dependent rows handled by FK ON DELETE

insertLeagueTeam :: Pool -> LeagueTeamRow -> IO (Either DBError DbLeagueTeamId)
  ! Pool-flavored wrapper

updateLeagueTeam :: Pool -> DbLeagueTeamId -> LeagueTeamRow -> IO (Either DBError ())
  ! Pool-flavored wrapper

getById :: Pool -> DbLeagueTeamId -> IO (Either DBError (Maybe LeagueTeamRow))
  ! Pool-flavored single-row read

lookupByKey
  :: Pool -> DbLeagueConfigId -> Text -> IO (Either DBError (Maybe LeagueTeamRow))
  ! Pool-flavored compound-key lookup

getForLeague :: Pool -> DbLeagueConfigId -> IO (Either DBError [LeagueTeamRow])
  ! Pool-flavored per-league listing

delete :: Pool -> DbLeagueTeamId -> IO (Either DBError ())
  ! Pool-flavored row deletion

%decision TeamKeySeparateFromName
  what:    league_team has both team_key (stable identifier within a league) and name (mutable display name)
  why:     Owners change team names mid-season; references from elsewhere (rosters, lineups, picks) must remain stable. team_key is the join key; name is the rendered string. (league_config_id, team_key) is the natural compound key.
  affects: leagueTeamSchema, lookupByKeyT


