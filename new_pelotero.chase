  , wbpStrikes                 :: Maybe Int
  , wbpBalls                   :: Maybe Int
  , wbpHits                    :: Maybe Int
  , wbpDoubles                 :: Maybe Int
  , wbpTriples                 :: Maybe Int
  , wbpHomeRuns                :: Maybe Int
