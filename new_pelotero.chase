  , lcScoringEnd    :: !UTCTime
  }
  deriving stock (Show, Eq)

leagueConfigSchema :: TableSchema (LeagueConfig Name)
  ! table 'league_config' with surrogate id, league_id (Text), commissioner, status, JSONB scoring/roster/lineup, draft params, scoring period bounds

fromResult :: LeagueConfig Result -> LeagueConfigRow
  ! private; rel8 Result -> public LeagueConfigRow

insertLeagueConfigT :: LeagueConfigRow -> Tx.Transaction DbLeagueConfigId
  ! INSERT ... RETURNING id; Abort on conflict

