  { wtId           :: Int
  , wtName         :: Text
  , wtAbbreviation :: Text
  , wtLocationName :: Maybe Text
    -- ^ Sometimes absent for short-season or international teams; we
    -- default to empty string at conversion time.
  }
  deriving stock (Show, Eq)

instance FromJSON WireTeam where

%decision WireTeamMinimalFields
  what:    WireTeam parses only id, name, abbreviation, and locationName; ignores division, league, venue, founded year, etc.
  why:     The DB stores only what we display in lineup/box rendering; ignoring the rest is the simplest way to avoid schema bloat. If a future feature needs division or league info, we re-parse here without any data migration. Aeson silently ignores unknown JSON keys, so this is forward-compatible against MLB adding fields.
  affects: 


