%file /home/bismuth/git/pelotero-engine/lib/Pelotero/Effects/Players.hs
%mod Pelotero.Effects.Players

%ext TypeFamilies, DataKinds, TypeOperators, FlexibleContexts, GADTs, LambdaCase

%uses Data.IORef
%uses qualified Data.Map.Strict as Map
%uses Data.Text
%uses Effectful
%uses qualified Effectful as E
%uses Effectful.Dispatch.Dynamic
%uses Pelotero.DB.Player
%uses qualified Pelotero.DB.Player as PlayerRepo
%uses Pelotero.DB.Provider
%uses Pelotero.Domain.Id
%uses Pelotero.Effects.Database

data Players :: Effect where
  UpsertPlayerByExternalId :: ProviderName -> Text -> PlayerRow -> Players m DbPlayerId
  LookupPlayerByExternalId :: ProviderName -> Text -> Players m (Maybe DbPlayerId)
  GetPlayerById            :: DbPlayerId -> Players m (Maybe PlayerRow)
  GetActivePlayers         :: Players m [PlayerRow]

data PlayerStore = PlayerStore
  { externalIdToDb :: !(Map.Map (ProviderName, Text) DbPlayerId)
  , rowsByDb       :: !(Map.Map DbPlayerId PlayerRow)
  , nextId         :: !Int
  }

upsertPlayerByExternalId
  :: Players E.:> es
  => ProviderName -> Text -> PlayerRow -> E.Eff es DbPlayerId
  ! Players send-only; same semantics as DB upsertByExternalId

lookupPlayerByExternalId
  :: Players E.:> es
  => ProviderName -> Text -> E.Eff es (Maybe DbPlayerId)
  ! Players send-only; (provider, externalId) -> Maybe DbPlayerId

getPlayerById :: Players E.:> es => DbPlayerId -> E.Eff es (Maybe PlayerRow)
  ! Players send-only; DbPlayerId -> Maybe PlayerRow

getActivePlayers :: Players E.:> es => E.Eff es [PlayerRow]
  ! Players send-only; all players where active=True

runPlayersDB
  :: Database E.:> es
  => E.Eff (Players : es) a
  -> E.Eff es a
  ! Database-backed interpreter; delegates to Pelotero.DB.Player
  ! requires Error DBError post Phase A.3

emptyStore :: PlayerStore
  ! private; PlayerStore Map.empty Map.empty 1

runPlayersInMemory
  :: IOE E.:> es
  => E.Eff (Players : es) a
  -> E.Eff es a
  ! IORef-based test interpreter
  ! UpsertPlayerByExternalId: if (provider, externalId) found, update rowsByDb keeping the existing id; else assign nextId and insert into both maps
  ! GetActivePlayers iterates all rows and filters by playerRowActive

%decision InMemoryAssignsAutoIncrementId
  what:    runPlayersInMemory's UpsertPlayerByExternalId uses an internal nextId counter (Int starting at 1)
  why:     Mirrors the DB's BIGSERIAL behaviour without needing an actual sequence. Counter is per-IORef (per-runner-instance), so two concurrent test runs don't share ids.
  affects: runPlayersInMemory, emptyStore


