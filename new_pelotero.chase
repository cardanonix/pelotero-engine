%mod Pelotero.Domain.Id

%uses Data.Int
%uses Data.Text

newtype PlayerId = PlayerId { unPlayerId :: Int }
  deriving stock (Show, Eq, Ord)

newtype TeamId = TeamId { unTeamId :: Int }
  deriving stock (Show, Eq, Ord)

newtype GameId = GameId { unGameId :: Int }
  deriving stock (Show, Eq, Ord)

newtype SeasonYear = SeasonYear { unSeasonYear :: Int }
  deriving stock (Show, Eq, Ord)

newtype LeagueId = LeagueId { unLeagueId :: Text }
  deriving stock (Show, Eq, Ord)

newtype FantasyTeamId = FantasyTeamId { unFantasyTeamId :: Text }
  deriving stock (Show, Eq, Ord)

newtype DraftPickNumber = DraftPickNumber { unDraftPickNumber :: Int }
  deriving stock (Show, Eq, Ord)

newtype RankSlot = RankSlot { unRankSlot :: Int }
  deriving stock (Show, Eq, Ord)

newtype DbPlayerId = DbPlayerId { unDbPlayerId :: Int64 }
  deriving stock (Show, Eq, Ord)

newtype DbTeamId = DbTeamId { unDbTeamId :: Int64 }
  deriving stock (Show, Eq, Ord)

newtype DbGameId = DbGameId { unDbGameId :: Int64 }
  deriving stock (Show, Eq, Ord)

newtype DbLeagueConfigId = DbLeagueConfigId { unDbLeagueConfigId :: Int64 }
  deriving stock (Show, Eq, Ord)

newtype DbLeagueTeamId = DbLeagueTeamId { unDbLeagueTeamId :: Int64 }
  deriving stock (Show, Eq, Ord)

newtype DbDraftPickId = DbDraftPickId { unDbDraftPickId :: Int64 }
  deriving stock (Show, Eq, Ord)

%decision UpstreamAndSurrogateAreDistinctTypes
  what:    PlayerId / TeamId / GameId (upstream MLB ids) and DbPlayerId / DbTeamId / DbGameId (surrogate DB BIGSERIAL ids) are different newtypes
  why:     Conflating them led to bugs: a function expecting an MLB id received a DB surrogate, the SQL succeeded with the wrong row, and nothing complained. Newtype distinctness forces the conversion to be explicit (a lookup against player_external_id) rather than a coerce. The cost is more wrappers; the win is the type system catching crossings of the layer boundary.
  affects: 

%decision TextIdsForUserSpaces
  what:    LeagueId and FantasyTeamId wrap Text, not Int
  why:     Leagues and fantasy teams have user-chosen identifiers (e.g. 'east-coast-2025', 'rocketeers'), not auto-incremented numbers. Database surrogate keys (DbLeagueConfigId, DbLeagueTeamId) are still Int64 for indexing efficiency; user-facing stays Text.
  affects: 

%decision NoSmartConstructorsHere
  what:    All newtypes have public constructors and accessors; no smart-constructor validation
  why:     Validation (rejecting nonsense like PlayerId 0) happens at the wire boundary in Pelotero.MLB.Convert.convertPlayer. The wire layer is the single source of truth for what counts as a valid id; this module is structural only. Pelotero.Provider.ExternalId provides the to/from Text encodings (Phase A.1) but does not validate id ranges.
  affects: 


