%mod Pelotero.DB.RosterSlot

%ext DataKinds, DeriveAnyClass, DeriveGeneric, DerivingStrategies, DuplicateRecordFields, OverloadedStrings, StandaloneDeriving, TypeFamilies, TypeOperators, UndecidableInstances

%uses Data.Functor.Contravariant
%uses Data.Int
%uses Data.Text
%uses Data.Time
%uses GHC.Generics
%uses qualified Hasql.Transaction as Tx
%uses Rel8
%uses qualified Rel8 as R
%uses Pelotero.DB.Pool
%uses Pelotero.DB.Rel8Instances
%uses Pelotero.Domain.Id

data RosterSlotE f = RosterSlotE
  { _rsId           :: Column f Int64
  , _rsLeagueTeamId :: Column f DbLeagueTeamId
  , _rsSlot         :: Column f Text
  , _rsPlayerId     :: Column f DbPlayerId
  , _rsCreatedAt    :: Column f UTCTime
  }
  deriving stock    (Generic)
  deriving anyclass (Rel8able)

data RosterSlotRow = RosterSlotRow
  { rsLeagueTeamId :: !DbLeagueTeamId
  , rsSlot         :: !Text
  , rsPlayerId     :: !DbPlayerId
  }
  deriving stock (Show, Eq)

rosterSlotSchema :: TableSchema (RosterSlotE Name)
  ! table 'roster_slot' with surrogate id, FK to league_team, slot (Text), FK to player, created_at
  ! natural unique key: (league_team_id, player_id)
  ! no order_index column today; planned B.2 work adds it for batting-order positional persistence

fromResult :: RosterSlotE Result -> RosterSlotRow
  ! private; drops the hidden surrogate id and created_at

addSlotT :: RosterSlotRow -> Tx.Transaction ()
  ! INSERT ... ON CONFLICT (league_team_id, player_id) DO UPDATE SET slot

getSlotsForTeamT :: DbLeagueTeamId -> Tx.Transaction [RosterSlotRow]
  ! WHERE league_team_id; ORDER BY slot, player_id

removeSlotT :: DbLeagueTeamId -> DbPlayerId -> Tx.Transaction ()
  ! DELETE WHERE league_team_id AND player_id

removePlayerFromTeamT :: DbLeagueTeamId -> DbPlayerId -> Tx.Transaction ()
  ! alias for removeSlotT

clearTeamRosterT :: DbLeagueTeamId -> Tx.Transaction ()
  ! DELETE WHERE league_team_id

replaceTeamRosterT :: DbLeagueTeamId -> [RosterSlotRow] -> Tx.Transaction ()
  ! transaction-internal sequence: clearTeamRosterT then mapM_ addSlotT
  ! entirely within the caller's transaction

countBySlotT :: DbLeagueTeamId -> Text -> Tx.Transaction Int64
  ! COUNT(*) WHERE league_team_id AND slot

getSlotsForTeam :: Pool -> DbLeagueTeamId -> IO (Either DBError [RosterSlotRow])
  ! Pool-flavored wrapper

addSlot :: Pool -> RosterSlotRow -> IO (Either DBError ())
  ! Pool-flavored upsert

removeSlot :: Pool -> DbLeagueTeamId -> DbPlayerId -> IO (Either DBError ())
  ! Pool-flavored single removal

removePlayerFromTeam :: Pool -> DbLeagueTeamId -> DbPlayerId -> IO (Either DBError ())
  ! Pool-flavored alias for removeSlot

clearTeamRoster :: Pool -> DbLeagueTeamId -> IO (Either DBError ())
  ! Pool-flavored full clear

replaceTeamRoster :: Pool -> DbLeagueTeamId -> [RosterSlotRow] -> IO (Either DBError ())
  ! Pool-flavored clear-then-fill

countBySlot :: Pool -> DbLeagueTeamId -> Text -> IO (Either DBError Int64)
  ! Pool-flavored count

%decision UpsertOnPlayerNotSlot
  what:    addSlotT does ON CONFLICT (league_team_id, player_id) DO UPDATE SET slot, NOT (league_team_id, slot)
  why:     The natural-feeling 'a slot can hold one player' is wrong for fantasy; multiple OF/UTIL slots per team is normal. The actual invariant is 'a player is in at most one slot per team'. Adding a player who's already on the roster moves them to the new slot rather than failing or duplicating.
  affects: addSlotT


