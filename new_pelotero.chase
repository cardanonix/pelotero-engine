%mod Pelotero.DB.Game

%ext DataKinds, DeriveAnyClass, DeriveGeneric, DerivingStrategies, DuplicateRecordFields, OverloadedStrings, StandaloneDeriving, TypeFamilies, TypeOperators, UndecidableInstances

%uses Data.Functor.Contravariant
%uses Data.Text
%uses Data.Time
%uses GHC.Generics
%uses qualified Hasql.Transaction as Tx
%uses Rel8
%uses qualified Rel8 as R
%uses Pelotero.DB.Pool
%uses Pelotero.DB.Provider
%uses Pelotero.DB.Rel8Instances
%uses Pelotero.Domain.Id

data Game f = Game
  { _gameId                 :: Column f DbGameId
  , _gameGameDate           :: Column f Day
  , _gameAwayTeamId         :: Column f DbTeamId
  , _gameHomeTeamId         :: Column f DbTeamId
  , _gameLastSyncedProvider :: Column f (Maybe ProviderName)
  , _gameLastSyncedAt       :: Column f (Maybe UTCTime)
  }
  deriving stock    (Generic)
  deriving anyclass (Rel8able)

data GameExternalId f = GameExternalId
  { _geidGameId     :: Column f DbGameId
  , _geidProvider   :: Column f ProviderName
  , _geidExternalId :: Column f Text
  , _geidFetchedAt  :: Column f UTCTime
  }
  deriving stock    (Generic)
  deriving anyclass (Rel8able)

data GameRow = GameRow
  { gameRowId                 :: !(Maybe DbGameId)
  , gameRowGameDate           :: !Day
  , gameRowAwayTeamId         :: !DbTeamId
  , gameRowHomeTeamId         :: !DbTeamId
  , gameRowLastSyncedProvider :: !(Maybe ProviderName)
  , gameRowLastSyncedAt       :: !(Maybe UTCTime)
  }
  deriving stock (Show, Eq)

gameSchema :: TableSchema (Game Name)
  ! table 'game' with surrogate id, game_date (Day), away/home team FKs to team.id, last-synced metadata

gameExternalIdSchema :: TableSchema (GameExternalId Name)
  ! same shape as player_external_id and team_external_id

fromResult :: Game Result -> GameRow
  ! private; rel8 Result -> public GameRow

insertGameT :: GameRow -> Tx.Transaction DbGameId
  ! INSERT ... RETURNING id; Abort on conflict

updateGameT :: DbGameId -> GameRow -> Tx.Transaction ()
  ! WHERE id = gid; updates everything except id

getByIdT :: DbGameId -> Tx.Transaction (Maybe GameRow)
  ! single-row select via WHERE id

getByDateT :: Day -> Tx.Transaction [GameRow]
  ! WHERE game_date = ? ORDER BY id

getByDateRangeT :: Day -> Day -> Tx.Transaction [GameRow]
  ! WHERE game_date BETWEEN startDay AND endDay (inclusive both ends)
  ! ORDER BY game_date ASC, id ASC for stable cross-day display
  ! consumed by Pelotero.DB.BoxscoreEntry.getBattingForDateRangeT and getPitchingForDateRangeT (via JOIN)

linkExternalIdT :: DbGameId -> ProviderName -> Text -> Tx.Transaction ()

lookupByExternalIdT :: ProviderName -> Text -> Tx.Transaction (Maybe DbGameId)

getExternalIdT :: DbGameId -> ProviderName -> Tx.Transaction (Maybe Text)

upsertByExternalIdT
  :: ProviderName -> Text -> GameRow -> Tx.Transaction DbGameId

insertGame :: Pool -> GameRow -> IO (Either DBError DbGameId)
  ! Pool-flavored wrapper

updateGame :: Pool -> DbGameId -> GameRow -> IO (Either DBError ())
  ! Pool-flavored wrapper

getById :: Pool -> DbGameId -> IO (Either DBError (Maybe GameRow))
  ! Pool-flavored single-game read

getByDate :: Pool -> Day -> IO (Either DBError [GameRow])
  ! Pool-flavored per-date read

getByDateRange :: Pool -> Day -> Day -> IO (Either DBError [GameRow])
  ! Pool-flavored wrapper; inclusive on both ends

linkExternalId :: Pool -> DbGameId -> ProviderName -> Text -> IO (Either DBError ())

lookupByExternalId :: Pool -> ProviderName -> Text -> IO (Either DBError (Maybe DbGameId))

getExternalId :: Pool -> DbGameId -> ProviderName -> IO (Either DBError (Maybe Text))

upsertByExternalId
  :: Pool -> ProviderName -> Text -> GameRow -> IO (Either DBError DbGameId)

%decision GameDateAsDay
  what:    game.game_date stores Day (no time of day), not UTCTime
  why:     Fantasy scoring periods are defined by date in the league's local timezone; game start times within a day are irrelevant for whether the game counts. Storing as TIMESTAMPTZ would force every query to deal with timezone offset for what is fundamentally a calendar question.
  affects: gameSchema, getByDateT

%decision ProviderKeyedInstance
  what:    GameRow has an instance of Pelotero.DB.Common.ProviderKeyed
  why:     Same rationale as Player and Team. The previous MirrorsTeamSchema decision is subsumed by the class abstraction in Phase A.5.
  affects: 


