%file /home/bismuth/git/pelotero-engine/lib/Pelotero/DB/Player.hs
%mod Pelotero.DB.Player

%ext DataKinds, DeriveAnyClass, DeriveGeneric, DerivingStrategies, DuplicateRecordFields, FlexibleContexts, OverloadedStrings, RecordWildCards, StandaloneDeriving, TypeApplications, TypeFamilies, TypeOperators, UndecidableInstances

%uses Data.Text
%uses qualified Data.Text as T
%uses Data.Time
%uses GHC.Generics
%uses qualified Hasql.Transaction as Tx
%uses Rel8 hiding
%uses Pelotero.DB.Pool
%uses qualified Pelotero.DB.ProviderKeyed as PK
%uses Pelotero.DB.ProviderKeyed
%uses Pelotero.DB.Provider
%uses Pelotero.DB.Rel8Instances
%uses Pelotero.Domain.Id

data Player f = Player
  { _playerId                 :: Column f DbPlayerId
  , _playerFirstName          :: Column f Text
  , _playerLastName           :: Column f Text
  , _playerNameSlug           :: Column f Text
  , _playerPosition           :: Column f (Maybe Text)
  , _playerBatSide            :: Column f (Maybe Text)
  , _playerPitchHand          :: Column f (Maybe Text)
  , _playerActive             :: Column f Bool
  , _playerCurrentTeamId      :: Column f (Maybe DbTeamId)
  , _playerLastSyncedProvider :: Column f (Maybe ProviderName)
  , _playerLastSyncedAt       :: Column f (Maybe UTCTime)
  }
  deriving stock    (Generic)
  deriving anyclass (Rel8able)

data PlayerRow = PlayerRow
  { playerRowId                 :: !(Maybe DbPlayerId)
  , playerRowFirstName          :: !Text
  , playerRowLastName           :: !Text
  , playerRowNameSlug           :: !Text
  , playerRowPosition           :: !(Maybe Text)
  , playerRowBatSide            :: !(Maybe Char)
  , playerRowPitchHand          :: !(Maybe Char)
  , playerRowActive             :: !Bool
  , playerRowCurrentTeamId      :: !(Maybe DbTeamId)
  , playerRowLastSyncedProvider :: !(Maybe ProviderName)
  , playerRowLastSyncedAt       :: !(Maybe UTCTime)
  }
  deriving stock (Show, Eq)

instance ProviderKeyed PlayerRow where

playerSchema :: TableSchema (Player Name)
  ! table 'player' with surrogate id, denormalised name, position, batting/pitching hand as text, active flag, FK to team, last-synced metadata
  ! playerCurrentTeamId is Maybe DbTeamId; a player without a team has NULL

playerExternalIdSchema :: TableSchema (ExternalIdE DbPlayerId Name)
  ! table 'player_external_id' with (player_id, provider, external_id, fetched_at)

charToText :: Maybe Char -> Maybe Text
  ! Maybe Char -> Maybe Text via T.singleton; preserves None

textToChar :: Maybe Text -> Maybe Char
  ! Maybe Text -> Maybe Char via T.uncons
  ! if the stored text has more than one character (data corruption), silently truncates

fromResult :: Player Result -> PlayerRow
  ! private; converts the rel8 Player Result row to the public PlayerRow

playerRowToExpr :: PlayerRow -> Player Expr

insertPlayerT :: PlayerRow -> Tx.Transaction DbPlayerId
  ! INSERT ... RETURNING id; uses Abort on conflict
  ! the surrogate id is unsafeDefault (DB-assigned BIGSERIAL); all other fields come from the row

updatePlayerT :: DbPlayerId -> PlayerRow -> Tx.Transaction ()
  ! WHERE id = pid; updates everything except id
  ! no-op if pid doesn't exist

getByIdT :: DbPlayerId -> Tx.Transaction (Maybe PlayerRow)
  ! single-row select via WHERE; returns the first match or Nothing

getAllT :: Tx.Transaction [PlayerRow]
  ! ORDER BY last_name, first_name; returns the entire table

getActiveT :: Tx.Transaction [PlayerRow]
  ! ORDER BY last_name, first_name; WHERE active = TRUE

linkExternalIdT :: DbPlayerId -> ProviderName -> Text -> Tx.Transaction ()
  ! INSERT ... ON CONFLICT DO NOTHING into player_external_id
  ! idempotent; safe to call repeatedly during re-syncs

lookupByExternalIdT :: ProviderName -> Text -> Tx.Transaction (Maybe DbPlayerId)
  ! SELECT player_id WHERE provider AND external_id; returns Maybe DbPlayerId

getExternalIdT :: DbPlayerId -> ProviderName -> Tx.Transaction (Maybe Text)
  ! reverse lookup: given a DbPlayerId and provider, returns Maybe Text

upsertByExternalIdT :: ProviderName -> Text -> PlayerRow -> Tx.Transaction DbPlayerId
  ! two-step: lookup via (provider, external_id); if found, update player; if not, insert and link
  ! atomic within the caller's transaction

insertPlayer :: Pool -> PlayerRow -> IO (Either DBError DbPlayerId)
  ! Pool-flavored wrapper around insertPlayerT

updatePlayer :: Pool -> DbPlayerId -> PlayerRow -> IO (Either DBError ())
  ! Pool-flavored wrapper around updatePlayerT

getById :: Pool -> DbPlayerId -> IO (Either DBError (Maybe PlayerRow))
  ! Pool-flavored single-player read

getAll :: Pool -> IO (Either DBError [PlayerRow])
  ! Pool-flavored full table read

getActive :: Pool -> IO (Either DBError [PlayerRow])
  ! Pool-flavored active-only read

linkExternalId :: Pool -> DbPlayerId -> ProviderName -> Text -> IO (Either DBError ())
  ! Pool-flavored wrapper

lookupByExternalId :: Pool -> ProviderName -> Text -> IO (Either DBError (Maybe DbPlayerId))
  ! Pool-flavored wrapper

getExternalId :: Pool -> DbPlayerId -> ProviderName -> IO (Either DBError (Maybe Text))
  ! Pool-flavored wrapper

upsertByExternalId :: Pool -> ProviderName -> Text -> PlayerRow -> IO (Either DBError DbPlayerId)
  ! Pool-flavored wrapper

%decision TwoTablePlayerExternalIdSplit
  what:    player table holds the canonical row; player_external_id holds (player_id, provider, external_id) tuples
  why:     A player can have ids from multiple providers without schema gymnastics on the player table. If a player gets re-identified, the player row stays put; only the external_id rows update. Cost: every upsert is two operations. Phase A.5 collapsed the link / lookup / getExternalId / upsert boilerplate into Pelotero.DB.ProviderKeyed; this module retains the per-table schema, row, and entity-specific reads, plus a one-line ProviderKeyed instance and four facades around the polymorphic helpers.
  affects: 

%decision BatHandStoredAsText
  what:    DB column for bat_side / pitch_hand is Text; the API exposes Char
  why:     PostgreSQL doesn't have a native single-character type smaller than TEXT (CHAR(1) exists but has fixed-length-padding gotchas). Char in Haskell is multi-byte (Unicode) so storing as Text is structurally correct. API uses Char because the only legal values are 'L', 'R', 'S' and a Char is the most precise way to encode 'exactly one character of these three'. Conversion API is now total at the Domain layer (handChar) post Phase A.6; this module only does the Text<->Char shuffle which remains structurally honest.
  affects: charToText, textToChar, fromResult, insertPlayerT, updatePlayerT


