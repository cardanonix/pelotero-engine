    , ofC :: [(O.PlayerID, Double)]
    , uC  :: [(O.PlayerID, Double)]
    , spC :: [(O.PlayerID, Double)]
    , rpC :: [(O.PlayerID, Double)]
    }
    deriving (Show, Eq)

data GmPoints = GmPoints
    { gmpts_Id :: O.PlayerID  -- newly added playerId
    , gmpts_batting :: [Maybe BattingGmPoints]
    , gmpts_pitching :: [Maybe PitchingGmPoints]
    }
    deriving (Show, Eq)

data BattingGmPoints = BattingGmPoints
    { gmb_gameId :: Text
    , gmb_total_points :: Double
    , gmb_single :: Double
    , gmb_double :: Double
    , gmb_triple :: Double
    , gmb_homerun :: Double
    , gmb_rbi :: Double
    , gmb_run :: Double
    , gmb_base_on_balls :: Double
    , gmb_stolen_base :: Double
    , gmb_hit_by_pitch :: Double
    , gmb_strikeout :: Double
    , gmb_caught_stealing :: Double
    }
    deriving (Show, Eq)

data PitchingGmPoints = PitchingGmPoints
    { gmp_gameId :: Text
    , gmp_total_points :: Double
    , gmp_win :: Double
    , gmp_save :: Double
    , gmp_quality_start :: Double
    , gmp_inning_pitched :: Double
    , gmp_strikeout :: Double
    , gmp_complete_game :: Double
    , gmp_shutout :: Double
    , gmp_base_on_balls :: Double
    , gmp_hits_allowed :: Double
    , gmp_earned_runs :: Double
    , gmp_hit_batsman :: Double
    , gmp_loss :: Double
    }
    deriving (Show, Eq)

%decision StatTypeIsTwoConstructorSum
  what:    StatType = Batting | Pitching
  why:     Two-constructor sum forbids the third 'undefined' state a Bool would admit. Consumed by Validators.batterOrPitcher (lineup-based dispatch), PointCalc.calculatePointsForPlayer (stat-table dispatch), Scraper.statTypeToString and Scraper.seasonStatsUrl (URL construction). Single point of growth if a third stat category is added.
  affects: 

%decision GmPointsCarriesPlayerIDInline
  what:    GmPoints has gmpts_Id; BattingGmPoints has gmb_gameId; PitchingGmPoints has gmp_gameId
  why:     Earlier design used external (PlayerID, GmPoints) tuples; bundling the ID inline removes the un-zip-then-rezip risk. Forces PointCalc.mergeGmPoints to defensively check that two GmPoints share a player ID at runtime, returning Left on mismatch. BUG: gmb_gameId and gmp_gameId are populated with the literal placeholder string 'GameID' in calcBattingPoints and calcPitchingPoints; no real game ID is ever threaded in.
  affects: 

%decision PlayerResultsAndResultsAreDeadCode
  what:    PlayerResults and Results data types have no constructors used outside their own definitions
  why:     PlayerResults was an earlier dispatch shape replaced by direct StatType handling. Results was an earlier shape for per-team final scoring output that was never wired up. Both are safe to delete.
  affects: 


