        , pit_T_inheritedRunnersScored :: Maybe Int
        , pit_T_catchersInterference :: Maybe Int
        , pit_T_sacBunts :: Maybe Int
        , pit_T_sacFlies :: Maybe Int
        , pit_T_passedBall :: Maybe Int
        } ->
        PitchingTotals
    deriving (Show, Eq)

instance FromJSON PitchingTotals where

%decision ModuleIsAlternateInputForSeasonStats
  what:    Leaderboard defines its own SeasonData, Teams, TeamData, Player, Person, Status, PlayerSeasonStats, BattingTotals, PitchingTotals
  why:     BattingTotals (32 fields) is a superset of Input.BattingStats with rate fields (avg, obp, slg, ops, babip, atBatsPerHomeRun) as Maybe Text. PitchingTotals (59 fields) is a superset of Input.PitchingStats with rate fields (era, whip, strikePercentage, winPercentage, etc.) as Maybe Text. Player here lacks parentTeamId and allPositions; carries seasonStats instead of stats. TeamData here does NOT filter empty-allPositions players (unlike Input.TeamData) - traverses parseJSON over the full map. No consumers in the codebase outside Playground.hs imports, and Playground's body is a large commented-out block.
  affects: 


