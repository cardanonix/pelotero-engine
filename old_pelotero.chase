%file /home/bismuth/git/pelotero-engine/old_src/ADT/PlayerRanking.hs
%mod PlayerRanking

%ext OverloadedStrings, DeriveGeneric, RecordWildCards, GADTs

%uses Data.Aeson
%uses Data.Time
%uses qualified Data.ByteString.Lazy as BL
%uses GHC.Generics
%uses Data.Text
%uses Data.Time.Clock
%uses Data.Time.Format
%uses Data.Aeson.Types
%uses qualified OfficialRoster as O
%uses qualified Config as C
%uses Data.Scientific

data RankingData = RankingData
    { teamId        :: C.TeamID
    , dataChecksum  :: Text
    , lastUpdated   :: UTCTime
    , rankings      :: [PlayerRanking]
    } deriving (Show, Eq, Generic)

data PlayerRanking = PlayerRanking
    { playerId :: O.PlayerID
    , rank     :: Int
    } deriving (Show, Eq, Generic)

type PlayerRankings = [PlayerRanking]

instance FromJSON PlayerRanking where

instance FromJSON RankingData where

instance ToJSON RankingData where

instance ToJSON PlayerRanking where

type DraftOrderStrategy = Int -> [C.TeamID] -> [C.TeamID]

mkEmptyRankings :: PlayerRankings
  ! type-annotated empty list of PlayerRanking
  ! no consumers in the codebase

serpentineOrderStrategy :: DraftOrderStrategy
  ! rounds = totalPicks `div` length teams (integer division; remainder dropped)
  ! alternates teams, reverse teams, teams, reverse teams ... for 'rounds' iterations
  > consumed by: selectDraftOrderStrategy

experimentalSnakeStrategy :: DraftOrderStrategy
  ! rounds = totalPicks `div` length teams
  ! 4-round repeating pattern: forward, mid-shifted, reverse, mid-shifted-reverse
  ! mid-shift uses 'drop (length teams `div` 2) $ cycle teams' taking 'length teams' elements
  > consumed by: selectDraftOrderStrategy

selectDraftOrderStrategy :: Text -> DraftOrderStrategy
  ! case-sensitive match on 'serpentine' or 'experimental_snake'
  ! any other input falls through to serpentineOrderStrategy
  > consumed by: Utility.generateDraftOrder

%decision DraftOrderStrategyIsAFunctionType
  what:    DraftOrderStrategy = Int -> [TeamID] -> [TeamID]; selectDraftOrderStrategy dispatches a Text name to a strategy
  why:     First-class function value lets callers pick a strategy by config string at runtime. Unknown strategy names silently fall through to serpentine (the default branch in selectDraftOrderStrategy).
  affects: selectDraftOrderStrategy

%decision RankingDataTimeFormatIsTimezoneNaive
  what:    FromJSON and ToJSON for RankingData use parseTimeM/formatTime with format "%Y-%m-%dT%H:%M"
  why:     No seconds, no timezone offset. Despite the field type being UTCTime, parses and emissions are timezone-naive in practice.
  affects: 

%decision PlayerRankingsTypeAlias
  what:    type PlayerRankings = [PlayerRanking]
  why:     Aliases [PlayerRanking] for use in mkEmptyRankings's signature. No other consumers in the codebase.
  affects: mkEmptyRankings


