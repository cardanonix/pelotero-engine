%file /home/bismuth/git/pelotero-engine/old_src/League/Scraper.hs
%mod Scraper

%ext DoAndIfThenElse, GADTs, OverloadedStrings

%uses Control.Concurrent.Async
%uses Control.Monad
%uses Crypto.Hash
%uses qualified Crypto.Hash.SHA256 as SHA256
%uses Data.Aeson
%uses Data.ByteString
%uses qualified Data.ByteString as B
%uses qualified Data.ByteString.Lazy as BL
%uses qualified Data.ByteString.Lazy.Char8 as BS
%uses qualified Data.Map as M
%uses Data.Maybe
%uses Data.Text
%uses qualified Data.Text as T
%uses Data.Time
%uses Data.Time.Clock
%uses Data.Time.Clock.POSIX
%uses Data.Time.Format
%uses qualified Data.Vector as V
%uses GHC.Generics
%uses Network.HTTP.Simple
%uses System.Directory
%uses qualified Input as I
%uses qualified Middle as MI
%uses qualified Points as P
%uses Validators
%uses Utility

fetchGameScheduleForDate :: String -> IO (Either String I.GameSchedule)
  ! fetches via scheduleUrl date, decodes as GameSchedule
  ! calls assignDateToSchedule to backfill game_date on every GameID

fetchGameStatus :: Int -> IO (Either String I.LiveGameWrapper)
  ! fetches via gameStatusUrl gameId, decodes as LiveGameWrapper

fetchFinishedBxScore :: Int -> IO (Either String (Maybe I.GameData))
  ! two-step: status fetch then conditional boxscore fetch
  ! Right (Just GameData) for finished games; Right Nothing for in-progress; Left for fetch/parse errors
  ! calls assignGameIdToPlayers on the boxscore before returning

fetchFinishedBxScores :: [Int] -> IO (Either String (M.Map Int (Maybe I.GameData)))
  ! mapConcurrently over [Int]; sequenceA collapses [Either] to Either []
  ! filters out (gameId, Nothing) entries via 'finishedGames' so the resulting Map only contains finished games

fetchFinishedBxScoresToJsonPlayerData :: [Int] -> IO (Either String (M.Map Text MI.JsonPlayerData))
  ! calls fetchFinishedBxScores and applies convertGameDataMapToJsonPlayerData on success

scrapeStatsForDateRange :: String -> String -> IO ()
  ! iterates generateDateRange start end with mapM_ processDate
  ! no transactionality; failures on later dates do not unwind earlier successes
  > consumed by: FetchStats.main

processDate :: String -> IO ()
  ! fetches schedule, calls processAndPrintGames (which only prints), then re-fetches and writes stats via writeDataToFile
  ! filename comes from formatFilename date, written under 'appData/stats'

flattenedPlayersList :: M.Map Text MI.JsonPlayerData -> M.Map Text MI.JsonPlayerData
  ! id function on Map Text JsonPlayerData
  ! no consumers in the codebase

printGameData :: Either String (M.Map Int I.GameData) -> IO ()
  ! prints (gameId, gameData) pairs to stdout
  ! no consumers in the codebase

processAndPrintGames :: Either String I.GameSchedule -> IO ()
  ! if hasGamesForDate is True, fetches boxscores and discards them; otherwise prints 'No games scheduled for the provided date.'

fetchActiveRoster :: Int -> IO (Either String I.ActiveRoster)
  ! fetches via rosterUrl season, decodes as I.ActiveRoster
  ! consumed by FetchActiveRoster.main

writeRosterToFile :: FilePath -> I.ActiveRoster -> IO ()
  ! encodes only people via encode (I.people roster) to compute the checksum
  ! checksum covers ONLY the people field, not the full ActiveRoster
  ! writes the full ActiveRoster (with checksum and dataPulled set) as JSON to path

assignDateToSchedule :: Text -> I.GameSchedule -> I.GameSchedule
  ! sets game_date on every GameID inside every DateEntry to the provided Text date
  ! overwrites existing dates unconditionally

assignGameIdToPlayers :: Int -> I.GameData -> I.GameData
  ! sets gameid on every Player in both away and home teams to Just gameId
  ! overwrites existing gameids unconditionally

hasGamesForDate :: I.GameSchedule -> Bool
  ! True iff any DateEntry has Just games (regardless of whether the inner Vector is empty)

extractGameIds :: I.GameSchedule -> [Int]
  ! concatenates I.gamePk values across all DateEntry.games vectors
  ! no deduplication

writeDataToFile :: FilePath -> FilePath -> M.Map Text MI.JsonPlayerData -> IO ()
  ! createDirectoryIfMissing on the path, writes encode dataToSave to path ++ '/' ++ filename

writePlayerToJsonFile :: FilePath -> I.Player -> IO ()
  ! no consumers in the codebase

playerToJsonPlayerData :: I.Player -> MI.JsonPlayerData
  ! playerId = T.pack . show . personId . person
  ! stats = single-entry Map keyed by 'maybe "" (T.pack . show) gameid'
  ! if Player.gameid is Nothing (assignGameIdToPlayers not called), the map key is the empty string

playerToJsonStatsData :: I.Player -> MI.JsonStatsData
  ! allPositions defaults to [] when Player.allPositions is Nothing

convertPlayerToJson :: I.Player -> ByteString
  ! BL.toStrict . encode . playerToJsonPlayerData

convertGameDataMapToJsonPlayerData :: M.Map Int (Maybe I.GameData) -> M.Map Text MI.JsonPlayerData
  ! concatMap gameDataToPlayerDataPairs over Map elements (mapMaybe id drops Nothings first)
  ! merges duplicate-keyed entries via mergeJsonPlayerData
  ! rawStringToText replaces escaped backslash and quote sequences in the key

mergeJsonPlayerData :: MI.JsonPlayerData -> MI.JsonPlayerData -> MI.JsonPlayerData
  ! keeps existing playerId and fullName
  ! merges stats via M.unionWith mergeJsonStatsData

mergeJsonStatsData :: MI.JsonStatsData -> MI.JsonStatsData -> MI.JsonStatsData
  ! discards the first argument; returns the second unchanged
  ! second argument always wins on key collision

formatFilename :: String -> String
  ! replaces '-' with '_' and appends '.json' to the date string

createOutputDirectory :: FilePath -> IO ()
  ! createDirectoryIfMissing True

stringToDay :: String -> Day
  ! parseTimeOrError True defaultTimeLocale '%Y-%m-%d'; partial on bad input

incrementDay :: Day -> Day
  ! addDays 1

statTypeToString :: P.StatType -> String
  ! Batting -> 'batting', Pitching -> 'pitching'
  ! consumed only by seasonStatsUrl

generateDateRange :: String -> String -> [String]
  ! iterate incrementDay startDate, takeWhile (<= endDate)
  ! formats each Day as '%Y-%m-%d' string

scheduleUrl :: String -> String
  ! https://statsapi.mlb.com/api/v1/schedule/games/?language=en&sportId=1&startDate=DATE&endDate=DATE

gameStatusUrl :: Int -> String
  ! https://statsapi.mlb.com//api/v1.1/game/GAMEID/feed/live (note the doubled slash)

boxScoreUrl :: Int -> String
  ! http://statsapi.mlb.com/api/v1/game/GAMEID/boxscore (http, not https)

rosterUrl :: Int -> String
  ! https://statsapi.mlb.com/api/v1/sports/1/players?activeStatus=ACTIVE&season=YEAR
  ! sportId is hardcoded to 1 (MLB)

seasonStatsUrl :: Int -> P.StatType -> String
  ! http://statsapi.mlb.com/api/v1/stats?stats=season&sportId=1&season=YEAR&group=batting|pitching
  ! no consumers in the codebase

%decision BoxscoreFetchSkipsLiveGames
  what:    fetchFinishedBxScore checks codedGameState == 'F' before fetching the boxscore
  why:     Only finished games have stable boxscore stats. Returns Right Nothing for non-final games; downstream filterFinishedGames removes them.
  affects: fetchFinishedBxScore

%decision ConcurrentFetchUnboundedAsync
  what:    fetchFinishedBxScores uses Control.Concurrent.Async.mapConcurrently
  why:     Parallelizes per-game HTTP fetches across an entire day's gameId list. No bound on concurrency; no retry or rate-limit handling.
  affects: fetchFinishedBxScores


