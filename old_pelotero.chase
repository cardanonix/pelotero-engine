%file /home/bismuth/git/pelotero-engine/old_src/League/PointCalc.hs
%mod PointCalc

%ext GADTs, OverloadedStrings, RecordWildCards

%uses Control.Monad
%uses Data.Aeson
%uses qualified Data.Aeson.Key as K
%uses Data.Aeson.Types
%uses Data.ByteString
%uses qualified Data.ByteString as B
%uses qualified Data.ByteString.Lazy as BL
%uses Data.ByteString.Lazy.Char8
%uses qualified Data.Map.Strict as MS
%uses Data.Maybe
%uses Data.Text
%uses qualified Data.Text as T
%uses qualified Data.Vector as V
%uses GHC.Arr
%uses Text.Read
%uses qualified Config as C
%uses qualified Input as I
%uses qualified Middle as M
%uses qualified Points as P
%uses qualified Roster as R
%uses qualified OfficialRoster as O
%uses Validators

mergeGmPoints :: P.GmPoints -> P.GmPoints -> Either Text P.GmPoints
  ! compares gmpts_Id of both arguments; returns Left 'Attempting to merge points for different players!' on mismatch
  ! on match: concatenates gmpts_batting and gmpts_pitching lists
  ! does not re-sum total_points across the merged lists
  ! no consumers in the codebase

calculatePointsForPlayer :: C.Configuration -> O.PlayerID -> R.LgManager -> M.JsonPlayerData -> Either Text P.GmPoints
  ! calls Validators.batterOrPitcher to determine StatType from the LgManager's lineup
  ! looks up M.JsonStatsData via MS.lookup (O.playerIDToText playerId) in stats
  ! Batting branch returns Left 'Batting stats not found' if the lookup or M.batting is Nothing
  ! Pitching branch returns Left 'Pitching stats not found' if the lookup or M.pitching is Nothing

calcBattingPoints :: O.PlayerID -> C.BattingMults -> I.BattingStats -> P.GmPoints
  ! single = bat_hits - (bat_doubles + bat_triples + bat_homeRuns), each via fromMaybe 0
  ! negative contributions: bat_strikeOuts, bat_caughtStealing
  ! gmb_gameId is hardcoded to the literal string "GameID"
  ! gmb_total_points is computed at construction as the sum of all weighted contributions

calcPitchingPoints :: O.PlayerID -> C.PitchingMults -> I.PitchingStats -> P.GmPoints
  ! actualInnings = fromMaybe 0.0 (readMaybe (T.unpack pit_inningsPitched) :: Maybe Double)
  ! this reads MLB '6.2' (= 6 and 2/3 innings) as the literal Double 6.2
  ! quality_start awarded when actualInnings >= 6 AND pit_earnedRuns <= 3
  ! negative contributions: pit_baseOnBalls, pit_hits, pit_earnedRuns, pit_hitBatsmen, pit_losses
  ! gmp_gameId is hardcoded to the literal string "GameID"
  ! gmp_total_points is computed at construction as the sum of all weighted contributions


