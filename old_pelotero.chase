  ! Fisher-Yates shuffle returning ([a], StdGen)
  ! no consumers in the codebase outside Generators.main

removeAt :: Int -> [a] -> (a, [a])
  ! uses splitAt n; partial on the cons pattern when n is out of range
  ! consumed only by shuffleList

withEither :: IO (Either String a) -> (a -> IO ()) -> IO ()
  ! runs the IO action; on Left prints to stdout (not stderr); on Right calls the handler
  ! consumed by Scraper.printGameData and Scraper.processAndPrintGames

eitherToMaybe :: Either a b -> Maybe b
  ! Right b -> Just b; otherwise Nothing
  ! no consumers in the codebase

constructFilePath :: FilePath -> Int -> FilePath
