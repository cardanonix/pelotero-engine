playerIDToText :: PlayerID -> T.Text
  ! T.pack . show; produces decimal Int representation
  ! the only path used to convert a PlayerID to a Map key throughout the codebase

textToPlayerID :: T.Text -> Maybe PlayerID
  ! uses reads :: [(Int, String)] requiring full parse with empty remainder
  ! returns Nothing on any non-Int text
  ! round-trip with playerIDToText holds for any valid Int

unwrapPlayerId :: PlayerID -> Int
  ! extracts the inner Int from a PlayerID newtype
  ! no consumers in the codebase

