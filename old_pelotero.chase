unwrapTeamID :: TeamID -> T.Text
  ! extracts the inner Text from a TeamID newtype

sumDraftRosterLmts :: DraftRosterLmts -> Int
  ! sums all 9 positional fields of DraftRosterLmts (catcher through r_pitcher)
  ! duplicates the logic in Utility.totalPicksPerTeam

parseDouble :: Value -> Parser Double
  ! uses withText, then reads :: [(Double, String)] requiring full parse with empty remainder
  ! fails the parser with 'Could not parse double from string' on numeric JSON or malformed text
  ! consumed by every field in BattingMults FromJSON and PitchingMults FromJSON

%decision TeamIDIsNewtypeOverText
  what:    TeamID is a newtype over T.Text
  why:     Prevents accidental substitution with leagueID, commissioner, or other Text fields. Custom ToJSON/FromJSON unwrap to bare Text rather than a tagged object.
  affects: unwrapTeamID

%decision MultiplierFieldsParsedFromJSONStrings
  what:    BattingMults and PitchingMults fields are parsed via parseDouble, which calls withText and reads the contents
  why:     Source JSON quotes multipliers as strings ("1.0") rather than numeric literals. withText on a numeric value will fail; the schema requires string-typed multipliers.
  affects: parseDouble

%decision DraftAndLineupLimitsAreSeparateRecords
  what:    DraftRosterLmts and LgLineupLmts have parallel positional fields but distinct types
  why:     Draft caps and lineup caps are independently configured in the JSON schema. Field-name prefixes (dr_ vs lg_) prevent record-field collisions. sumDraftRosterLmts only sums the dr_ side; LgLineupLmts has its own consumers in queryLgLineupLmts.
  affects: sumDraftRosterLmts


