  ! does not recurse

writeJson :: (ToJSON a) => FilePath -> a -> IO ()
  ! BL.writeFile filePath . encode

isPlayerInOfficialRoster :: O.PlayerID -> [O.OfficialPlayer] -> Bool
  ! any (playerId-equal) over [O.OfficialPlayer]
  ! no consumers in the codebase

filterInvalidRankings :: [C.TeamID] -> [PR.RankingData] -> [PR.RankingData]
  ! keeps RankingData whose teamId is in the provided [TeamID] list
  ! no consumers in the codebase

filterValidTeams :: [C.TeamID] -> [PR.RankingData] -> [C.TeamID]
  ! keeps TeamIDs that appear in the rankings list
  ! consumed by generateDraftOrder

findPlayerRanking :: O.PlayerID -> [PR.PlayerRanking] -> Maybe Int
  ! find the PlayerRanking by playerId, return its rank
  ! no consumers in the codebase

readRankings :: FilePath -> IO [Either String [PR.PlayerRanking]]
  ! duplicate of loadDataFromDir specialized to [PlayerRanking]
  ! no consumers in the codebase

loadRankings :: FilePath -> IO [Either String [PR.PlayerRanking]]
  ! = loadDataFromDir specialized to [PlayerRanking]
  ! no consumers in the codebase

loadRosters :: FilePath -> IO [Either String O.OfficialRoster]
  ! = loadDataFromDir specialized to OfficialRoster
  ! no consumers in the codebase

computeChecksum :: BL.ByteString -> Text
  ! BL.toStrict then SHA256 hash, hex-encoded as Text

getCurrentDate :: IO Text
  ! formatTime '%Y_%m_%d_%H_%M' on getCurrentTime

getCurrentFormattedTime :: IO String
  ! formatTime '%Y-%m-%dT%H:%M' on getCurrentTime
  ! no consumers in the codebase

totalPicksPerTeam :: C.DraftRosterLmts -> Int
  ! sum of all 9 DraftRosterLmts fields
  ! duplicates Config.sumDraftRosterLmts

randomizeOrder :: (MonadIO m) => [C.TeamID] -> m [C.TeamID]
  ! = shuffleM via System.Random.Shuffle; uses MonadIO randomness with no seed

generateDraftOrder :: (MonadIO m) => C.Configuration -> [PR.RankingData] -> m C.DraftOrder
  ! filterValidTeams to drop teams without rankings, then randomizeOrder, then apply selectDraftOrderStrategy from config.draft_parameters.order
  ! totalPicks = totalPicksPerTeam draftLimits * length randomizedTeams

%decision PositionStringConvertersAreSeparate
  what:    Four functions convert between position naming conventions: positionTextToOfficialCode, positionCodeToText, positionCodeToOfficialText, positionCodeToDraftText
  why:     Three input conventions exist: numeric scorekeeper codes ('1'-'10'), short letters ('P','C','1B','2B' etc), draft slot names ('pitcher','catcher','first','outfield'). All four use catch-all '_ -> "Unknown"' which silently swallows typos and new positions. positionCodeToDraftText composes positionCodeToOfficialText with an inner officialTextToDraftText helper.
  affects: positionTextToOfficialCode, positionCodeToText, positionCodeToOfficialText, positionCodeToDraftText


