    teamRankings :: [PR.RankingData]
} deriving (Show, Eq)

instantiateDraft :: C.Configuration -> O.OfficialRoster -> [PR.RankingData] -> IO DraftState
  ! filters teamRankings by 'PR.teamId r `elem` C.teamId config'
  ! calls Utility.generateDraftOrder which uses System.Random.Shuffle.shuffleM (IO randomness, no seed)
  ! creates one R.LgManager per teamId with empty lineup and roster

draftPlayers :: DraftConfig -> DraftState -> IO DraftState
  ! loops until draftComplete is True OR draftCycle returns a Just error
  ! on error, prints 'Error: <msg>' and returns the PRE-error state
  ! no pick limit beyond what selectNextPlayer enforces by exhaustion
  > consumed by: AutoDraft.main

updateState :: DraftConfig -> DraftState -> O.OfficialPlayer -> C.TeamID -> DraftState
  ! looks up the team by teamId in DraftState.teams via find
  ! calls addToRosterAndLineup; if isNewPlayer is False, returns the unchanged state
  ! advances currentTeamIndex modulo (length draftOrder)
  ! uses fromJust on the find result; aborts at runtime if teamId is not in teams

draftCycle :: DraftConfig -> DraftState -> C.TeamID -> (DraftState, Maybe String)
  ! looks up the team by teamId in [(tid, t) | t@(R.LgManager _ _ tid _ _ _) <- teams state]
  ! filters officialPlayers by availablePlayerIds, calls selectNextPlayer
  ! Nothing from selectNextPlayer sets draftComplete = True with no error
  ! checks newState == state via the Eq instance to detect 'no progress made' and reports 'Failed to add player to roster or lineup'

runDraftCycle :: DraftConfig -> DraftState -> R.LgManager -> (DraftState, Maybe String)
  ! thin wrapper around draftCycle taking a teamState argument
  ! no consumers in the codebase

selectNextPlayer :: C.TeamID -> [PR.RankingData] -> [O.OfficialPlayer] -> Maybe O.OfficialPlayer
  ! finds the team's RankingData, extracts ranked playerIds in order
  ! returns the first available OfficialPlayer whose id appears in the rankedPlayerIds list
  ! Nothing if no ranked player is still available - this terminates the WHOLE draft, not just this team

addToRosterAndLineup :: C.Configuration -> O.OfficialPlayer -> R.Roster -> R.CurrentLineup -> ((R.Roster, R.CurrentLineup), Bool)
  ! branches on positionCodeToDraftText player.primaryPosition == 'pitcher'
  ! pitcher path: addPitcherToRoster picks s_pitcher or r_pitcher slot; addPlayerToLineup uses the chosen slot
  ! non-pitcher path: addBatterToRoster checks the position cap; addPlayerToLineup adds if cap allows
  ! returns ((Roster, CurrentLineup), Bool) where Bool indicates whether anything was added to the roster

addPlayerToLineup :: T.Text -> O.OfficialPlayer -> R.CurrentLineup -> C.LgLineupLmts -> R.CurrentLineup
  ! case-by-case dispatch on position Text against 9 lineup slots
  ! if slot is at or above its lg_* cap, returns lineup unchanged with no signal to caller
  ! catch-all branch returns lineup unchanged

addPlayerToPosition :: T.Text -> O.OfficialPlayer -> R.Roster -> R.Roster
  ! case-by-case dispatch on position Text against 9 roster slots
  ! no cap-checking; appends unconditionally
  ! catch-all branch returns roster unchanged

addPitcherToRoster :: C.Configuration -> O.OfficialPlayer -> R.Roster -> (R.Roster, T.Text)
  ! fills s_pitcher up to dr_s_pitcher cap, then r_pitcher up to dr_r_pitcher cap
  ! returns (roster, "") when both pitcher caps are reached
  ! empty-string return is the 'no slot available' signal consumed by addToRosterAndLineup

addBatterToRoster :: C.Configuration -> T.Text -> O.OfficialPlayer -> R.Roster -> C.DraftRosterLmts -> (R.Roster, Bool)
  ! consults queryDraftRosterLmts for the cap; appends via addPlayerToPosition if under cap
  ! returns (roster, False) when at or above cap

%decision DraftStateIsAFlatRecord
  what:    DraftState bundles teams, availablePlayerIds, draftHistory, currentTeamIndex, draftOrder, draftComplete, teamRankings
  why:     Single record threaded through the recursive draftPlayers loop. draftComplete is a Bool flag set explicitly by selectNextPlayer's Nothing branch. currentTeamIndex is an index into draftOrder, not into teams. Has Show and Eq instances; Eq is used by draftCycle to detect 'no progress made' via newState == state.
  affects: draftPlayers, instantiateDraft, draftCycle

%decision DraftLoopIsRecursiveIO
  what:    draftPlayers is a recursive IO action; no State monad
  why:     Only IO effect is putStrLn on error. Errors abort the loop and return the pre-failure state.
  affects: draftPlayers

%decision DraftConfigBundlesConfigAndPlayers
  what:    DraftConfig has two fields: cfg :: C.Configuration and officialPlayers :: [O.OfficialPlayer]
  why:     Avoids re-passing both arguments through every helper that needs them. Constructed once per draft run by AutoDraft.main.
  affects: instantiateDraft, draftPlayers, draftCycle, updateState


