%file /home/bismuth/git/pelotero-engine/old_src/League/Validators.hs
%mod Validators

%ext OverloadedStrings, RecordWildCards

%uses Control.Monad
%uses Data.Aeson
%uses Data.Aeson.Types
%uses Data.ByteString
%uses Data.List
%uses qualified Data.ByteString as B
%uses Data.ByteString.Lazy.Char8
%uses Data.Foldable
%uses qualified Data.Map.Strict as M
%uses Data.Maybe
%uses Data.Text
%uses qualified Data.Text as T
%uses Debug.Trace
%uses Data.List
%uses qualified Config as C
%uses qualified GHC.Generics as R
%uses qualified Input as I
%uses qualified OfficialRoster as O
%uses qualified Points as P
%uses qualified Roster as R
%uses qualified PlayerRanking as PR
%uses Utility

type FileName = String

type FileContent = Either String R.LgManager

extractNameFromPath :: FileName -> String
  ! reverse . takeWhile (/= '/') . reverse - returns the basename

processConfigResults :: C.Configuration -> [(FileName, FileContent)] -> IO ()
  ! iterates [(FileName, FileContent)], printing extractNameFromPath fname before each testLineup call
  ! consumed by LeagueTEST.main

testLineup :: C.Configuration -> Either String R.LgManager -> IO ()
  ! prints the parsed LgManager and lineup, then runs validateAndPrintLineup
  ! Left input prints 'Failed to parse Roster JSON: <err>'

findPlayer :: O.PlayerID -> [O.OfficialPlayer] -> [O.PlayerID] -> Maybe O.OfficialPlayer
  ! find by playerId AND playerId being in the availableIds list
  ! consumed by Draft (transitively via Validators import)

maxPossibleTeams :: C.Configuration -> O.OfficialRoster -> Int
  ! minimum of maxPossibleTeamsForPosition over the hardcoded list ['P','C','1B','2B','3B','SS','LF','CF','RF','DH']
  ! no consumers in the codebase

maxPossibleTeamsForPosition :: T.Text -> C.Configuration -> O.OfficialRoster -> Int
  ! draftLimit derivation: pitcher = dr_s_pitcher + dr_r_pitcher; outfield = dr_outfield * 3 (assumes LF/CF/RF interchangeable); others use the single matching dr_* field
  ! playerCount filters O.people by O.primaryPosition == position
  ! result is playerCount `div` draftLimit when draftLimit > 0, else 0

isLineupValid :: R.LgManager -> C.Configuration -> Bool
  ! validateLineup manager config; True iff Right
  ! no consumers in the codebase

getRosterValidationErrors :: R.LgManager -> C.Configuration -> [String]
  ! validateLineup despite the name; returns the Left list or []
  ! no consumers in the codebase

getLineupValidationErrors :: R.LgManager -> C.Configuration -> [String]
  ! validateLineup; returns the Left list or []
  ! no consumers in the codebase

hasUniqueLineupPlayers :: R.CurrentLineup -> Either String [O.PlayerID]
  ! Left 'No duplicate players found.' when allPlayers \\ nub allPlayers is empty
  ! Right [O.PlayerID] containing the duplicates otherwise

hasUniqueRosterPlayers :: R.Roster -> Either String [O.PlayerID]
  ! Left 'No duplicate players found in roster.' on success
  ! Right [O.PlayerID] of duplicates otherwise

lookupPlayerInRoster :: O.PlayerID -> R.Roster -> Bool
  ! True if playerId appears in any of the 9 roster slots
  ! no consumers in the codebase

lookupPlayerInLineup :: O.PlayerID -> R.CurrentLineup -> Bool
  ! True if playerId appears in any of the 9 lineup slots
  ! no consumers in the codebase

getRosterDiscrepancies :: R.Roster -> C.DraftRosterLmts -> [(String, Int)]
  ! for each of 9 positions: Just (posName, length players - limit) when length > limit, else Nothing
  ! returns only positive-overage discrepancies

getLineupDiscrepancies :: R.CurrentLineup -> C.LgLineupLmts -> [(String, Int)]
  ! for each of 9 positions: Just (posName, length players - limit) when length > limit, else Nothing

countPlayersOnRoster :: T.Text -> R.Roster -> Int
  ! case-by-case dispatch on position Text against 9 roster slot names
  ! catch-all returns 0 (no warning on typos)

countPlayersInLineup :: T.Text -> R.CurrentLineup -> Int
  ! case-by-case dispatch on position Text against 9 lineup slot names
  ! catch-all returns 0 (no warning on typos)

playerIDToString :: O.PlayerID -> String
  ! show . unPlayerID

validateRoster :: R.Roster -> C.Configuration -> Either [String] ()
  ! calls getRosterDiscrepancies and hasUniqueRosterPlayers
  ! returns Right () when discrepancies is empty AND duplicateCheck is Left (the inverted convention)
  ! Left contains either the duplicate-IDs-as-strings list with a trailing 'Duplicate player IDs found in roster.' message, or per-position overage messages

validateLineup :: R.LgManager -> C.Configuration -> Either [String] ()
  ! calls getLineupDiscrepancies and hasUniqueLineupPlayers
  ! Right () when discrepancies is empty AND duplicateCheck is Left
  ! same Left structure as validateRoster but with 'Duplicate player IDs found in lineup.'
  > consumed by: isLineupValid
  > consumed by: getRosterValidationErrors
  > consumed by: getLineupValidationErrors

validateAndPrintLineup :: R.LgManager -> C.Configuration -> IO Bool
  ! IO action returning Bool
  ! prints discrepancies to stdout; calls validatePlayerId (which prints) and hasUniqueLineupPlayers (printed via the inverted convention)
  ! True only when validPositions AND validRosterSize AND all player IDs valid AND no duplicates

queryLimits :: T.Text -> T.Text -> C.Configuration -> Int
  ! dispatches 'draft' -> queryDraftRosterLmts, 'lineup' -> queryLgLineupLmts; anything else returns 0
  ! no consumers in the codebase

queryDraftRosterLmts :: T.Text -> C.DraftRosterLmts -> Int
  ! case-by-case dispatch on position Text against 9 dr_* fields; catch-all returns 0
  ! consumed by Draft.addBatterToRoster, Draft.addPitcherToRoster, Utility.maxPossibleTeamsForPosition (indirectly)

queryLgLineupLmts :: T.Text -> C.LgLineupLmts -> Int
  ! case-by-case dispatch on position Text against 9 lg_* fields; catch-all returns 0
  ! consumed by Draft.addPlayerToLineup

hasValidPositions :: Value -> Bool
  ! duplicate of Input.hasValidPositions
  ! no internal consumers in this module

lookupPlayerInOfficialRoster :: O.PlayerID -> O.OfficialRoster -> Bool
  ! any (playerId-equal) over O.people roster
  ! consumed by lookupPlayerId

lookupPlayerId :: Text -> IO Bool
  ! reads testFiles/appData/rosters/activePlayers.json on every call via readJson
  ! returns False on parse failure or on textToPlayerID returning Nothing
  ! consumed by lookupPlayerIdConverted

validatePlayerId :: R.CurrentLineup -> IO (Either [Text] String)
  ! filterM lookupPlayerIdConverted over getUniquePlayerIdsLineup
  ! Right 'All Players are valid.' when all players exist in the on-disk active roster
  ! Left [Text] of nonexistent playerIds otherwise

lookupPlayerIdConverted :: O.PlayerID -> IO Bool
  ! lookupPlayerId . O.playerIDToText

intToText :: Int -> Text
  ! T.pack . show
  ! no consumers in the codebase

getUniquePlayerIdsLineup :: R.CurrentLineup -> [O.PlayerID]
  ! concatenates all 9 CurrentLineup fields
  ! name claims uniqueness but the function does NOT deduplicate (it just flattens)

validatePositionCount :: String -> [a] -> Int -> Maybe (String, Int)
  ! Just (posName, overage) when length players > maxAllowed, else Nothing
  ! no consumers in the codebase

totalPlayersInLineup :: R.CurrentLineup -> Int
  ! sum of lengths of all 9 CurrentLineup fields
  ! no consumers in the codebase

validateCurrentLineup :: R.LgManager -> C.Configuration -> Bool
  ! Bool: True when getLineupDiscrepancies is empty AND hasUniqueLineupPlayers returns Left (the inverted-success case)
  ! no consumers in the codebase

findPlayerPosition :: O.PlayerID -> R.LgManager -> Either Text Text
  ! checks 9 lineup slots labeled C, 1B, 2B, 3B, SS, U, OF, SP, RP
  ! Right pos if exactly one slot contains the playerId
  ! Left 'Player not found in current lineup.' if zero matches
  ! Left 'Player found in multiple positions in the lineup.' if 2+ matches
  ! no consumers in the codebase

batterOrPitcher :: O.PlayerID -> R.LgManager -> Either Text P.StatType
  ! batterPositions = [cC, b1C, b2C, b3C, ssC, uC, ofC]
  ! pitcherPositions = [spC, rpC]
  ! Right Batting if playerName is in any batter list; Right Pitching if in any pitcher list; Left otherwise
  > consumed by: PointCalc.calculatePointsForPlayer

analyzeDraftResults :: C.Configuration -> (R.LgManager, R.LgManager) -> (PR.RankingData, PR.RankingData) -> Int -> IO ()
  ! prints 'Team 1 Draft Analysis:' and 'Team 2 Draft Analysis:' headers; calls analyzeTeamDraft for each
  ! linesToPrint caps the per-team output via printAnalysis
  ! consumed by AutoDraft.main

analyzeTeamDraft :: C.Configuration -> R.LgManager -> PR.RankingData -> [(Int, O.PlayerID, Bool)]
  ! builds rankingMap from rank to PlayerID; produces [(rank, playerId, drafted)] sorted by rank
  ! drafted check uses getAllPlayerIdsFromTeam

getAllPlayerIdsFromTeam :: R.LgManager -> [O.PlayerID]
  ! concatenates all 9 roster fields and all 9 lineup fields

printAnalysis :: [(Int, O.PlayerID, Bool)] -> Int -> IO ()
  ! take linesToPrint over the sorted analysis list

%decision InvertedReturnConventionForUniqueChecks
  what:    hasUniqueLineupPlayers and hasUniqueRosterPlayers return Left when there are no duplicates and Right when there are
  why:     Left value carries the success message string; Right value carries the duplicate PlayerID list. Inverts the conventional Either bias used elsewhere in the module.
  affects: hasUniqueLineupPlayers, hasUniqueRosterPlayers, validateRoster, validateLineup, validateAndPrintLineup


