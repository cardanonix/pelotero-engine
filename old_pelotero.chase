%uses qualified Data.Vector as V
%uses GHC.Arr
%uses qualified Input as I

data JsonPlayerData where
    JsonPlayerData ::
        { playerId :: Text
        , fullName :: Text
        , stats :: M.Map Text JsonStatsData
        } ->
        JsonPlayerData
    deriving (Show, Eq)

data JsonStatsData where
    JsonStatsData ::
        { parentTeamId :: Int
        , allPositions :: [I.Position]
        , statusCode :: Text
        , batting :: Maybe I.BattingStats
        , pitching :: Maybe I.PitchingStats
        } ->
        JsonStatsData
    deriving (Show, Eq)

instance ToJSON JsonPlayerData where

instance ToJSON JsonStatsData where

instance ToJSON I.Position where

instance ToJSON I.PitchingStats where

instance ToJSON I.BattingStats where

instance ToJSON I.ActiveRoster where

instance ToJSON I.ActivePlayer where

%decision ToJSONOnlyHere_FromJSONInStats
  what:    Middle defines ToJSON for JsonPlayerData, JsonStatsData, I.Position, I.PitchingStats, I.BattingStats, I.ActiveRoster, I.ActivePlayer; Stats.hs defines the FromJSON direction for JsonPlayerData and JsonStatsData
  why:     Write path (Scraper) and read path (PointCalc) are split across modules. Field name prefixes (bat_, pit_) match the FromJSON in Stats. Edits to one direction can drift from the other silently.
  affects: 

%decision ToJSONOmitsNothingFields
  what:    ToJSON BattingStats and PitchingStats use catMaybes to skip fields whose Maybe value is Nothing
  why:     Reduces serialized size given that most stats are absent for any given player-game. FromJSON in Stats uses .:? on every field, so absence reads back as Nothing.
  affects: 

%decision PositionToJSONReadsTextAsInt
  what:    ToJSON I.Position calls 'read (T.unpack pos_code)' to produce a Number
  why:     The on-disk JSON schema for Middle uses numeric position codes; Input parses them as Text and Middle converts back. read is partial; non-numeric pos_code values throw at runtime.
  affects: 

%decision ToJSONJsonPlayerDataKeyIsPlayerUnderscoreId
  what:    ToJSON JsonPlayerData emits the key 'player_id' (with underscore), not 'playerId'
  why:     Stats.FromJSON M.JsonPlayerData reads 'player_id' to match. Inconsistent with the playerId field name used everywhere else in the codebase (camelCase).
  affects: 

%decision ActivePlayerToJSONFlattensNestedFields
  what:    ToJSON I.ActivePlayer emits currentTeam, primaryPosition, batSide, pitchHand as scalar values, not nested objects
  why:     FromJSON ActivePlayer in Input parses these from nested objects (currentTeam.id, primaryPosition.code, etc). ToJSON output is therefore NOT round-trippable through FromJSON ActivePlayer; the two instances target different schemas.
  affects: 

%decision ActiveRosterToJSONKeysByStringifiedPlayerId
  what:    ToJSON I.ActiveRoster builds an officialPlayers object keyed by Text-of-Int playerId
  why:     Matches the read-side schema in OfficialRoster.FromJSON which walks officialPlayers as a HashMap. FromJSON ActiveRoster in Input uses a 'people' array, so this ToJSON path bridges to the OfficialRoster schema, not the ActiveRoster schema.
  affects: 


