cabal-version: 3.6

name:          pelotero-engine
version:       0.1.0.0
synopsis:      Fantasy baseball points engine
description:   Phase 1: domain types and MLB wire layer.
build-type:    Simple

flag use-pkg-config
    description: Use pkg-config to find libpq
    default:     True
    manual:      True

common warnings
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-export-lists
    -Wmissing-home-modules
    -Wpartial-fields
    -Wredundant-constraints

common lang
  default-language:   Haskell2010
  default-extensions: OverloadedStrings
                    , DerivingStrategies
                    , GeneralizedNewtypeDeriving
                    , LambdaCase
                    , RecordWildCards
                    , ScopedTypeVariables
                    , StrictData

library
  import:           warnings, lang
  hs-source-dirs:   lib
  exposed-modules:
    Pelotero.Prelude
    Pelotero.Domain.Id
    Pelotero.Domain.Position
    Pelotero.Domain.Stats
    Pelotero.Domain.Player
    Pelotero.Domain.Team
    Pelotero.Domain.Game
    Pelotero.MLB.Wire.Player
    Pelotero.MLB.Wire.Schedule
    Pelotero.MLB.Wire.Boxscore
    Pelotero.MLB.Convert
  build-depends:    base       >= 4.11 && < 4.22
                  , aeson
                  , bytestring
                  , containers
                  , text
                  , time
                  , vector
  ghc-options:      -O2

executable pelotero
  import:           warnings, lang
  hs-source-dirs:   app
  main-is:          Main.hs
  build-depends:    base
                  , pelotero-engine
                  , text
  ghc-options:      -O2 -threaded

test-suite pelotero-test
  import:           warnings, lang
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Spec.hs
  other-modules:
    Pelotero.Domain.PositionSpec
    Pelotero.MLB.ConvertSpec
  build-depends:    base
                  , pelotero-engine
                  , aeson
                  , bytestring
                  , hspec
                  , hedgehog
                  , hspec-hedgehog
                  , text
  ghc-options:      -O0 -threaded