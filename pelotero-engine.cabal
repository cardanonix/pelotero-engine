cabal-version: 3.6

name:          pelotero-engine
version:       0.1.4.0
data-files:         integration-test/fixtures/mlb/teams-2025.json
                  , integration-test/fixtures/mlb/players-2025.json
synopsis:      Fantasy baseball points engine
description:   Phase 1: domain types and MLB wire layer.
               Phase 2a: schema, connection pool, migrations.
               Phase 3: effects, provider-agnostic sync.
build-type:    Simple

flag use-pkg-config
    description: Use pkg-config to find libpq
    default:     True
    manual:      True

common warnings
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-export-lists
    -Wmissing-home-modules
    -Wpartial-fields
    -Wredundant-constraints

common lang
  default-language:   Haskell2010
  default-extensions: OverloadedStrings
                    , DerivingStrategies
                    , GeneralizedNewtypeDeriving
                    , LambdaCase
                    , RecordWildCards
                    , ScopedTypeVariables
                    , StrictData

library
  import:           warnings, lang
  hs-source-dirs:   lib
  exposed-modules:
    Pelotero.Prelude
    Pelotero.Score
    Pelotero.App
    Pelotero.Draft
    -- Providers
    Pelotero.Provider.ExternalId
    -- Draft
    Pelotero.Draft.Machine
    Pelotero.Draft.Run
    -- Domain
    Pelotero.Domain.Id
    Pelotero.Domain.Position
    Pelotero.Domain.Stats
    Pelotero.Domain.Player
    Pelotero.Domain.Team
    Pelotero.Domain.Game
    Pelotero.Domain.Roster
    Pelotero.Domain.Scoring
    Pelotero.Domain.Draft
    Pelotero.Domain.League
    -- MLB wire + conversion
    Pelotero.MLB.Wire.Player
    Pelotero.MLB.Wire.Schedule
    Pelotero.MLB.Wire.Boxscore
    Pelotero.MLB.Wire.Team
    Pelotero.MLB.Convert
    Pelotero.MLB.Urls
    Pelotero.MLB.Fetch
    -- DB layer
    Pelotero.DB.Provider
    Pelotero.DB.Pool
    Pelotero.DB.Migration
    Pelotero.DB.Rel8Instances
    Pelotero.DB.Team
    Pelotero.DB.Player
    Pelotero.DB.FetchLog
    Pelotero.DB.Game
    Pelotero.DB.BoxscoreEntry
    Pelotero.DB.LeagueConfig
    Pelotero.DB.LeagueTeam
    Pelotero.DB.RosterSlot
    Pelotero.DB.LineupSlot
    Pelotero.DB.DraftPick
    Pelotero.DB.PlayerRanking
    Pelotero.DB.LineupSnapshot
    Pelotero.DB.ProviderKeyed
    Pelotero.DB.JsonB
    -- Effects
    Pelotero.Effects.Database
    Pelotero.Effects.Clock
    Pelotero.Effects.Players
    Pelotero.Effects.Games
    Pelotero.Effects.Teams
    Pelotero.Effects.FetchLog
    Pelotero.Effects.MLBClient
    Pelotero.Effects.BoxscoreEntry
    Pelotero.Effects.LeagueConfig
    Pelotero.Effects.LeagueTeam
    Pelotero.Effects.RosterSlot
    Pelotero.Effects.LineupSlot
    Pelotero.Effects.PlayerRanking
    Pelotero.Effects.DraftPick
    Pelotero.Effects.Logging
    Pelotero.Effects.LineupSnapshot
    -- Sync (provider-agnostic)
    Pelotero.Sync.Players
    Pelotero.Sync.Schedule
    Pelotero.Sync.Boxscores
    Pelotero.Lineup.Snapshot
  build-depends:    base       >= 4.11 && < 4.22
                  , aeson
                  , bytestring
                  , containers
                  , contravariant     >= 1.5   && < 1.6
                  , text
                  , time
                  , vector
                  -- DB
                  , hasql              >= 1.9   && < 1.10
                  , hasql-pool         >= 1.3   && < 1.5
                  , hasql-transaction  >= 1.1   && < 1.2
                  , directory          >= 1.3   && < 1.4
                  , filepath           >= 1.4   && < 1.6
                  , cryptohash-sha256  >= 0.11  && < 0.12
                  , base16-bytestring  >= 1.0   && < 1.1
                  -- Crypto (match iohkNix overlay)
                  , crypton
                  , memory
                  -- Effects
                  , effectful          >= 2.5   && < 3
                  -- HTTP (for MLB.Fetch)
                  , http-client        >= 0.7   && < 0.8
                  , http-conduit
                  , http-types         >= 0.12  && < 0.13
                  , rel8               >= 1.7   && < 1.8
                  , katip
                  , effectful
                  , crem
                  , singletons
                  , singletons-base
  ghc-options:      -O2

executable pelotero
  import:           warnings, lang
  hs-source-dirs:   app
  main-is:          Main.hs
  build-depends:    base
                  , pelotero-engine
                  , text
  ghc-options:      -O2 -threaded

executable pelotero-db-check
  import:           warnings, lang
  hs-source-dirs:   app
  main-is:          DbCheck.hs
  build-depends:    base
                  , pelotero-engine
                  , text
  ghc-options:      -O2 -threaded

executable pelotero-fetch-roster
  import:           warnings, lang
  hs-source-dirs:   app
  main-is:          FetchRoster.hs
  build-depends:    base
                  , pelotero-engine
                  , effectful          >= 2.5   && < 3
                  , text
  ghc-options:      -O2 -threaded

test-suite pelotero-test
  import:           warnings, lang
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Spec.hs
  other-modules:
    Pelotero.Domain.PositionSpec
    Pelotero.Domain.RosterSpec
    Pelotero.Domain.ScoringSpec
    Pelotero.Domain.DraftSpec
    Pelotero.Domain.PlayerSpec
    Pelotero.MLB.ConvertSpec
    Pelotero.Effects.PlayersSpec
    Pelotero.ScoreSpec
    Pelotero.DraftSpec
    Pelotero.Provider.ExternalIdSpec
    Pelotero.Sync.PlayersSpec
    Pelotero.Sync.ScheduleSpec
    Pelotero.Sync.BoxscoresSpec 
    Pelotero.Draft.MachineSpec
  build-depends:    base
                  , pelotero-engine
                  , aeson
                  , bytestring
                  , containers
                  , effectful          >= 2.5   && < 3
                  , hspec
                  , hedgehog
                  , hspec-hedgehog
                  , text
                  , time
                  , katip
  ghc-options:      -O0 -threaded

test-suite pelotero-integration-test
  import:           warnings, lang
  type:             exitcode-stdio-1.0
  hs-source-dirs:   integration-test
  main-is:          Spec.hs
  other-modules:
    IntegrationTest.Setup
    IntegrationTest.TeamRepoSpec
    IntegrationTest.PlayerRepoSpec
    IntegrationTest.FetchLogRepoSpec
    IntegrationTest.GameRepoSpec
    IntegrationTest.BoxscoreEntryRepoSpec
    IntegrationTest.RosterSlotRepoSpec
    IntegrationTest.LeagueConfigRepoSpec
    IntegrationTest.LeagueTeamRepoSpec
    IntegrationTest.LineupSlotRepoSpec
    IntegrationTest.PlayerRankingRepoSpec
    IntegrationTest.DraftPickRepoSpec
    IntegrationTest.SyncPlayersSpec
    IntegrationTest.ScoreSpec
  
  build-depends:    base
                  , pelotero-engine
                  , bytestring
                  , containers
                  , hasql
                  , effectful-core
                  , hasql-pool
                  , hasql-transaction
                  , hspec
                  , text
                  , time
  ghc-options:      -O0 -threaded