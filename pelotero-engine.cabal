cabal-version: 3.6

name:          pelotero-engine
version:       0.0.10.0
synopsis:      Fantasy baseball points engine
description:   Refactor in progress. Phase 0: dev shell skeleton only.
               Legacy code lives on disk under src/ and src-new/ but is not
               wired into the cabal build until rewritten phase by phase.
build-type:    Simple

flag use-pkg-config
    description: Use pkg-config to find libpq
    default:     True
    manual:      True

common warnings
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-export-lists
    -Wmissing-home-modules
    -Wpartial-fields
    -Wredundant-constraints

library
  import:           warnings
  hs-source-dirs:   lib
  exposed-modules:
    Pelotero.Prelude
  build-depends:    base >= 4.11 && < 4.22
                  , text
  ghc-options:      -O2
  default-language: Haskell2010

executable pelotero
  import:           warnings
  hs-source-dirs:   app
  main-is:          Main.hs
  build-depends:    base
                  , pelotero-engine
                  , text
  ghc-options:      -O2 -threaded
  default-language: Haskell2010